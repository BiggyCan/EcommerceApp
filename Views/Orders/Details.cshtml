@model EcommerceApp.Models.Order

@{
    ViewData["Title"] = $"Pedido #{Model.Id}";

    var totalItems =
        Model.Items?.Sum(item => item.Quantity)
        ?? 0;
}

<style>

    .order-detail-page {
        min-height: 720px;
        padding: 40px 0 75px;
        background: #f4f6f9;
    }

    .order-detail-container {
        width: calc(100% - 40px);
        max-width: 1050px;
        margin: auto;
    }

    .order-detail-top {
        display: flex;
        justify-content: space-between;
        align-items: center;

        gap: 20px;

        margin-bottom: 24px;
    }

    .order-detail-badge {
        width: fit-content;

        margin-bottom: 9px;
        padding: 7px 12px;

        border-radius: 20px;

        background:
            linear-gradient(
                135deg,
                #4f46e5,
                #2563eb
            );

        color: white;

        font-size: 9px;
        font-weight: 900;

        text-transform: uppercase;
    }

    .order-detail-title {
        margin: 0;

        color: #111827;

        font-size: 31px;
        font-weight: 900;
    }

    .order-detail-subtitle {
        margin: 5px 0 0;

        color: #64748b;

        font-size: 12px;
    }

    .order-back-button {
        min-height: 42px;
        padding: 0 17px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 6px;

        background: #111827;
        color: white;

        text-decoration: none;

        font-size: 11px;
        font-weight: 800;

        transition: .2s;
    }

    .order-back-button:hover {
        color: white;
        background: #2563eb;

        transform: translateY(-1px);
    }


    /* RESUMEN */

    .order-summary-grid {
        display: grid;

        grid-template-columns:
            repeat(4, 1fr);

        gap: 14px;

        margin-bottom: 20px;
    }

    .summary-card {
        min-height: 105px;

        padding: 17px;

        background: white;

        border: 1px solid #e2e8f0;
        border-radius: 11px;

        box-shadow:
            0 5px 16px rgba(15,23,42,.05);
    }

    .summary-label {
        margin-bottom: 10px;

        color: #64748b;

        font-size: 8px;
        font-weight: 900;

        text-transform: uppercase;
    }

    .summary-value {
        color: #111827;

        font-size: 17px;
        font-weight: 900;

        word-break: break-word;
    }

    .summary-value.total {
        color: #15803d;

        font-size: 21px;
    }

    .summary-value.status {
        color: #2563eb;
    }


    /* CLIENTE */

    .customer-card {
        margin-bottom: 20px;

        padding: 22px;

        background: white;

        border: 1px solid #e2e8f0;
        border-radius: 12px;

        box-shadow:
            0 6px 18px rgba(15,23,42,.05);
    }

    .card-title {
        margin: 0 0 17px;

        color: #111827;

        font-size: 18px;
        font-weight: 900;
    }

    .customer-grid {
        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap: 15px;
    }

    .customer-field {
        padding: 14px;

        border-radius: 8px;

        background: #f8fafc;
    }

    .customer-label {
        display: block;

        margin-bottom: 5px;

        color: #64748b;

        font-size: 8px;
        font-weight: 900;

        text-transform: uppercase;
    }

    .customer-value {
        color: #111827;

        font-size: 12px;
        font-weight: 800;

        word-break: break-word;
    }


    /* PRODUCTOS */

    .products-card {
        overflow: hidden;

        margin-bottom: 20px;

        background: white;

        border: 1px solid #e2e8f0;
        border-radius: 12px;

        box-shadow:
            0 6px 18px rgba(15,23,42,.05);
    }

    .products-header {
        padding: 18px 20px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        border-bottom: 1px solid #e2e8f0;
    }

    .products-header h2 {
        margin: 0;

        color: #111827;

        font-size: 18px;
        font-weight: 900;
    }

    .products-count {
        padding: 6px 10px;

        border-radius: 20px;

        background: #dbeafe;
        color: #1d4ed8;

        font-size: 9px;
        font-weight: 900;
    }

    .order-product {
        display: grid;

        grid-template-columns:
            1fr
            120px
            150px;

        gap: 18px;

        align-items: center;

        padding: 17px 20px;

        border-bottom: 1px solid #eef2f7;
    }

    .order-product:last-child {
        border-bottom: none;
    }

    .product-name {
        margin-bottom: 4px;

        color: #111827;

        font-size: 13px;
        font-weight: 900;
    }

    .product-price {
        color: #64748b;

        font-size: 10px;
    }

    .product-quantity {
        color: #475569;

        font-size: 11px;
        font-weight: 700;

        text-align: center;
    }

    .product-subtotal {
        color: #111827;

        font-size: 14px;
        font-weight: 900;

        text-align: right;
    }


    /* TOTAL */

    .total-card {
        padding: 22px;

        display: flex;

        align-items: center;
        justify-content: space-between;

        border-radius: 12px;

        background:
            linear-gradient(
                135deg,
                #111827,
                #172554,
                #312e81
            );

        color: white;
    }

    .total-label {
        font-size: 13px;
        font-weight: 900;
    }

    .total-description {
        margin-top: 3px;

        color: #cbd5e1;

        font-size: 9px;
    }

    .total-value {
        font-size: 29px;
        font-weight: 900;
    }


    /* ADMIN */

    .admin-message {
        margin-top: 20px;
        padding: 16px;

        border-radius: 9px;

        background: #eff6ff;
        color: #1e40af;

        font-size: 10px;
        line-height: 1.6;
    }

    .admin-message strong {
        display: block;

        margin-bottom: 4px;

        font-size: 11px;
    }


    /* RESPONSIVE */

    @@media (max-width: 850px) {

        .order-summary-grid {
            grid-template-columns:
                repeat(2, 1fr);
        }

        .customer-grid {
            grid-template-columns: 1fr;
        }

    }

    @@media (max-width: 650px) {

        .order-detail-container {
            width: calc(100% - 24px);
        }

        .order-detail-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .order-summary-grid {
            grid-template-columns: 1fr;
        }

        .order-product {
            grid-template-columns: 1fr;
        }

        .product-quantity,
        .product-subtotal {
            text-align: left;
        }

        .total-card {
            flex-direction: column;

            align-items: flex-start;

            gap: 10px;
        }

    }

</style>


<div class="order-detail-page">

    <div class="order-detail-container">


        <div class="order-detail-top">


            <div>


                <div class="order-detail-badge">

                    🧾 Detalle de pedido

                </div>


                <h1 class="order-detail-title">

                    Pedido #@Model.Id

                </h1>


                <p class="order-detail-subtitle">

                    Información completa de la venta registrada en BigGame.

                </p>


            </div>



            @if (User.IsInRole("Admin"))
            {

                <a asp-controller="Orders"
                   asp-action="Index"
                   class="order-back-button">

                    ← Volver a ventas

                </a>

            }
            else
            {

                <a asp-controller="Orders"
                   asp-action="MyOrders"
                   class="order-back-button">

                    ← Mis pedidos

                </a>

            }


        </div>



        <div class="order-summary-grid">


            <div class="summary-card">

                <div class="summary-label">
                    Pedido
                </div>

                <div class="summary-value">
                    #@Model.Id
                </div>

            </div>



            <div class="summary-card">

                <div class="summary-label">
                    Productos
                </div>

                <div class="summary-value">
                    @totalItems
                </div>

            </div>



            <div class="summary-card">

                <div class="summary-label">
                    Estado
                </div>

                <div class="summary-value status">
                    @Model.Status
                </div>

            </div>



            <div class="summary-card">

                <div class="summary-label">
                    Total
                </div>

                <div class="summary-value total">

                    Bs @Model.TotalAmount.ToString("N2")

                </div>

            </div>


        </div>



        <section class="customer-card">


            <h2 class="card-title">

                Información del cliente

            </h2>


            <div class="customer-grid">


                <div class="customer-field">

                    <span class="customer-label">
                        Nombre
                    </span>

                    <span class="customer-value">

                        @Model.CustomerName

                    </span>

                </div>



                <div class="customer-field">

                    <span class="customer-label">
                        Correo
                    </span>

                    <span class="customer-value">

                        @Model.CustomerEmail

                    </span>

                </div>



                <div class="customer-field">

                    <span class="customer-label">
                        Dirección
                    </span>

                    <span class="customer-value">

                        @(string.IsNullOrWhiteSpace(Model.ShippingAddress)
                            ? "No especificada"
                            : Model.ShippingAddress)

                    </span>

                </div>



                <div class="customer-field">

                    <span class="customer-label">
                        Fecha
                    </span>

                    <span class="customer-value">

                        @(Model.CreatedAt
                            .ToLocalTime()
                            .ToString("dd/MM/yyyy"))

                    </span>

                </div>



                <div class="customer-field">

                    <span class="customer-label">
                        Hora
                    </span>

                    <span class="customer-value">

                        @(Model.CreatedAt
                            .ToLocalTime()
                            .ToString("HH:mm"))

                    </span>

                </div>



                <div class="customer-field">

                    <span class="customer-label">
                        Estado
                    </span>

                    <span class="customer-value">

                        @Model.Status

                    </span>

                </div>


            </div>


        </section>



        <section class="products-card">


            <div class="products-header">


                <h2>

                    Productos vendidos

                </h2>


                <span class="products-count">

                    @totalItems unidad@(totalItems == 1 ? "" : "es")

                </span>


            </div>



            @if (Model.Items != null && Model.Items.Any())
            {

                @foreach (var item in Model.Items)
                {

                    <div class="order-product">


                        <div>

                            <div class="product-name">

                                @item.ProductName

                            </div>

                            <div class="product-price">

                                Precio unitario:
                                Bs @item.UnitPrice.ToString("N2")

                            </div>

                        </div>



                        <div class="product-quantity">

                            Cantidad:
                            <strong>
                                @item.Quantity
                            </strong>

                        </div>



                        <div class="product-subtotal">

                            Bs @item.Subtotal.ToString("N2")

                        </div>


                    </div>

                }

            }
            else
            {

                <div style="
                    padding:40px;
                    text-align:center;
                    color:#64748b;
                    font-size:12px;
                ">

                    Este pedido no contiene productos registrados.

                </div>

            }


        </section>



        <div class="total-card">


            <div>

                <div class="total-label">

                    TOTAL DEL PEDIDO

                </div>

                <div class="total-description">

                    Importe registrado en la venta.

                </div>

            </div>


            <div class="total-value">

                Bs @Model.TotalAmount.ToString("N2")

            </div>


        </div>



        @if (User.IsInRole("Admin"))
        {

            <div class="admin-message">

                <strong>
                    📊 Registro administrativo
                </strong>

                Esta venta está almacenada en la base de datos de BigGame.
                Los productos y cantidades mostrados corresponden al
                pedido registrado al momento de realizar la compra.

            </div>

        }


    </div>

</div>