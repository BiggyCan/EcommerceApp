@model List<EcommerceApp.Models.Order>

@{
    ViewData["Title"] = "Mis pedidos";

    var orders =
        Model ?? new List<EcommerceApp.Models.Order>();

    var totalOrders =
        orders.Count;

    var totalSpent =
        orders.Sum(order => order.TotalAmount);

    var totalProducts =
        orders.Sum(
            order =>
                order.Items?.Sum(item => item.Quantity)
                ?? 0
        );
}

<style>

    .my-orders-page {
        min-height: 720px;
        padding: 40px 0 75px;
        background: #f4f6f9;
    }

    .my-orders-container {
        width: calc(100% - 40px);
        max-width: 1050px;
        margin: auto;
    }

    .my-orders-top {
        display: flex;
        justify-content: space-between;
        align-items: center;

        gap: 20px;

        margin-bottom: 25px;
    }

    .my-orders-badge {
        width: fit-content;

        margin-bottom: 9px;
        padding: 7px 12px;

        border-radius: 20px;

        background:
            linear-gradient(
                135deg,
                #4f46e5,
                #2563eb
            );

        color: white;

        font-size: 9px;
        font-weight: 900;

        text-transform: uppercase;
    }

    .my-orders-title {
        margin: 0;

        color: #111827;

        font-size: 31px;
        font-weight: 900;
    }

    .my-orders-subtitle {
        margin: 5px 0 0;

        color: #64748b;

        font-size: 12px;
    }

    .store-button {
        min-height: 42px;
        padding: 0 17px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 6px;

        background: #111827;
        color: white;

        text-decoration: none;

        font-size: 11px;
        font-weight: 800;

        transition: .2s;
    }

    .store-button:hover {
        color: white;
        background: #2563eb;

        transform: translateY(-1px);
    }


    /* RESUMEN */

    .orders-summary {
        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap: 14px;

        margin-bottom: 22px;
    }

    .summary-card {
        min-height: 112px;

        padding: 18px;

        position: relative;

        overflow: hidden;

        background: white;

        border: 1px solid #e2e8f0;
        border-radius: 11px;

        box-shadow:
            0 5px 16px rgba(15,23,42,.05);
    }

    .summary-icon {
        position: absolute;

        top: 17px;
        right: 17px;

        width: 37px;
        height: 37px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 9px;

        background: #eef2ff;

        font-size: 18px;
    }

    .summary-label {
        margin-bottom: 12px;

        color: #64748b;

        font-size: 8px;
        font-weight: 900;

        text-transform: uppercase;
    }

    .summary-value {
        color: #111827;

        font-size: 25px;
        font-weight: 900;
    }

    .summary-value.money {
        color: #15803d;
    }

    .summary-value.products {
        color: #2563eb;
    }

    .summary-detail {
        margin-top: 4px;

        color: #94a3b8;

        font-size: 9px;
    }


    /* PEDIDOS */

    .orders-card {
        overflow: hidden;

        background: white;

        border: 1px solid #e2e8f0;
        border-radius: 12px;

        box-shadow:
            0 6px 18px rgba(15,23,42,.06);
    }

    .orders-card-header {
        padding: 19px 20px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        border-bottom: 1px solid #e2e8f0;
    }

    .orders-card-header h2 {
        margin: 0;

        color: #111827;

        font-size: 18px;
        font-weight: 900;
    }

    .orders-card-header p {
        margin: 3px 0 0;

        color: #64748b;

        font-size: 9px;
    }

    .order-count {
        padding: 6px 10px;

        border-radius: 20px;

        background: #dbeafe;
        color: #1d4ed8;

        font-size: 9px;
        font-weight: 900;
    }

    .order-row {
        padding: 18px 20px;

        display: grid;

        grid-template-columns:
            90px
            1fr
            130px
            130px
            115px;

        gap: 15px;

        align-items: center;

        border-bottom: 1px solid #eef2f7;

        transition: .15s;
    }

    .order-row:last-child {
        border-bottom: none;
    }

    .order-row:hover {
        background: #f8fafc;
    }

    .order-number {
        color: #2563eb;

        font-size: 13px;
        font-weight: 900;
    }

    .order-products {
        color: #111827;

        font-size: 11px;
        font-weight: 800;
    }

    .order-products-detail {
        margin-top: 4px;

        color: #64748b;

        font-size: 9px;
    }

    .order-date {
        color: #475569;

        font-size: 9px;
        line-height: 1.6;
    }

    .order-total {
        color: #111827;

        font-size: 14px;
        font-weight: 900;
    }

    .order-status {
        display: inline-flex;

        width: fit-content;

        padding: 6px 9px;

        border-radius: 20px;

        background: #dcfce7;
        color: #15803d;

        font-size: 9px;
        font-weight: 900;
    }

    .order-detail-button {
        min-height: 34px;

        padding: 0 12px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 5px;

        background:
            linear-gradient(
                135deg,
                #06bfff,
                #2563eb
            );

        color: white;

        text-decoration: none;

        font-size: 9px;
        font-weight: 900;

        transition: .2s;
    }

    .order-detail-button:hover {
        color: white;

        transform: translateY(-1px);

        filter: brightness(1.08);
    }


    /* SIN PEDIDOS */

    .empty-orders {
        padding: 75px 20px;

        text-align: center;
    }

    .empty-icon {
        margin-bottom: 14px;

        font-size: 58px;
    }

    .empty-orders h3 {
        margin-bottom: 7px;

        color: #111827;

        font-size: 22px;
        font-weight: 900;
    }

    .empty-orders p {
        margin-bottom: 22px;

        color: #64748b;

        font-size: 11px;
    }

    .empty-button {
        min-height: 43px;

        padding: 0 20px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 6px;

        background:
            linear-gradient(
                135deg,
                #06bfff,
                #2563eb
            );

        color: white;

        text-decoration: none;

        font-size: 10px;
        font-weight: 900;
    }

    .empty-button:hover {
        color: white;

        filter: brightness(1.08);
    }


    /* RESPONSIVE */

    @@media (max-width: 900px) {

        .order-row {
            grid-template-columns:
                80px
                1fr
                120px;

            row-gap: 12px;
        }

    }

    @@media (max-width: 700px) {

        .my-orders-container {
            width: calc(100% - 24px);
        }

        .my-orders-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .orders-summary {
            grid-template-columns: 1fr;
        }

        .order-row {
            grid-template-columns: 1fr;
        }

    }

</style>


<div class="my-orders-page">

    <div class="my-orders-container">


        <div class="my-orders-top">


            <div>


                <div class="my-orders-badge">

                    🛍️ Mi cuenta

                </div>


                <h1 class="my-orders-title">

                    Mis pedidos

                </h1>


                <p class="my-orders-subtitle">

                    Consulta tus compras realizadas en BigGame.

                </p>


            </div>



            <a asp-controller="Products"
               asp-action="Index"
               class="store-button">

                🎮 Volver a la tienda

            </a>


        </div>



        <div class="orders-summary">


            <div class="summary-card">

                <div class="summary-icon">
                    🧾
                </div>

                <div class="summary-label">

                    Mis pedidos

                </div>

                <div class="summary-value">

                    @totalOrders

                </div>

                <div class="summary-detail">

                    Compras registradas

                </div>

            </div>



            <div class="summary-card">

                <div class="summary-icon">
                    🎮
                </div>

                <div class="summary-label">

                    Productos comprados

                </div>

                <div class="summary-value products">

                    @totalProducts

                </div>

                <div class="summary-detail">

                    Unidades adquiridas

                </div>

            </div>



            <div class="summary-card">

                <div class="summary-icon">
                    💰
                </div>

                <div class="summary-label">

                    Total comprado

                </div>

                <div class="summary-value money">

                    Bs @totalSpent.ToString("N2")

                </div>

                <div class="summary-detail">

                    Total histórico

                </div>

            </div>


        </div>



        <div class="orders-card">


            <div class="orders-card-header">


                <div>

                    <h2>

                        Historial de compras

                    </h2>

                    <p>

                        Pedidos registrados con tu cuenta.

                    </p>

                </div>


                <span class="order-count">

                    @totalOrders pedido@(totalOrders == 1 ? "" : "s")

                </span>


            </div>



            @if (orders.Any())
            {

                @foreach (var order in orders)
                {

                    var quantity =
                        order.Items?.Sum(
                            item => item.Quantity
                        ) ?? 0;

                    var productNames =
                        order.Items != null
                            ? string.Join(
                                ", ",
                                order.Items
                                    .Select(item => item.ProductName)
                                    .Take(3)
                            )
                            : string.Empty;


                    <div class="order-row">


                        <div>

                            <div class="order-number">

                                #@order.Id

                            </div>

                        </div>



                        <div>

                            <div class="order-products">

                                @quantity producto@(quantity == 1 ? "" : "s")

                            </div>

                            <div class="order-products-detail">

                                @productNames

                            </div>

                        </div>



                        <div class="order-date">

                            @(order.CreatedAt
                                .ToLocalTime()
                                .ToString("dd/MM/yyyy"))

                            <br />

                            @(order.CreatedAt
                                .ToLocalTime()
                                .ToString("HH:mm"))

                        </div>



                        <div>

                            <span class="order-status">

                                @order.Status

                            </span>

                            <div class="order-total">

                                Bs @order.TotalAmount.ToString("N2")

                            </div>

                        </div>



                        <div>

                            <a asp-controller="Orders"
                               asp-action="Details"
                               asp-route-id="@order.Id"
                               class="order-detail-button">

                                Ver pedido

                            </a>

                        </div>


                    </div>

                }

            }
            else
            {

                <div class="empty-orders">


                    <div class="empty-icon">

                        🛒

                    </div>


                    <h3>

                        Todavía no tienes pedidos

                    </h3>


                    <p>

                        Cuando realices una compra,
                        aparecerá aquí automáticamente.

                    </p>


                    <a asp-controller="Products"
                       asp-action="Index"
                       class="empty-button">

                        Explorar BigGame

                    </a>


                </div>

            }


        </div>


    </div>

</div>