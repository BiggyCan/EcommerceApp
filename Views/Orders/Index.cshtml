@model List<EcommerceApp.Models.Order>

@{
    ViewData["Title"] = "Ventas";

    var orders =
        Model ?? new List<EcommerceApp.Models.Order>();

    var totalOrders =
        ViewBag.TotalOrders != null
            ? (int)ViewBag.TotalOrders
            : 0;

    var totalSales =
        ViewBag.TotalSales != null
            ? (decimal)ViewBag.TotalSales
            : 0m;

    var confirmedOrders =
        ViewBag.ConfirmedOrders != null
            ? (int)ViewBag.ConfirmedOrders
            : 0;

    var currentSearch =
        ViewBag.Search as string
        ?? string.Empty;

    var currentStatus =
        ViewBag.Status as string
        ?? string.Empty;
}

<style>

    .orders-admin-page {
        min-height: 720px;
        padding: 38px 0 75px;
        background: #f4f6f9;
    }

    .orders-container {
        width: calc(100% - 40px);
        max-width: 1160px;
        margin: auto;
    }

    .orders-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 25px;
    }

    .orders-badge {
        width: fit-content;
        margin-bottom: 10px;
        padding: 7px 12px;

        border-radius: 20px;

        background:
            linear-gradient(
                135deg,
                #4f46e5,
                #2563eb
            );

        color: white;

        font-size: 9px;
        font-weight: 900;

        text-transform: uppercase;
    }

    .orders-title {
        margin: 0;

        color: #111827;

        font-size: 31px;
        font-weight: 900;
    }

    .orders-subtitle {
        margin: 5px 0 0;

        color: #64748b;

        font-size: 12px;
    }

    .back-admin-button {
        min-height: 42px;
        padding: 0 17px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 6px;

        background: #111827;
        color: white;

        text-decoration: none;

        font-size: 11px;
        font-weight: 800;

        transition: .2s;
    }

    .back-admin-button:hover {
        color: white;
        background: #2563eb;
        transform: translateY(-1px);
    }


    /* RESUMEN */

    .orders-stats {
        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap: 15px;

        margin-bottom: 22px;
    }

    .stat-card {
        min-height: 120px;

        padding: 19px;

        position: relative;

        overflow: hidden;

        background: white;

        border: 1px solid #e2e8f0;
        border-radius: 11px;

        box-shadow:
            0 5px 16px rgba(15,23,42,.05);
    }

    .stat-label {
        margin-bottom: 13px;

        color: #64748b;

        font-size: 9px;
        font-weight: 900;

        text-transform: uppercase;
    }

    .stat-value {
        color: #111827;

        font-size: 28px;
        font-weight: 900;
    }

    .stat-value.sales {
        color: #15803d;
    }

    .stat-value.confirmed {
        color: #2563eb;
    }

    .stat-detail {
        margin-top: 4px;

        color: #94a3b8;

        font-size: 9px;
    }

    .stat-icon {
        position: absolute;

        top: 18px;
        right: 18px;

        width: 38px;
        height: 38px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 10px;

        background: #eef2ff;

        font-size: 18px;
    }


    /* FILTROS */

    .orders-filter {
        margin-bottom: 20px;
        padding: 18px;

        background: white;

        border: 1px solid #e2e8f0;
        border-radius: 11px;

        box-shadow:
            0 5px 16px rgba(15,23,42,.05);
    }

    .orders-filter-form {
        display: grid;

        grid-template-columns:
            1fr
            220px
            auto
            auto;

        gap: 10px;

        align-items: end;
    }

    .filter-field label {
        display: block;

        margin-bottom: 6px;

        color: #64748b;

        font-size: 9px;
        font-weight: 900;

        text-transform: uppercase;
    }

    .filter-field input,
    .filter-field select {
        width: 100%;
        height: 41px;

        padding: 0 12px;

        border: 1px solid #cbd5e1;
        border-radius: 6px;

        background: white;

        color: #111827;

        outline: none;

        font-size: 11px;
    }

    .filter-field input:focus,
    .filter-field select:focus {
        border-color: #2563eb;

        box-shadow:
            0 0 0 3px rgba(37,99,235,.08);
    }

    .filter-search-button {
        height: 41px;

        padding: 0 18px;

        border: none;
        border-radius: 6px;

        background:
            linear-gradient(
                135deg,
                #06bfff,
                #2563eb
            );

        color: white;

        font-size: 10px;
        font-weight: 900;

        cursor: pointer;
    }

    .filter-search-button:hover {
        filter: brightness(1.08);
    }

    .filter-clear-button {
        height: 41px;

        padding: 0 15px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 6px;

        background: #111827;

        color: white;

        text-decoration: none;

        font-size: 10px;
        font-weight: 800;
    }

    .filter-clear-button:hover {
        color: white;
        background: #1e293b;
    }


    /* TABLA */

    .orders-table-card {
        overflow: hidden;

        background: white;

        border: 1px solid #e2e8f0;
        border-radius: 12px;

        box-shadow:
            0 6px 18px rgba(15,23,42,.06);
    }

    .orders-table-header {
        padding: 18px 20px;

        display: flex;
        justify-content: space-between;
        align-items: center;

        border-bottom: 1px solid #e2e8f0;
    }

    .orders-table-header h2 {
        margin: 0;

        color: #111827;

        font-size: 18px;
        font-weight: 900;
    }

    .orders-table-header p {
        margin: 3px 0 0;

        color: #64748b;

        font-size: 9px;
    }

    .orders-result-count {
        padding: 6px 10px;

        border-radius: 20px;

        background: #dbeafe;
        color: #1d4ed8;

        font-size: 9px;
        font-weight: 900;
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .orders-table {
        width: 100%;
        min-width: 900px;

        border-collapse: collapse;
    }

    .orders-table thead {
        background: #f8fafc;
    }

    .orders-table th {
        padding: 12px 14px;

        color: #64748b;

        font-size: 8px;
        font-weight: 900;

        text-align: left;

        text-transform: uppercase;

        border-bottom: 1px solid #e2e8f0;
    }

    .orders-table td {
        padding: 14px;

        color: #334155;

        font-size: 10px;

        border-bottom: 1px solid #eef2f7;

        vertical-align: middle;
    }

    .orders-table tbody tr:last-child td {
        border-bottom: none;
    }

    .orders-table tbody tr:hover {
        background: #f8fafc;
    }

    .order-id {
        color: #2563eb;

        font-size: 11px;
        font-weight: 900;
    }

    .customer-name {
        margin-bottom: 3px;

        color: #111827;

        font-size: 11px;
        font-weight: 900;
    }

    .customer-email {
        color: #64748b;

        font-size: 9px;
    }

    .order-products-count {
        display: inline-flex;

        padding: 5px 8px;

        border-radius: 20px;

        background: #f1f5f9;

        color: #475569;

        font-size: 9px;
        font-weight: 800;
    }

    .order-total {
        color: #111827;

        font-size: 12px;
        font-weight: 900;
    }

    .order-status {
        display: inline-flex;

        padding: 5px 9px;

        border-radius: 20px;

        font-size: 9px;
        font-weight: 900;
    }

    .order-status.confirmed {
        background: #dcfce7;
        color: #15803d;
    }

    .order-status.other {
        background: #fef3c7;
        color: #b45309;
    }

    .order-date {
        color: #475569;

        font-size: 9px;
        line-height: 1.6;
    }

    .order-address {
        max-width: 170px;

        color: #64748b;

        font-size: 9px;

        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .order-view-button {
        min-height: 31px;

        padding: 0 11px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 5px;

        background: #2563eb;
        color: white;

        text-decoration: none;

        font-size: 9px;
        font-weight: 900;

        transition: .2s;
    }

    .order-view-button:hover {
        color: white;
        background: #1d4ed8;

        transform: translateY(-1px);
    }


    /* SIN PEDIDOS */

    .no-orders {
        padding: 70px 20px;

        text-align: center;
    }

    .no-orders-icon {
        margin-bottom: 13px;

        font-size: 55px;
    }

    .no-orders h3 {
        margin-bottom: 6px;

        color: #111827;

        font-size: 20px;
        font-weight: 900;
    }

    .no-orders p {
        color: #64748b;

        font-size: 11px;
    }


    /* RESPONSIVE */

    @@media (max-width: 850px) {

        .orders-stats {
            grid-template-columns: 1fr;
        }

        .orders-filter-form {
            grid-template-columns: 1fr 1fr;
        }

    }

    @@media (max-width: 600px) {

        .orders-container {
            width: calc(100% - 24px);
        }

        .orders-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .orders-filter-form {
            grid-template-columns: 1fr;
        }

    }

</style>


<div class="orders-admin-page">

    <div class="orders-container">


        <div class="orders-top">


            <div>


                <div class="orders-badge">

                    📊 Administración de ventas

                </div>


                <h1 class="orders-title">

                    Ventas de BigGame

                </h1>


                <p class="orders-subtitle">

                    Consulta los pedidos registrados,
                    los clientes y los ingresos de la tienda.

                </p>


            </div>


            <a asp-controller="Admin"
               asp-action="Index"
               class="back-admin-button">

                ← Volver al panel

            </a>


        </div>



        <div class="orders-stats">


            <div class="stat-card">

                <div class="stat-icon">
                    🧾
                </div>

                <div class="stat-label">
                    Pedidos
                </div>

                <div class="stat-value">
                    @totalOrders
                </div>

                <div class="stat-detail">
                    Pedidos registrados
                </div>

            </div>



            <div class="stat-card">

                <div class="stat-icon">
                    💰
                </div>

                <div class="stat-label">
                    Ventas totales
                </div>

                <div class="stat-value sales">

                    Bs @totalSales.ToString("N2")

                </div>

                <div class="stat-detail">
                    Ingresos registrados
                </div>

            </div>



            <div class="stat-card">

                <div class="stat-icon">
                    ✓
                </div>

                <div class="stat-label">
                    Confirmados
                </div>

                <div class="stat-value confirmed">
                    @confirmedOrders
                </div>

                <div class="stat-detail">
                    Pedidos confirmados
                </div>

            </div>


        </div>



        <div class="orders-filter">


            <form asp-controller="Orders"
                  asp-action="Index"
                  method="get"
                  class="orders-filter-form">


                <div class="filter-field">

                    <label>
                        Buscar cliente
                    </label>

                    <input type="text"
                           name="search"
                           value="@currentSearch"
                           placeholder="Nombre o correo..." />

                </div>



                <div class="filter-field">

                    <label>
                        Estado
                    </label>

                    <select name="status">


                        @if (string.IsNullOrWhiteSpace(currentStatus))
                        {
                            <option value="" selected>
                                Todos
                            </option>
                        }
                        else
                        {
                            <option value="">
                                Todos
                            </option>
                        }


                        @if (currentStatus == "Confirmado")
                        {
                            <option value="Confirmado" selected>
                                Confirmado
                            </option>
                        }
                        else
                        {
                            <option value="Confirmado">
                                Confirmado
                            </option>
                        }


                    </select>

                </div>



                <button type="submit"
                        class="filter-search-button">

                    🔍 Buscar

                </button>



                <a asp-controller="Orders"
                   asp-action="Index"
                   class="filter-clear-button">

                    Limpiar

                </a>


            </form>


        </div>



        <div class="orders-table-card">


            <div class="orders-table-header">


                <div>

                    <h2>
                        Pedidos registrados
                    </h2>

                    <p>
                        Ventas almacenadas en BigGame
                    </p>

                </div>


                <span class="orders-result-count">

                    @orders.Count resultado@(orders.Count == 1 ? "" : "s")

                </span>


            </div>



            @if (orders.Any())
            {

                <div class="table-wrapper">


                    <table class="orders-table">


                        <thead>

                            <tr>

                                <th>
                                    Pedido
                                </th>

                                <th>
                                    Cliente
                                </th>

                                <th>
                                    Dirección
                                </th>

                                <th>
                                    Productos
                                </th>

                                <th>
                                    Total
                                </th>

                                <th>
                                    Estado
                                </th>

                                <th>
                                    Fecha
                                </th>

                                <th>
                                    Acciones
                                </th>

                            </tr>

                        </thead>



                        <tbody>


                            @foreach (var order in orders)
                            {

                                var itemCount =
                                    order.Items
                                        .Sum(item => item.Quantity);


                                <tr>


                                    <td>

                                        <span class="order-id">

                                            #@order.Id

                                        </span>

                                    </td>



                                    <td>


                                        <div class="customer-name">

                                            @order.CustomerName

                                        </div>


                                        <div class="customer-email">

                                            @order.CustomerEmail

                                        </div>


                                    </td>



                                    <td>

                                        <div class="order-address"
                                             title="@order.ShippingAddress">

                                            @(string.IsNullOrWhiteSpace(order.ShippingAddress)
                                                ? "No especificada"
                                                : order.ShippingAddress)

                                        </div>

                                    </td>



                                    <td>

                                        <span class="order-products-count">

                                            @itemCount producto@(itemCount == 1 ? "" : "s")

                                        </span>

                                    </td>



                                    <td>

                                        <span class="order-total">

                                            Bs @order.TotalAmount.ToString("N2")

                                        </span>

                                    </td>



                                    <td>


                                        <span class="order-status @(order.Status == "Confirmado" ? "confirmed" : "other")">

                                            @order.Status

                                        </span>


                                    </td>



                                    <td>

                                        <div class="order-date">

                                            @(order.CreatedAt
                                                .ToLocalTime()
                                                .ToString("dd/MM/yyyy"))

                                            <br />

                                            @(order.CreatedAt
                                                .ToLocalTime()
                                                .ToString("HH:mm"))

                                        </div>

                                    </td>



                                    <td>

                                        <a asp-controller="Orders"
                                           asp-action="Details"
                                           asp-route-id="@order.Id"
                                           class="order-view-button">

                                            Ver detalle

                                        </a>

                                    </td>


                                </tr>

                            }


                        </tbody>


                    </table>


                </div>

            }
            else
            {

                <div class="no-orders">


                    <div class="no-orders-icon">
                        🧾
                    </div>


                    <h3>
                        No se encontraron pedidos
                    </h3>


                    <p>
                        Todavía no existen ventas que coincidan
                        con los filtros seleccionados.
                    </p>


                </div>

            }


        </div>


    </div>

</div>