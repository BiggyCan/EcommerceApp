</style>


<section class="pokemon-home"
         id="pokemon-tcg">

    <div class="pokemon-home-container">


        <!-- =====================================================
             CABECERA
        ====================================================== -->

        <div class="pokemon-home-heading">

            <div class="pokemon-home-heading-left">

                <div class="pokemon-home-kicker">
                    Pokémon TCG
                </div>

                <h2 class="pokemon-home-title">
                    Compra Pokémon TCG por colección
                </h2>

                <p class="pokemon-home-subtitle">
                    Descubre sobres, colecciones y productos Pokémon
                    disponibles en BigGame.
                </p>

            </div>


            <a asp-controller="Products"
               asp-action="Index"
               asp-route-search="Pokémon"
               class="pokemon-home-view-all">

                Ver todos →

            </a>

        </div>


        <!-- =====================================================
             TABS
        ====================================================== -->

        <div class="pokemon-tabs"
             id="pokemonTabs">

            <button type="button"
                    class="pokemon-tab active"
                    data-pokemon-target="all">

                Todos

            </button>


            <button type="button"
                    class="pokemon-tab"
                    data-pokemon-target="30th Celebration">

                30th Celebration

            </button>


            <button type="button"
                    class="pokemon-tab"
                    data-pokemon-target="Delta Reign">

                Delta Reign

            </button>


            <button type="button"
                    class="pokemon-tab"
                    data-pokemon-target="Pitch Black">

                Pitch Black

            </button>


            <button type="button"
                    class="pokemon-tab"
                    data-pokemon-target="Chaos Rising">

                Chaos Rising

            </button>


            <button type="button"
                    class="pokemon-tab"
                    data-pokemon-target="Perfect Order">

                Perfect Order

            </button>

        </div>


        @if (orderedPokemon.Any())
        {
            <div class="pokemon-carousel">


                <!-- FLECHA IZQUIERDA -->

                <button type="button"
                        class="pokemon-arrow pokemon-arrow-left"
                        id="pokemonPrevious"
                        aria-label="Productos anteriores">

                    ‹

                </button>


                <!-- PRODUCTOS -->

                <div class="pokemon-products"
                     id="pokemonProducts">


                    @foreach (var product in orderedPokemon)
                    {
                        var image =
                            PokemonImage(product);

                        var collection =
                            CollectionName(product);


                        <article class="pokemon-product-card"
                                 data-pokemon-name="@product.Name">


                            <!-- IMAGEN -->

                            <div class="pokemon-product-image">

                                <span class="pokemon-badge">
                                    Pokémon TCG
                                </span>


                                @if (
                                    !string.IsNullOrWhiteSpace(
                                        image
                                    )
                                )
                                {
                                    <img src="@image"
                                         alt="@product.Name"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="pokemon-product-placeholder">
                                        🃏
                                    </div>
                                }

                            </div>


                            <!-- INFO -->

                            <div class="pokemon-product-info">

                                <div class="pokemon-product-category">
                                    @product.Category
                                </div>


                                <div class="pokemon-product-name">
                                    @product.Name
                                </div>


                                <div class="pokemon-product-price">

                                    Bs @product.Price.ToString("N2")

                                </div>


                                @if (product.Stock > 0)
                                {
                                    <div class="pokemon-product-stock">

                                        @product.Stock disponibles

                                    </div>
                                }
                                else
                                {
                                    <div class="pokemon-product-stock out">

                                        Agotado

                                    </div>
                                }


                                <!-- BOTONES -->

                                <div class="pokemon-card-actions">

                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="pokemon-details-button">

                                        Ver producto

                                    </a>


                                    @if (product.Stock > 0)
                                    {
                                        <form asp-controller="Cart"
                                              asp-action="Add"
                                              method="post"
                                              class="pokemon-cart-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@product.Id" />

                                            <button type="submit"
                                                    class="pokemon-cart-button"
                                                    title="Agregar al carrito"
                                                    aria-label="Agregar @product.Name al carrito">

                                                🛒

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="pokemon-cart-button"
                                                disabled
                                                title="Producto agotado">

                                            🛒

                                        </button>
                                    }

                                </div>

                            </div>

                        </article>
                    }

                </div>


                <!-- FLECHA DERECHA -->

                <button type="button"
                        class="pokemon-arrow pokemon-arrow-right"
                        id="pokemonNext"
                        aria-label="Más productos">

                    ›

                </button>

            </div>
        }
        else
        {
            <div class="pokemon-empty">

                <div class="pokemon-empty-icon">
                    🃏
                </div>

                <strong>
                    Próximamente más Pokémon TCG
                </strong>

                <span>
                    Estamos preparando esta sección.
                </span>

            </div>
        }

    </div>

</section>


<script>

    (function () {

        const row =
            document.getElementById(
                "pokemonProducts"
            );


        const previousButton =
            document.getElementById(
                "pokemonPrevious"
            );


        const nextButton =
            document.getElementById(
                "pokemonNext"
            );


        const tabs =
            Array.from(
                document.querySelectorAll(
                    ".pokemon-tab"
                )
            );


        if (!row) {
            return;
        }


        /* =====================================================
           FLECHAS
        ====================================================== */

        if (previousButton) {

            previousButton.addEventListener(
                "click",
                function () {

                    row.scrollBy({
                        left: -735,
                        behavior: "smooth"
                    });
                }
            );
        }


        if (nextButton) {

            nextButton.addEventListener(
                "click",
                function () {

                    row.scrollBy({
                        left: 735,
                        behavior: "smooth"
                    });
                }
            );
        }


        /* =====================================================
           TABS
        ====================================================== */

        tabs.forEach(
            function (tab) {

                tab.addEventListener(
                    "click",
                    function () {

                        tabs.forEach(
                            function (item) {

                                item.classList.remove(
                                    "active"
                                );
                            }
                        );


                        tab.classList.add(
                            "active"
                        );


                        const target =
                            tab.dataset.pokemonTarget;


                        if (
                            !target
                            ||
                            target === "all"
                        )
                        {
                            row.scrollTo({
                                left: 0,
                                behavior: "smooth"
                            });

                            return;
                        }


                        const cards =
                            Array.from(
                                row.querySelectorAll(
                                    ".pokemon-product-card"
                                )
                            );


                        const targetCard =
                            cards.find(
                                function (card) {

                                    const name =
                                        card.dataset.pokemonName
                                        || "";


                                    return name
                                        .toLowerCase()
                                        .includes(
                                            target.toLowerCase()
                                        );
                                }
                            );


                        if (targetCard) {

                            targetCard.scrollIntoView({
                                behavior: "smooth",
                                inline: "start",
                                block: "nearest"
                            });
                        }
                    }
                );
            }
        );

    })();

</script>