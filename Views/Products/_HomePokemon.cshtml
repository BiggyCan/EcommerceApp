@model List<EcommerceApp.Models.Product>

@{
    var allProducts =
        Model ?? new List<EcommerceApp.Models.Product>();


    var pokemonProducts =
        allProducts
            .Where(
                p =>
                    p.Name.Contains(
                        "Pokémon",
                        StringComparison.OrdinalIgnoreCase
                    )
                    ||
                    p.Name.Contains(
                        "Pokemon",
                        StringComparison.OrdinalIgnoreCase
                    )
            )
            .ToList();


    var preferredNames = new[]
    {
        "30th Celebration",
        "Delta Reign",
        "Pitch Black",
        "Chaos Rising",
        "Perfect Order"
    };


    var orderedPokemon =
        new List<EcommerceApp.Models.Product>();


    foreach (var preferredName in preferredNames)
    {
        var product =
            pokemonProducts.FirstOrDefault(
                p =>
                    p.Name.Contains(
                        preferredName,
                        StringComparison.OrdinalIgnoreCase
                    )
            );


        if (
            product != null
            &&
            !orderedPokemon.Any(
                p => p.Id == product.Id
            )
        )
        {
            orderedPokemon.Add(product);
        }
    }


    foreach (var product in pokemonProducts)
    {
        if (
            !orderedPokemon.Any(
                p => p.Id == product.Id
            )
        )
        {
            orderedPokemon.Add(product);
        }
    }


    string PokemonImage(
        EcommerceApp.Models.Product product
    )
    {
        var name =
            product.Name ?? string.Empty;


        if (
            name.Contains(
                "30th Celebration",
                StringComparison.OrdinalIgnoreCase
            )
        )
        {
            return "/images/products/pokemon-30th.jpg";
        }


        if (
            name.Contains(
                "Delta Reign",
                StringComparison.OrdinalIgnoreCase
            )
        )
        {
            return "/images/products/pokemon-delta-reign.jpg";
        }


        if (
            name.Contains(
                "Pitch Black",
                StringComparison.OrdinalIgnoreCase
            )
        )
        {
            return "/images/products/pokemon-pitch-black.jpg";
        }


        if (
            name.Contains(
                "Chaos Rising",
                StringComparison.OrdinalIgnoreCase
            )
        )
        {
            return "/images/products/pokemon-chaos-rising.jpg";
        }


        if (
            name.Contains(
                "Perfect Order",
                StringComparison.OrdinalIgnoreCase
            )
        )
        {
            return "/images/products/pokemon-perfect-order.jpg";
        }


        if (
            !string.IsNullOrWhiteSpace(
                product.ImageUrl
            )
        )
        {
            return product.ImageUrl;
        }


        return "";
    }


    string CollectionName(
        EcommerceApp.Models.Product product
    )
    {
        var name =
            product.Name ?? string.Empty;


        name =
            name.Replace(
                "Pokémon TCG ",
                "",
                StringComparison.OrdinalIgnoreCase
            );


        name =
            name.Replace(
                "Pokemon TCG ",
                "",
                StringComparison.OrdinalIgnoreCase
            );


        name =
            name.Replace(
                "Mega Evolution ",
                "",
                StringComparison.OrdinalIgnoreCase
            );


        name =
            name.Replace(
                " Pack",
                "",
                StringComparison.OrdinalIgnoreCase
            );


        return name.Trim();
    }
}


<style>

    /* =========================================================
       SECCIÓN POKÉMON
