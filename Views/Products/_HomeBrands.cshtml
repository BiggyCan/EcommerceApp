@model List<EcommerceApp.Models.Product>

@{
    var products =
        Model ?? new List<EcommerceApp.Models.Product>();

    int CountBrand(params string[] terms)
    {
        return products.Count(
            product =>
            {
                var name =
                    (product.Name ?? string.Empty)
                    .ToLowerInvariant();

                var description =
                    (product.Description ?? string.Empty)
                    .ToLowerInvariant();

                var category =
                    (product.Category ?? string.Empty)
                    .ToLowerInvariant();

                var combined =
                    $"{name} {description} {category}";

                return terms.Any(
                    term =>
                        combined.Contains(
                            term.ToLowerInvariant()
                        )
                );
            }
        );
    }

    var playStationCount =
        CountBrand(
            "playstation",
            "ps5",
            "dualsense"
        );

    var xboxCount =
        CountBrand(
            "xbox",
            "microsoft"
        );

    var nintendoCount =
        CountBrand(
            "nintendo",
            "switch"
        );

    var pokemonCount =
        CountBrand(
            "pokémon",
            "pokemon"
        );

    var marvelCount =
        CountBrand(
            "marvel",
            "wolverine",
            "punisher"
        );

    var yugiohCount =
        CountBrand(
            "yu-gi-oh",
            "yugioh"
        );

    var turtleBeachCount =
        CountBrand(
            "turtle beach"
        );

    var funkoCount =
        CountBrand(
            "funko"
        );
}

