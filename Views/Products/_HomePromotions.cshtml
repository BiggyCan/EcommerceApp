<style>

    /* =========================================================
       PROMOCIONES BIGGAME
    ========================================================= */

    .promo-home {
        width: 100%;
        padding: 55px 0 65px;

        background: #f4f5f7;

        color: #111111;
    }

    .promo-container {
        width: calc(100% - 40px);
        max-width: 1460px;

        margin: 0 auto;
    }


    /* =========================================================
       CABECERA
    ========================================================= */

    .promo-heading {
        margin-bottom: 24px;
    }

    .promo-kicker {
        margin-bottom: 6px;

        color: #e11d2e;

        font-size: 11px;
        font-weight: 900;

        letter-spacing: 1px;

        text-transform: uppercase;
    }

    .promo-title {
        margin: 0;

        color: #111827;

        font-size: 32px;
        line-height: 1.1;

        font-weight: 900;

        letter-spacing: -0.8px;
    }

    .promo-subtitle {
        margin: 8px 0 0;

        color: #64748b;

        font-size: 13px;
        line-height: 1.5;
    }


    /* =========================================================
       GRID PRINCIPAL
    ========================================================= */

    .promo-grid {
        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap: 16px;
    }


    /* =========================================================
       TARJETAS PROMOCIONALES
    ========================================================= */

    .promo-card {
        position: relative;

        min-height: 350px;

        overflow: hidden;

        border-radius: 12px;

        color: #ffffff;

        text-decoration: none;

        box-shadow:
            0 10px 30px
            rgba(15, 23, 42, 0.12);

        transition:
            transform 0.22s ease,
            box-shadow 0.22s ease;
    }

    .promo-card:hover {
        transform: translateY(-5px);

        box-shadow:
            0 18px 38px
            rgba(15, 23, 42, 0.18);

        color: #ffffff;
    }

    .promo-card::before {
        content: "";

        position: absolute;

        inset: 0;

        z-index: 1;
    }


    /* =========================================================
       PROMO 1
    ========================================================= */

    .promo-card-one {
        background:
            radial-gradient(
                circle at 80% 20%,
                rgba(255,255,255,0.18),
                transparent 26%
            ),
            linear-gradient(
                135deg,
                #25106d,
                #7137d8,
                #9b40ef
            );
    }

    .promo-card-one::before {
        background:
            linear-gradient(
                120deg,
                rgba(13, 6, 36, 0.16),
                transparent
            );
    }


    /* =========================================================
       PROMO 2
    ========================================================= */

    .promo-card-two {
        background:
            radial-gradient(
                circle at 78% 30%,
                rgba(255,255,255,0.17),
                transparent 28%
            ),
            linear-gradient(
                135deg,
                #7a0606,
                #d00b18,
                #ff2638
            );
    }


    /* =========================================================
       PROMO 3
    ========================================================= */

    .promo-card-three {
        background:
            radial-gradient(
                circle at 80% 25%,
                rgba(255,255,255,0.20),
                transparent 30%
            ),
            linear-gradient(
                135deg,
                #07316c,
                #0e7cdb,
                #29a9ff
            );
    }


    /* =========================================================
       CONTENIDO
    ========================================================= */

    .promo-content {
        position: relative;

        z-index: 3;

        min-height: 350px;

        padding:
            30px
            28px;

        display: flex;
        flex-direction: column;
    }

    .promo-label {
        width: fit-content;

        margin-bottom: 18px;

        padding:
            6px
            10px;

        border-radius: 5px;

        background:
            rgba(255,255,255,0.18);

        color: #ffffff;

        font-size: 10px;
        font-weight: 900;

        letter-spacing: 0.7px;

        text-transform: uppercase;

        backdrop-filter: blur(4px);
    }

    .promo-card-title {
        max-width: 330px;

        margin:
            0
            0
            12px;

        color: #ffffff;

        font-size: 31px;
        line-height: 1.03;

        font-weight: 900;

        letter-spacing: -0.8px;
    }

    .promo-card-description {
        max-width: 330px;

        margin: 0;

        color:
            rgba(255,255,255,0.88);

        font-size: 13px;
        line-height: 1.55;
    }

    .promo-bottom {
        margin-top: auto;

        display: flex;
        align-items: flex-end;
        justify-content: space-between;

        gap: 18px;
    }

    .promo-button {
        min-height: 42px;

        padding:
            0
            18px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 5px;

        background: #ffffff;

        color: #111111;

        font-size: 11px;
        font-weight: 900;

        transition:
            transform 0.18s ease,
            background 0.18s ease;
    }

    .promo-card:hover
    .promo-button {
        transform:
            translateY(-2px);

        background: #f4f4f4;
    }

    .promo-symbol {
        flex: 0 0 auto;

        font-size: 78px;

        opacity: 0.90;

        filter:
            drop-shadow(
                0 10px 15px
                rgba(0,0,0,0.18)
            );
    }


    /* =========================================================
       BANNER GRANDE
    ========================================================= */

    .promo-wide {
        position: relative;

        min-height: 220px;

        margin-top: 18px;

        overflow: hidden;

        border-radius: 12px;

        background:
            radial-gradient(
                circle at 78% 50%,
                rgba(51, 195, 255, 0.34),
                transparent 28%
            ),
            linear-gradient(
                110deg,
                #070d18 0%,
                #081e42 50%,
                #113d7a 100%
            );

        color: #ffffff;

        box-shadow:
            0 10px 30px
            rgba(15,23,42,0.13);
    }

    .promo-wide-content {
        position: relative;

        z-index: 3;

        min-height: 220px;

        padding:
            38px
            45px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 30px;
    }

    .promo-wide-left {
        max-width: 720px;
    }

    .promo-wide-kicker {
        margin-bottom: 8px;

        color: #4dc9ff;

        font-size: 11px;
        font-weight: 900;

        letter-spacing: 1px;

        text-transform: uppercase;
    }

    .promo-wide-title {
        margin:
            0
            0
            10px;

        font-size: 38px;
        line-height: 1.04;

        font-weight: 900;

        letter-spacing: -1px;
    }

    .promo-wide-description {
        margin: 0;

        color:
            rgba(255,255,255,0.83);

        font-size: 14px;
        line-height: 1.55;
    }

    .promo-wide-action {
        flex: 0 0 auto;
    }

    .promo-wide-button {
        min-height: 48px;

        padding:
            0
            24px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border:
            2px solid #ffffff;

        border-radius: 5px;

        background: #ffffff;

        color: #111111;

        text-decoration: none;

        font-size: 12px;
        font-weight: 900;

        transition:
            background 0.18s ease,
            transform 0.18s ease;
    }

    .promo-wide-button:hover {
        background: transparent;

        color: #ffffff;

        transform:
            translateY(-2px);
    }


    /* =========================================================
       DECORACIÓN
    ========================================================= */

    .promo-wide-circle {
        position: absolute;

        right: 10%;

        top: 50%;

        width: 280px;
        height: 280px;

        transform:
            translateY(-50%);

        border-radius: 50%;

        border:
            2px solid
            rgba(255,255,255,0.08);

        pointer-events: none;
    }

    .promo-wide-circle::before {
        content: "";

        position: absolute;

        inset: 42px;

        border-radius: 50%;

        border:
            2px solid
            rgba(255,255,255,0.08);
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @@media (max-width: 1000px) {

        .promo-grid {
            grid-template-columns:
                repeat(2, 1fr);
        }

        .promo-card-three {
            grid-column:
                1 / -1;
        }
    }

    @@media (max-width: 700px) {

        .promo-home {
            padding:
                42px
                0
                48px;
        }

        .promo-container {
            width:
                calc(100% - 22px);
        }

        .promo-title {
            font-size: 26px;
        }

        .promo-grid {
            grid-template-columns:
                1fr;
        }

        .promo-card-three {
            grid-column: auto;
        }

        .promo-card {
            min-height: 320px;
        }

        .promo-content {
            min-height: 320px;

            padding:
                25px
                22px;
        }

        .promo-card-title {
            font-size: 27px;
        }

        .promo-symbol {
            font-size: 60px;
        }

        .promo-wide-content {
            min-height: 260px;

            padding:
                32px
                25px;

            flex-direction: column;

            align-items: flex-start;
            justify-content: center;
        }

        .promo-wide-title {
            font-size: 30px;
        }

        .promo-wide-circle {
            opacity: 0.45;
        }
    }

</style>


<section class="promo-home"
         id="promociones">

    <div class="promo-container">


        <!-- =====================================================
             CABECERA
        ====================================================== -->

        <div class="promo-heading">

            <div class="promo-kicker">
                OFERTAS BIGGAME
            </div>

            <h2 class="promo-title">
                Promociones para seguir jugando
            </h2>

            <p class="promo-subtitle">
                Explora productos, accesorios y coleccionables
                seleccionados de BigGame.
            </p>

        </div>


        <!-- =====================================================
             PROMOCIONES
        ====================================================== -->

        <div class="promo-grid">


            <!-- PROMO 1 -->

            <a asp-controller="Products"
               asp-action="Index"
               asp-route-search="coleccionable"
               class="promo-card promo-card-one">

                <div class="promo-content">

                    <div class="promo-label">
                        BIGGAME PRO
                    </div>

                    <h3 class="promo-card-title">
                        Coleccionables para todos
                    </h3>

                    <p class="promo-card-description">
                        Descubre figuras, Funko, cartas
                        y productos para ampliar tu colección.
                    </p>

                    <div class="promo-bottom">

                        <span class="promo-button">
                            Ver coleccionables
                        </span>

                        <span class="promo-symbol">
                            ⭐
                        </span>

                    </div>

                </div>

            </a>


            <!-- PROMO 2 -->

            <a asp-controller="Products"
               asp-action="Index"
               asp-route-search="oferta"
               class="promo-card promo-card-two">

                <div class="promo-content">

                    <div class="promo-label">
                        OFERTAS
                    </div>

                    <h3 class="promo-card-title">
                        Encuentra tu próxima oferta
                    </h3>

                    <p class="promo-card-description">
                        Revisa videojuegos, accesorios y productos
                        seleccionados disponibles en BigGame.
                    </p>

                    <div class="promo-bottom">

                        <span class="promo-button">
                            Ver ofertas
                        </span>

                        <span class="promo-symbol">
                            🔥
                        </span>

                    </div>

                </div>

            </a>


            <!-- PROMO 3 -->

            <a asp-controller="Products"
               asp-action="Index"
               asp-route-search="accesorio"
               class="promo-card promo-card-three">

                <div class="promo-content">

                    <div class="promo-label">
                        ACCESORIOS
                    </div>

                    <h3 class="promo-card-title">
                        Mejora tu setup gaming
                    </h3>

                    <p class="promo-card-description">
                        Controles, audífonos y accesorios
                        para completar tu experiencia de juego.
                    </p>

                    <div class="promo-bottom">

                        <span class="promo-button">
                            Ver accesorios
                        </span>

                        <span class="promo-symbol">
                            🎧
                        </span>

                    </div>

                </div>

            </a>

        </div>


        <!-- =====================================================
             BANNER HORIZONTAL
        ====================================================== -->

        <div class="promo-wide">

            <div class="promo-wide-circle">
            </div>

            <div class="promo-wide-content">

                <div class="promo-wide-left">

                    <div class="promo-wide-kicker">
                        BIGGAME
                    </div>

                    <h3 class="promo-wide-title">
                        Juega más. Descubre más.
                    </h3>

                    <p class="promo-wide-description">
                        Explora el catálogo completo de videojuegos,
                        consolas, accesorios, cartas y coleccionables
                        disponibles en BigGame.
                    </p>

                </div>

                <div class="promo-wide-action">

                    <a asp-controller="Products"
                       asp-action="Index"
                       class="promo-wide-button">

                        Explorar toda la tienda

                    </a>

                </div>

            </div>

        </div>

    </div>

</section>