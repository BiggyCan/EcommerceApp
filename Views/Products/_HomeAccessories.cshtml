</style>


<section class="accessories-home"
         id="accesorios">

    <div class="accessories-container">


        <!-- =====================================================
             ENCABEZADO
        ====================================================== -->

        <div class="accessories-heading">

            <div class="accessories-heading-left">

                <div class="accessories-kicker">
                    ACCESORIOS GAMING
                </div>

                <h2 class="accessories-title">
                    Completa tu setup
                </h2>

                <p class="accessories-subtitle">
                    Controles, auriculares, teclados,
                    almacenamiento y accesorios para jugar mejor.
                </p>

            </div>


            <a asp-controller="Products"
               asp-action="Index"
               asp-route-search="Accesorios"
               class="accessories-view-all">

                Ver todos →

            </a>

        </div>


        <!-- =====================================================
             BANNER
        ====================================================== -->

        <div class="accessories-banner">

            <div class="accessories-banner-content">

                <div class="accessories-banner-left">

                    <div class="accessories-banner-label">
                        BIGGAME GEAR
                    </div>

                    <h3 class="accessories-banner-title">
                        Tu partida. Tu equipo.
                    </h3>

                    <p class="accessories-banner-description">
                        Mejora tu experiencia con controles,
                        audio, periféricos y almacenamiento
                        para consola y PC.
                    </p>

                </div>


                <div class="accessories-banner-icons">

                    <div class="accessories-banner-icon">
                        🎮
                    </div>

                    <div class="accessories-banner-icon">
                        🎧
                    </div>

                    <div class="accessories-banner-icon">
                        ⌨️
                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             FILTROS
        ====================================================== -->

        <div class="accessories-tabs"
             id="accessoriesTabs">

            <button type="button"
                    class="accessories-tab active"
                    data-accessory-filter="todos">

                Todos

            </button>


            <button type="button"
                    class="accessories-tab"
                    data-accessory-filter="controles">

                Controles

            </button>


            <button type="button"
                    class="accessories-tab"
                    data-accessory-filter="auriculares">

                Auriculares

            </button>


            <button type="button"
                    class="accessories-tab"
                    data-accessory-filter="teclados">

                Teclados

            </button>


            <button type="button"
                    class="accessories-tab"
                    data-accessory-filter="almacenamiento">

                Almacenamiento

            </button>


            <button type="button"
                    class="accessories-tab"
                    data-accessory-filter="playstation">

                PlayStation

            </button>


            <button type="button"
                    class="accessories-tab"
                    data-accessory-filter="xbox">

                Xbox

            </button>


            <button type="button"
                    class="accessories-tab"
                    data-accessory-filter="nintendo">

                Nintendo

            </button>

        </div>


        <!-- =====================================================
             PRODUCTOS
        ====================================================== -->

        @if (accessories.Any())
        {
            <div class="accessories-carousel">

                <button type="button"
                        class="accessories-arrow accessories-arrow-left"
                        id="accessoriesPrevious"
                        aria-label="Accesorios anteriores">

                    ‹

                </button>


                <div class="accessories-products"
                     id="accessoriesProducts">

                    @foreach (var product in accessories)
                    {
                        var type =
                            AccessoryType(product);

                        var platform =
                            AccessoryPlatform(product);

                        var label =
                            AccessoryLabel(product);

                        var icon =
                            AccessoryIcon(product);


                        <article class="accessories-card"
                                 data-accessory-type="@type"
                                 data-accessory-platform="@platform">


                            <!-- IMAGEN -->

                            <div class="accessories-image">

                                <span class="accessories-type-badge">
                                    @label
                                </span>


                                <span class="accessories-platform-badge">

                                    @switch (platform)
                                    {
                                        case "playstation":
                                            @:PlayStation
                                            break;

                                        case "xbox":
                                            @:Xbox
                                            break;

                                        case "nintendo":
                                            @:Nintendo
                                            break;

                                        default:
                                            @:PC Gaming
                                            break;
                                    }

                                </span>


                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.Name"
                                         loading="lazy"
                                         onerror="
                                            this.style.display='none';
                                            this.nextElementSibling.style.display='flex';
                                         " />

                                    <div class="accessories-placeholder"
                                         style="display:none;">
                                        @icon
                                    </div>
                                }
                                else
                                {
                                    <div class="accessories-placeholder">
                                        @icon
                                    </div>
                                }

                            </div>


                            <!-- INFORMACIÓN -->

                            <div class="accessories-info">

                                <div class="accessories-category">
                                    @label
                                </div>


                                <div class="accessories-name">
                                    @product.Name
                                </div>


                                <div class="accessories-price">
                                    Bs @product.Price.ToString("N2")
                                </div>


                                @if (product.Stock > 0)
                                {
                                    <div class="accessories-stock">
                                        @product.Stock disponibles
                                    </div>
                                }
                                else
                                {
                                    <div class="accessories-stock out">
                                        Agotado
                                    </div>
                                }


                                <!-- ACCIONES -->

                                <div class="accessories-actions">

                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="accessories-details">

                                        Ver producto

                                    </a>


                                    @if (product.Stock > 0)
                                    {
                                        <form asp-controller="Cart"
                                              asp-action="Add"
                                              method="post"
                                              class="accessories-cart-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@product.Id" />

                                            <button type="submit"
                                                    class="accessories-cart"
                                                    title="Agregar al carrito"
                                                    aria-label="Agregar @product.Name al carrito">

                                                🛒

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="accessories-cart"
                                                disabled
                                                title="Producto agotado">

                                            🛒

                                        </button>
                                    }

                                </div>

                            </div>

                        </article>
                    }

                </div>


                <button type="button"
                        class="accessories-arrow accessories-arrow-right"
                        id="accessoriesNext"
                        aria-label="Más accesorios">

                    ›

                </button>

            </div>


            <div class="accessories-filter-empty"
                 id="accessoriesFilterEmpty">

                <strong>
                    No hay accesorios en esta categoría
                </strong>

                <span>
                    Prueba con otra opción.
                </span>

            </div>
        }
        else
        {
            <div class="accessories-empty">

                <div class="accessories-empty-icon">
                    🎧
                </div>

                <strong>
                    Próximamente más accesorios
                </strong>

                <span>
                    Estamos preparando nuevos productos para BigGame.
                </span>

            </div>
        }

    </div>

</section>


<script>

    (function () {

        const row =
            document.getElementById(
                "accessoriesProducts"
            );

        const previousButton =
            document.getElementById(
                "accessoriesPrevious"
            );

        const nextButton =
            document.getElementById(
                "accessoriesNext"
            );

        const tabs =
            Array.from(
                document.querySelectorAll(
                    ".accessories-tab"
                )
            );

        const emptyMessage =
            document.getElementById(
                "accessoriesFilterEmpty"
            );


        if (!row) {
            return;
        }


        /* =====================================================
           FLECHAS
        ====================================================== */

        if (previousButton) {

            previousButton.addEventListener(
                "click",
                function () {

                    row.scrollBy({
                        left: -735,
                        behavior: "smooth"
                    });

                }
            );

        }


        if (nextButton) {

            nextButton.addEventListener(
                "click",
                function () {

                    row.scrollBy({
                        left: 735,
                        behavior: "smooth"
                    });

                }
            );

        }


        /* =====================================================
           FILTROS
        ====================================================== */

        tabs.forEach(
            function (tab) {

                tab.addEventListener(
                    "click",
                    function () {

                        tabs.forEach(
                            function (item) {

                                item.classList.remove(
                                    "active"
                                );

                            }
                        );


                        tab.classList.add(
                            "active"
                        );


                        const filter =
                            tab.dataset.accessoryFilter
                            || "todos";


                        const cards =
                            Array.from(
                                row.querySelectorAll(
                                    ".accessories-card"
                                )
                            );


                        let visibleCount = 0;


                        cards.forEach(
                            function (card) {

                                const type =
                                    card.dataset.accessoryType
                                    || "";

                                const platform =
                                    card.dataset.accessoryPlatform
                                    || "";


                                let visible = false;


                                if (filter === "todos")
                                {
                                    visible = true;
                                }
                                else if (
                                    filter === "playstation"
                                    || filter === "xbox"
                                    || filter === "nintendo"
                                )
                                {
                                    visible =
                                        platform === filter;
                                }
                                else
                                {
                                    visible =
                                        type === filter;
                                }


                                card.style.display =
                                    visible
                                    ? "flex"
                                    : "none";


                                if (visible) {
                                    visibleCount++;
                                }

                            }
                        );


                        if (emptyMessage) {

                            emptyMessage.style.display =
                                visibleCount === 0
                                ? "block"
                                : "none";

                        }


                        row.scrollTo({
                            left: 0,
                            behavior: "smooth"
                        });

                    }
                );

            }
        );

    })();

</script>