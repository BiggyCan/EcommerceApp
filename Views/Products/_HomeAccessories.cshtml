@model List<EcommerceApp.Models.Product>

@{
    var products =
        Model ?? new List<EcommerceApp.Models.Product>();

    bool IsAccessory(EcommerceApp.Models.Product product)
    {
        var name =
            (product.Name ?? string.Empty)
            .ToLowerInvariant();

        var category =
            (product.Category ?? string.Empty)
            .ToLowerInvariant();

        return
            category.Contains("accesorio")
            || category.Contains("pc gaming")
            || name.Contains("controller")
            || name.Contains("control")
            || name.Contains("dualsense")
            || name.Contains("headset")
            || name.Contains("auricular")
            || name.Contains("keyboard")
            || name.Contains("teclado")
            || name.Contains("ssd")
            || name.Contains("almacenamiento");
    }

    string AccessoryType(EcommerceApp.Models.Product product)
    {
        var name =
            (product.Name ?? string.Empty)
            .ToLowerInvariant();

        if (
            name.Contains("controller")
            || name.Contains("control")
            || name.Contains("dualsense")
        )
        {
            return "controles";
        }

        if (
            name.Contains("headset")
            || name.Contains("auricular")
        )
        {
            return "auriculares";
        }

        if (
            name.Contains("keyboard")
            || name.Contains("teclado")
        )
        {
            return "teclados";
        }

        if (
            name.Contains("ssd")
            || name.Contains("storage")
            || name.Contains("almacenamiento")
        )
        {
            return "almacenamiento";
        }

        return "otros";
    }

    string AccessoryPlatform(EcommerceApp.Models.Product product)
    {
        var name =
            (product.Name ?? string.Empty)
            .ToLowerInvariant();

        var description =
            (product.Description ?? string.Empty)
            .ToLowerInvariant();

        var combined =
            name + " " + description;

        if (
            combined.Contains("playstation")
            || combined.Contains("ps5")
            || combined.Contains("dualsense")
        )
        {
            return "playstation";
        }

        if (
            combined.Contains("xbox")
            || combined.Contains("microsoft")
        )
        {
            return "xbox";
        }

        if (
            combined.Contains("nintendo")
            || combined.Contains("switch")
        )
        {
            return "nintendo";
        }

        return "pc";
    }

    string AccessoryLabel(EcommerceApp.Models.Product product)
    {
        return AccessoryType(product) switch
        {
            "controles" => "Controles",
            "auriculares" => "Auriculares",
            "teclados" => "Teclados",
            "almacenamiento" => "Almacenamiento",
            _ => "Accesorios"
        };
    }

    string AccessoryIcon(EcommerceApp.Models.Product product)
    {
        return AccessoryType(product) switch
        {
            "controles" => "🎮",
            "auriculares" => "🎧",
            "teclados" => "⌨️",
            "almacenamiento" => "💾",
            _ => "⚙️"
        };
    }

    var accessories =
        products
            .Where(IsAccessory)
            .OrderByDescending(p => p.CreatedAt)
            .Take(30)
            .ToList();
}

<style>

