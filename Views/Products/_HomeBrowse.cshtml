@model List<EcommerceApp.Models.Product>

@{
    var products =
        Model ?? new List<EcommerceApp.Models.Product>();


    int CountByCategory(params string[] terms)
    {
        return products.Count(
            product =>
            {
                var name =
                    (product.Name ?? string.Empty)
                    .ToLowerInvariant();

                var category =
                    (product.Category ?? string.Empty)
                    .ToLowerInvariant();

                var description =
                    (product.Description ?? string.Empty)
                    .ToLowerInvariant();

                var combined =
                    $"{name} {category} {description}";

                return terms.Any(
                    term =>
                        combined.Contains(
                            term.ToLowerInvariant()
                        )
                );
            }
        );
    }


    var videoGamesCount =
        products.Count(
            p =>
                (p.Category ?? string.Empty)
                .Contains(
                    "Videojuegos",
                    StringComparison.OrdinalIgnoreCase
                )
        );

    var consolesCount =
        products.Count(
            p =>
                (p.Category ?? string.Empty)
                .Contains(
                    "Consolas",
                    StringComparison.OrdinalIgnoreCase
                )
        );

    var accessoriesCount =
        products.Count(
            p =>
            {
                var category =
                    p.Category ?? string.Empty;

                return
                    category.Contains(
                        "Accesorios",
                        StringComparison.OrdinalIgnoreCase
                    )
                    ||
                    category.Contains(
                        "PC Gaming",
                        StringComparison.OrdinalIgnoreCase
                    );
            }
        );

    var tradingCardsCount =
        products.Count(
            p =>
                (p.Category ?? string.Empty)
                .Contains(
                    "Trading Cards",
                    StringComparison.OrdinalIgnoreCase
                )
        );

    var collectiblesCount =
        products.Count(
            p =>
                (p.Category ?? string.Empty)
                .Contains(
                    "Coleccionables",
                    StringComparison.OrdinalIgnoreCase
                )
        );

    var digitalCount =
        products.Count(
            p =>
                (p.Category ?? string.Empty)
                .Contains(
                    "Tienda digital",
                    StringComparison.OrdinalIgnoreCase
                )
        );

    var pcGamingCount =
        products.Count(
            p =>
                (p.Category ?? string.Empty)
                .Contains(
                    "PC Gaming",
                    StringComparison.OrdinalIgnoreCase
                )
        );

    var releasesCount =
        CountByCategory(
            "grand theft auto vi",
            "wolverine",
            "onimusha",
            "blood of dawnwalker",
            "star wars zero company",
            "final fantasy vii rebirth",
            "ocarina of time"
        );
}

