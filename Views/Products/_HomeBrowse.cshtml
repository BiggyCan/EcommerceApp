                </div>

            </a>


            <!-- PC GAMING -->

            <a asp-controller="Products"
               asp-action="Index"
               asp-route-search="PC Gaming"
               class="browse-card browse-pc">

                <div class="browse-card-content">

                    <div class="browse-card-icon">
                        💻
                    </div>

                    <h3 class="browse-card-title">
                        PC Gaming
                    </h3>

                    <p class="browse-card-description">
                        Periféricos, almacenamiento
                        y productos para tu escritorio gaming.
                    </p>

                    <div class="browse-card-footer">

                        <span class="browse-card-count">

                            <span class="browse-card-count-number">
                                @pcGamingCount
                            </span>

                            productos

                        </span>

                        <span class="browse-card-arrow">
                            →
                        </span>

                    </div>

                </div>

            </a>


            <!-- NUEVOS Y PRÓXIMOS -->

            <a href="#nuevos-proximos"
               class="browse-card browse-releases">

                <div class="browse-card-content">

                    <div class="browse-card-icon">
                        🔥
                    </div>

                    <h3 class="browse-card-title">
                        Nuevos y próximos
                    </h3>

                    <p class="browse-card-description">
                        Revisa novedades y títulos destacados
                        que tenemos en el radar.
                    </p>

                    <div class="browse-card-footer">

                        <span class="browse-card-count">

                            <span class="browse-card-count-number">
                                @releasesCount
                            </span>

                            destacados

                        </span>

                        <span class="browse-card-arrow">
                            ↑
                        </span>

                    </div>

                </div>

            </a>

        </div>


        <!-- =====================================================
             CTA FINAL
        ====================================================== -->

        <div class="browse-final">

            <div class="browse-final-left">

                <div class="browse-final-icon">
                    🎮
                </div>

                <div>

                    <h3 class="browse-final-title">
                        ¿No encontraste lo que buscabas?
                    </h3>

                    <p class="browse-final-text">
                        Explora todo el catálogo de BigGame
                        o utiliza el buscador superior para encontrar
                        productos por nombre, plataforma o categoría.
                    </p>

                </div>

            </div>


            <a asp-controller="Products"
               asp-action="Index"
               class="browse-final-button">

                Explorar catálogo completo

            </a>

        </div>

    </div>

</section>