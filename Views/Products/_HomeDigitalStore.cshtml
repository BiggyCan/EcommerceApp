</section>


<script>

    (function () {

        const row =
            document.getElementById(
                "digitalProducts"
            );

        const previousButton =
            document.getElementById(
                "digitalPrevious"
            );

        const nextButton =
            document.getElementById(
                "digitalNext"
            );

        const tabs =
            Array.from(
                document.querySelectorAll(
                    ".digital-tab"
                )
            );

        const emptyMessage =
            document.getElementById(
                "digitalFilterEmpty"
            );


        if (!row) {
            return;
        }


        /* =====================================================
           FLECHA IZQUIERDA
        ====================================================== */

        if (previousButton) {

            previousButton.addEventListener(
                "click",
                function () {

                    row.scrollBy({
                        left: -650,
                        behavior: "smooth"
                    });

                }
            );

        }


        /* =====================================================
           FLECHA DERECHA
        ====================================================== */

        if (nextButton) {

            nextButton.addEventListener(
                "click",
                function () {

                    row.scrollBy({
                        left: 650,
                        behavior: "smooth"
                    });

                }
            );

        }


        /* =====================================================
           FILTROS
        ====================================================== */

        tabs.forEach(
            function (tab) {

                tab.addEventListener(
                    "click",
                    function () {

                        tabs.forEach(
                            function (item) {

                                item.classList.remove(
                                    "active"
                                );

                            }
                        );


                        tab.classList.add(
                            "active"
                        );


                        const filter =
                            tab.dataset.digitalFilter
                            || "todos";


                        const cards =
                            Array.from(
                                row.querySelectorAll(
                                    ".digital-card"
                                )
                            );


                        let visibleCount = 0;


                        cards.forEach(
                            function (card) {

                                const platform =
                                    card.dataset.digitalPlatform
                                    || "";


                                const visible =
                                    filter === "todos"
                                    ||
                                    platform === filter;


                                card.style.display =
                                    visible
                                    ? "flex"
                                    : "none";


                                if (visible) {
                                    visibleCount++;
                                }

                            }
                        );


                        if (emptyMessage) {

                            emptyMessage.style.display =
                                visibleCount === 0
                                ? "block"
                                : "none";

                        }


                        row.scrollTo({
                            left: 0,
                            behavior: "smooth"
                        });

                    }
                );

            }
        );

    })();

</script>