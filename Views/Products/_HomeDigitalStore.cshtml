            padding: 17px;
        }

        .digital-arrow {
            width: 38px;
            height: 54px;

            font-size: 26px;
        }
    }

</style>


<section class="digital-home"
         id="tienda-digital">

    <div class="digital-container">


        <!-- =====================================================
             CABECERA
        ====================================================== -->

        <div class="digital-heading">

            <div class="digital-heading-left">

                <div class="digital-kicker">
                    TIENDA DIGITAL
                </div>

                <h2 class="digital-title">
                    Saldo para seguir jugando
                </h2>

                <p class="digital-subtitle">
                    Tarjetas para PlayStation Store,
                    Xbox y Nintendo eShop.
                </p>

            </div>


            <a asp-controller="Products"
               asp-action="Index"
               asp-route-search="Gift Card"
               class="digital-view-all">

                Ver todas →

            </a>

        </div>


        <!-- =====================================================
             BANNER
        ====================================================== -->

        <div class="digital-banner">

            <div class="digital-banner-content">

                <div class="digital-banner-left">

                    <div class="digital-banner-label">
                        BIGGAME DIGITAL
                    </div>

                    <h3 class="digital-banner-title">
                        El siguiente juego está a un código de distancia
                    </h3>

                    <p class="digital-banner-description">
                        Encuentra tarjetas digitales para tus
                        plataformas favoritas y agrega saldo
                        a tu cuenta para juegos, contenido
                        descargable y más.
                    </p>

                </div>


                <div class="digital-banner-cards">

                    <div class="digital-mini-card digital-mini-card-one">

                        <span class="digital-mini-icon">
                            🎮
                        </span>

                        <span class="digital-mini-text">
                            PlayStation
                        </span>

                    </div>


                    <div class="digital-mini-card digital-mini-card-two">

                        <span class="digital-mini-icon">
                            🟢
                        </span>

                        <span class="digital-mini-text">
                            Xbox
                        </span>

                    </div>


                    <div class="digital-mini-card digital-mini-card-three">

                        <span class="digital-mini-icon">
                            🔴
                        </span>

                        <span class="digital-mini-text">
                            Nintendo
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             FILTROS
        ====================================================== -->

        <div class="digital-tabs"
             id="digitalTabs">

            <button type="button"
                    class="digital-tab active"
                    data-digital-filter="todos">

                Todas

            </button>


            <button type="button"
                    class="digital-tab"
                    data-digital-filter="playstation">

                PlayStation Store

            </button>


            <button type="button"
                    class="digital-tab"
                    data-digital-filter="xbox">

                Xbox

            </button>


            <button type="button"
                    class="digital-tab"
                    data-digital-filter="nintendo">

                Nintendo eShop

            </button>

        </div>


        <!-- =====================================================
             PRODUCTOS
        ====================================================== -->

        @if (digitalProducts.Any())
        {
            <div class="digital-carousel">

                <button type="button"
                        class="digital-arrow digital-arrow-left"
                        id="digitalPrevious"
                        aria-label="Tarjetas anteriores">

                    ‹

                </button>


                <div class="digital-products"
                     id="digitalProducts">

                    @foreach (var product in digitalProducts)
                    {
                        var platform =
                            DigitalPlatform(product);

                        var platformLabel =
                            DigitalPlatformLabel(product);

                        var icon =
                            DigitalIcon(product);


                        <article class="digital-card"
                                 data-digital-platform="@platform">


                            <!-- IMAGEN -->

                            <div class="digital-image">

                                <span class="digital-platform-badge">
                                    @platformLabel
                                </span>


                                <span class="digital-delivery-badge">
                                    Digital
                                </span>


                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.Name"
                                         loading="lazy"
                                         onerror="
                                            this.style.display='none';
                                            this.nextElementSibling.style.display='flex';
                                         " />

                                    <div class="digital-placeholder"
                                         style="display:none;">
                                        @icon
                                    </div>
                                }
                                else
                                {
                                    <div class="digital-placeholder">
                                        @icon
                                    </div>
                                }

                            </div>


                            <!-- INFORMACIÓN -->

                            <div class="digital-info">

                                <div class="digital-category">
                                    @platformLabel
                                </div>


                                <div class="digital-name">
                                    @product.Name
                                </div>


                                <div class="digital-price">
                                    Bs @product.Price.ToString("N2")
                                </div>


                                @if (product.Stock > 0)
                                {
                                    <div class="digital-stock">
                                        @product.Stock disponibles
                                    </div>
                                }
                                else
                                {
                                    <div class="digital-stock out">
                                        Agotado
                                    </div>
                                }


                                <div class="digital-actions">

                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="digital-details">

                                        Ver producto

                                    </a>


                                    @if (product.Stock > 0)
                                    {
                                        <form asp-controller="Cart"
                                              asp-action="Add"
                                              method="post"
                                              class="digital-cart-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@product.Id" />

                                            <button type="submit"
                                                    class="digital-cart"
                                                    title="Agregar al carrito"
                                                    aria-label="Agregar @product.Name al carrito">

                                                🛒

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="digital-cart"
                                                disabled
                                                title="Producto agotado">

                                            🛒

                                        </button>
                                    }

                                </div>

                            </div>

                        </article>
                    }

                </div>


                <button type="button"
                        class="digital-arrow digital-arrow-right"
                        id="digitalNext"
                        aria-label="Más tarjetas">

                    ›

