@model List<EcommerceApp.Models.Product>

@{
    var products =
        Model ?? new List<EcommerceApp.Models.Product>();

    bool IsDigitalProduct(EcommerceApp.Models.Product product)
    {
        var name =
            (product.Name ?? string.Empty)
            .ToLowerInvariant();

        var category =
            (product.Category ?? string.Empty)
            .ToLowerInvariant();

        return
            category.Contains("tienda digital")
            || category.Contains("digital")
            || name.Contains("gift card")
            || name.Contains("eshop")
            || name.Contains("store card");
    }

    string DigitalPlatform(EcommerceApp.Models.Product product)
    {
        var name =
            (product.Name ?? string.Empty)
            .ToLowerInvariant();

        if (
            name.Contains("playstation")
            || name.Contains("psn")
        )
        {
            return "playstation";
        }

        if (
            name.Contains("xbox")
            || name.Contains("microsoft")
        )
        {
            return "xbox";
        }

        if (
            name.Contains("nintendo")
            || name.Contains("eshop")
        )
        {
            return "nintendo";
        }

        return "otros";
    }

    string DigitalPlatformLabel(
        EcommerceApp.Models.Product product)
    {
        return DigitalPlatform(product) switch
        {
            "playstation" => "PlayStation Store",
            "xbox" => "Xbox",
            "nintendo" => "Nintendo eShop",
            _ => "Tienda digital"
        };
    }

    string DigitalIcon(
        EcommerceApp.Models.Product product)
    {
        return DigitalPlatform(product) switch
        {
            "playstation" => "🎮",
            "xbox" => "🟢",
            "nintendo" => "🔴",
            _ => "🎁"
        };
    }

    var digitalProducts =
        products
            .Where(IsDigitalProduct)
            .OrderByDescending(p => p.CreatedAt)
            .Take(18)
            .ToList();
}

<style>

    /* =========================================================
       TIENDA DIGITAL BIGGAME
    ========================================================= */

    .digital-home {
        width: 100%;

        padding:
            60px
            0
            68px;

        background: #ffffff;

        color: #111827;
    }

