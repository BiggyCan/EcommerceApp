        }
        else
        {
            <div class="digital-empty">

                <div class="digital-empty-icon">
                    🎁
                </div>

                <strong>
                    Próximamente más productos digitales
                </strong>

                <span>
                    Estamos preparando nuevas opciones
                    para la tienda digital de BigGame.
                </span>

            </div>
        }


        <!-- =====================================================
             BENEFICIOS
        ====================================================== -->

        <div class="digital-benefits">

            <div class="digital-benefit">

                <div class="digital-benefit-icon">
                    🎁
                </div>

                <div>

                    <div class="digital-benefit-title">
                        Varias plataformas
                    </div>

                    <div class="digital-benefit-text">
                        Encuentra tarjetas para PlayStation,
                        Xbox y Nintendo.
                    </div>

                </div>

            </div>


            <div class="digital-benefit">

                <div class="digital-benefit-icon">
                    🔒
                </div>

                <div>

                    <div class="digital-benefit-title">
                        Compra desde BigGame
                    </div>

                    <div class="digital-benefit-text">
