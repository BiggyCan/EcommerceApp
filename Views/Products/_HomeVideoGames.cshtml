@model List<EcommerceApp.Models.Product>

@{
    var products =
        Model ?? new List<EcommerceApp.Models.Product>();

    bool IsVideoGame(EcommerceApp.Models.Product product)
    {
        var category =
            (product.Category ?? string.Empty)
            .ToLowerInvariant();

        return category.Contains("videojuego");
    }

    bool IsSportsGame(EcommerceApp.Models.Product product)
    {
        var name =
            (product.Name ?? string.Empty)
            .ToLowerInvariant();

        return
            name.Contains("nba")
            || name.Contains("2k27")
            || name.Contains("fifa")
            || name.Contains("fc 27")
            || name.Contains("fc27")
            || name.Contains("madden")
            || name.Contains("nhl")
            || name.Contains("mlb")
            || name.Contains("baseball")
            || name.Contains("football")
            || name.Contains("soccer");
    }

    string VideoGamePlatform(EcommerceApp.Models.Product product)
    {
        var name =
            (product.Name ?? string.Empty)
            .ToLowerInvariant();

        if (
            name.Contains("nintendo switch 2")
            || name.Contains("switch 2")
        )
        {
            return "switch2";
        }

        if (
            name.Contains("nintendo switch")
            || name.Contains("switch oled")
        )
        {
            return "switch";
        }

        if (
            name.Contains("playstation 5")
            || name.Contains("ps5")
        )
        {
            return "ps5";
        }

        if (
            name.Contains("xbox series")
            || name.Contains("xbox")
        )
        {
            return "xbox";
        }

        if (
            name.Contains(" - pc")
            || name.EndsWith("pc")
            || name.Contains(" pc ")
        )
        {
            return "pc";
        }

        return "otros";
    }

    string VideoGamePlatformLabel(
        EcommerceApp.Models.Product product)
    {
        return VideoGamePlatform(product) switch
        {
            "ps5" => "PlayStation 5",
            "xbox" => "Xbox Series X|S",
            "switch2" => "Nintendo Switch 2",
            "switch" => "Nintendo Switch",
            "pc" => "PC",
            _ => "Videojuegos"
        };
    }

    string PlatformIcon(
        EcommerceApp.Models.Product product)
    {
        return VideoGamePlatform(product) switch
        {
            "ps5" => "🎮",
            "xbox" => "🟢",
            "switch2" => "🔴",
            "switch" => "🕹️",
            "pc" => "💻",
            _ => "🎮"
        };
    }

    var videoGames =
        products
            .Where(IsVideoGame)
            .OrderByDescending(p => p.CreatedAt)
            .Take(30)
            .ToList();
}

<style>

    /* =========================================================
       VIDEOJUEGOS BIGGAME
    ========================================================= */

