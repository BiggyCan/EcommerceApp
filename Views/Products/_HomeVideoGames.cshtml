</style>


<section class="videogames-home"
         id="videojuegos">

    <div class="videogames-container">


        <!-- =====================================================
             CABECERA
        ====================================================== -->

        <div class="videogames-heading">

            <div class="videogames-heading-left">

                <div class="videogames-kicker">
                    VIDEOJUEGOS
                </div>

                <h2 class="videogames-title">
                    Lo que todos están jugando
                </h2>

                <p class="videogames-subtitle">
                    Explora videojuegos para PlayStation,
                    Xbox, Nintendo y PC.
                </p>

            </div>


            <a asp-controller="Products"
               asp-action="Index"
               asp-route-search="Videojuegos"
               class="videogames-view-all">

                Ver todos →

            </a>

        </div>


        <!-- =====================================================
             BANNER
        ====================================================== -->

        <div class="videogames-banner">

            <div class="videogames-banner-content">

                <div class="videogames-banner-left">

                    <div class="videogames-banner-label">
                        BIGGAME
                    </div>

                    <h3 class="videogames-banner-title">
                        Encuentra tu próxima aventura
                    </h3>

                    <p class="videogames-banner-description">
                        Acción, aventura, RPG, deportes y mucho más.
                        Descubre los videojuegos disponibles para
                        tus plataformas favoritas.
                    </p>

                </div>


                <div class="videogames-banner-visual">

                    <div class="videogames-ring videogames-ring-one">
                    </div>

                    <div class="videogames-ring videogames-ring-two">
                    </div>

                    <div class="videogames-controller">
                        🎮
                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             FILTROS
        ====================================================== -->

        <div class="videogames-tabs"
             id="videoGamesTabs">

            <button type="button"
                    class="videogames-tab active"
                    data-videogame-filter="todos">

                Todos

            </button>


            <button type="button"
                    class="videogames-tab"
                    data-videogame-filter="ps5">

                PlayStation 5

            </button>


            <button type="button"
                    class="videogames-tab"
                    data-videogame-filter="xbox">

                Xbox Series X|S

            </button>


            <button type="button"
                    class="videogames-tab"
                    data-videogame-filter="switch">

                Nintendo Switch

            </button>


            <button type="button"
                    class="videogames-tab"
                    data-videogame-filter="switch2">

                Nintendo Switch 2

            </button>


            <button type="button"
                    class="videogames-tab"
                    data-videogame-filter="pc">

                PC

            </button>


            <button type="button"
                    class="videogames-tab"
                    data-videogame-filter="deportes">

                Deportes

            </button>

        </div>


        <!-- =====================================================
             PRODUCTOS
        ====================================================== -->

        @if (videoGames.Any())
        {
            <div class="videogames-carousel">

                <button type="button"
                        class="videogames-arrow videogames-arrow-left"
                        id="videoGamesPrevious"
                        aria-label="Videojuegos anteriores">

                    ‹

                </button>


                <div class="videogames-products"
                     id="videoGamesProducts">

                    @foreach (var product in videoGames)
                    {
                        var platform =
                            VideoGamePlatform(product);

                        var platformLabel =
                            VideoGamePlatformLabel(product);

                        var icon =
                            PlatformIcon(product);

                        var isSports =
                            IsSportsGame(product);


                        <article class="videogames-card"
                                 data-videogame-platform="@platform"
                                 data-videogame-sports="@(isSports ? "true" : "false")">


                            <!-- IMAGEN -->

                            <div class="videogames-image">

                                <span class="videogames-platform-badge">
                                    @platformLabel
                                </span>


                                @if (isSports)
                                {
                                    <span class="videogames-sport-badge">
                                        Deporte
                                    </span>
                                }


                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl"
                                         alt="@product.Name"
                                         loading="lazy"
                                         onerror="
                                            this.style.display='none';
                                            this.nextElementSibling.style.display='flex';
                                         " />

                                    <div class="videogames-placeholder"
                                         style="display:none;">
                                        @icon
                                    </div>
                                }
                                else
                                {
                                    <div class="videogames-placeholder">
                                        @icon
                                    </div>
                                }

                            </div>


                            <!-- INFORMACIÓN -->

                            <div class="videogames-info">

                                <div class="videogames-category">
                                    @platformLabel
                                </div>


                                <div class="videogames-name">
                                    @product.Name
                                </div>


                                <div class="videogames-price">

                                    Bs @product.Price.ToString("N2")

                                </div>


                                @if (product.Stock > 0)
                                {
                                    <div class="videogames-stock">

                                        @product.Stock disponibles

                                    </div>
                                }
                                else
                                {
                                    <div class="videogames-stock out">

                                        Agotado

                                    </div>
                                }


                                <!-- BOTONES -->

                                <div class="videogames-actions">

                                    <a asp-controller="Products"
                                       asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="videogames-details">

                                        Ver producto

                                    </a>


                                    @if (product.Stock > 0)
                                    {
                                        <form asp-controller="Cart"
                                              asp-action="Add"
                                              method="post"
                                              class="videogames-cart-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@product.Id" />

                                            <button type="submit"
                                                    class="videogames-cart"
                                                    title="Agregar al carrito"
                                                    aria-label="Agregar @product.Name al carrito">

                                                🛒

                                            </button>

                                        </form>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="videogames-cart"
                                                disabled
                                                title="Producto agotado">

                                            🛒

                                        </button>
                                    }

                                </div>

                            </div>

                        </article>
                    }

                </div>


                <button type="button"
                        class="videogames-arrow videogames-arrow-right"
                        id="videoGamesNext"
                        aria-label="Más videojuegos">

                    ›

                </button>

            </div>


            <div class="videogames-filter-empty"
                 id="videoGamesFilterEmpty">

                <strong>
                    No hay videojuegos en esta categoría
                </strong>

                <span>
                    Prueba con otra plataforma.
                </span>

            </div>
        }
        else
        {
            <div class="videogames-empty">

                <div class="videogames-empty-icon">
                    🎮
                </div>

                <strong>
                    Próximamente más videojuegos
                </strong>

                <span>
                    Estamos preparando nuevos títulos para BigGame.
                </span>

            </div>
        }

    </div>

</section>


<script>

    (function () {

        const row =
            document.getElementById(
                "videoGamesProducts"
            );

        const previousButton =
            document.getElementById(
                "videoGamesPrevious"
            );

        const nextButton =
            document.getElementById(
                "videoGamesNext"
            );

        const tabs =
            Array.from(
                document.querySelectorAll(
                    ".videogames-tab"
                )
            );

        const emptyMessage =
            document.getElementById(
                "videoGamesFilterEmpty"
            );


        if (!row) {
            return;
        }


        /* =====================================================
           FLECHAS
        ====================================================== */

        if (previousButton) {

            previousButton.addEventListener(
                "click",
                function () {

                    row.scrollBy({
                        left: -735,
                        behavior: "smooth"
                    });

                }
            );

        }


        if (nextButton) {

            nextButton.addEventListener(
                "click",
                function () {

                    row.scrollBy({
                        left: 735,
                        behavior: "smooth"
                    });

                }
            );

        }


        /* =====================================================
           FILTROS
        ====================================================== */

        tabs.forEach(
            function (tab) {

                tab.addEventListener(
                    "click",
                    function () {

                        tabs.forEach(
                            function (item) {

                                item.classList.remove(
                                    "active"
                                );

                            }
                        );


                        tab.classList.add(
                            "active"
                        );


                        const filter =
                            tab.dataset.videogameFilter
                            || "todos";


                        const cards =
                            Array.from(
                                row.querySelectorAll(
                                    ".videogames-card"
                                )
                            );


                        let visibleCount = 0;


                        cards.forEach(
                            function (card) {

                                const platform =
                                    card.dataset.videogamePlatform
                                    || "";

                                const isSports =
                                    card.dataset.videogameSports
                                    === "true";


                                let visible = false;


                                if (filter === "todos")
                                {
                                    visible = true;
                                }
                                else if (filter === "deportes")
                                {
                                    visible = isSports;
                                }
                                else
                                {
                                    visible =
                                        platform === filter;
                                }


                                card.style.display =
                                    visible
                                    ? "flex"
                                    : "none";


                                if (visible) {
                                    visibleCount++;
                                }

                            }
                        );


                        if (emptyMessage) {

                            emptyMessage.style.display =
                                visibleCount === 0
                                ? "block"
                                : "none";

                        }


                        row.scrollTo({
                            left: 0,
                            behavior: "smooth"
                        });

                    }
                );

            }
        );

    })();

</script>