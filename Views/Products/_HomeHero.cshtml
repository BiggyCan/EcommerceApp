<script>
    (function () {

        const hero =
            document.getElementById(
                "bigGameHero"
            );

        if (!hero) {
            return;
        }


        const slides =
            Array.from(
                hero.querySelectorAll(
                    ".bg-hero-slide"
                )
            );


        const dots =
            Array.from(
                hero.querySelectorAll(
                    ".bg-hero-dot"
                )
            );


        const previousButton =
            document.getElementById(
                "bgHeroPrevious"
            );


        const nextButton =
            document.getElementById(
                "bgHeroNext"
            );


        let currentIndex = 0;

        let heroTimer = null;


        /* =====================================================
           MOSTRAR SLIDE
        ====================================================== */

        function showSlide(index) {

            if (slides.length === 0) {
                return;
            }


            if (index < 0) {
                index =
                    slides.length - 1;
            }


            if (index >= slides.length) {
                index = 0;
            }


            slides.forEach(
                function (slide) {

                    slide.classList.remove(
                        "active"
                    );
                }
            );


            dots.forEach(
                function (dot) {

                    dot.classList.remove(
                        "active"
                    );
                }
            );


            slides[index].classList.add(
                "active"
            );


            if (dots[index]) {

                dots[index].classList.add(
                    "active"
                );
            }


            currentIndex = index;
        }


        /* =====================================================
           SIGUIENTE
        ====================================================== */

        function nextSlide() {

            showSlide(
                currentIndex + 1
            );
        }


        /* =====================================================
           ANTERIOR
        ====================================================== */

        function previousSlide() {

            showSlide(
                currentIndex - 1
            );
        }


        /* =====================================================
           TIMER
        ====================================================== */

        function stopTimer() {

            if (heroTimer) {

                window.clearInterval(
                    heroTimer
                );

                heroTimer = null;
            }
        }


        function startTimer() {

            stopTimer();


            if (
                window.matchMedia(
                    "(prefers-reduced-motion: reduce)"
                ).matches
            ) {
                return;
            }


            heroTimer =
                window.setInterval(
                    nextSlide,
                    5500
                );
        }


        /* =====================================================
           FLECHAS
        ====================================================== */

        if (previousButton) {

            previousButton.addEventListener(
                "click",
                function () {

                    previousSlide();

                    startTimer();
                }
            );
        }


        if (nextButton) {

            nextButton.addEventListener(
                "click",
                function () {

                    nextSlide();

                    startTimer();
                }
            );
        }


        /* =====================================================
           INDICADORES
        ====================================================== */

        dots.forEach(
            function (dot) {

                dot.addEventListener(
                    "click",
                    function () {

                        const index =
                            Number(
                                dot.dataset.heroIndex
                            );


                        if (
                            Number.isNaN(index)
                        ) {
                            return;
                        }


                        showSlide(index);

                        startTimer();
                    }
                );
            }
        );


        /* =====================================================
           PAUSA CON MOUSE
        ====================================================== */

        hero.addEventListener(
            "mouseenter",
            stopTimer
        );


        hero.addEventListener(
            "mouseleave",
            startTimer
        );


        /* =====================================================
           INICIO
        ====================================================== */

        showSlide(0);

        startTimer();

    })();
</script>