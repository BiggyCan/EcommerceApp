<style>
    /* =========================================================
       BIGGAME HOME HERO
    ========================================================= */

    .bg-hero {
        width: 100%;

        background: #ffffff;

        padding:
            18px
            0
            28px;
    }

    .bg-hero-container {
        position: relative;

        width: calc(100% - 32px);
        max-width: 1500px;

        height: 430px;

        margin: 0 auto;

        overflow: hidden;

        border-radius: 10px;

        background: #111111;
    }


    /* =========================================================
       SLIDES
    ========================================================= */

    .bg-hero-slide {
        position: absolute;

        inset: 0;

        display: flex;

        align-items: center;

        opacity: 0;

        visibility: hidden;

        transform: scale(1.015);

        transition:
            opacity 0.55s ease,
            transform 0.75s ease,
            visibility 0.55s ease;
    }

    .bg-hero-slide.active {
        opacity: 1;

        visibility: visible;

        transform: scale(1);
    }


    /* =========================================================
       SLIDE 1 - BIGGAME
    ========================================================= */

    .bg-hero-slide-biggame {
        background:
            linear-gradient(
                90deg,
                rgba(3, 7, 20, 0.96) 0%,
                rgba(5, 12, 35, 0.89) 42%,
                rgba(4, 10, 30, 0.42) 70%,
                rgba(4, 10, 30, 0.32) 100%
            ),
            url('/images/login-bg.png');

        background-size: cover;

        background-position:
            center 46%;
    }


    /* =========================================================
       SLIDE 2 - PLAYSTATION
    ========================================================= */

    .bg-hero-slide-playstation {
        background:
            radial-gradient(
                circle at 78% 50%,
                rgba(65, 145, 255, 0.82),
                transparent 28%
            ),
            linear-gradient(
                115deg,
                #061c53 0%,
                #073e9f 48%,
                #0378ea 100%
            );
    }


    /* =========================================================
       SLIDE 3 - NINTENDO
    ========================================================= */

    .bg-hero-slide-nintendo {
        background:
            radial-gradient(
                circle at 76% 40%,
                rgba(255, 255, 255, 0.22),
                transparent 28%
            ),
            linear-gradient(
                115deg,
                #8d0000 0%,
                #d10000 45%,
                #ff2020 100%
            );
    }


    /* =========================================================
       SLIDE 4 - XBOX
    ========================================================= */

    .bg-hero-slide-xbox {
        background:
            radial-gradient(
                circle at 77% 48%,
                rgba(155, 255, 110, 0.26),
                transparent 27%
            ),
            linear-gradient(
                115deg,
                #05250d 0%,
                #08751d 50%,
                #13a530 100%
            );
    }


    /* =========================================================
       DECORACIÓN
    ========================================================= */

    .bg-hero-decoration {
        position: absolute;

        right: 6%;

        top: 50%;

        transform:
            translateY(-50%);

        width: 430px;
        height: 300px;

        pointer-events: none;
    }

    .bg-hero-circle {
        position: absolute;

        border-radius: 50%;

        border:
            2px solid rgba(255, 255, 255, 0.20);
    }

    .bg-hero-circle-one {
        width: 280px;
        height: 280px;

        right: 30px;
        top: 10px;
    }

    .bg-hero-circle-two {
        width: 190px;
        height: 190px;

        right: 75px;
        top: 55px;
    }

    .bg-hero-circle-three {
        width: 100px;
        height: 100px;

        right: 120px;
        top: 100px;

        background:
            rgba(255, 255, 255, 0.08);
    }

    .bg-hero-controller {
        position: absolute;

        right: 103px;
        top: 87px;

        width: 138px;
        height: 110px;

        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 92px;

        filter:
            drop-shadow(
                0 14px 20px
                rgba(0, 0, 0, 0.28)
            );
    }


    /* =========================================================
       CONTENIDO
    ========================================================= */

    .bg-hero-content {
        position: relative;

        z-index: 4;

        width: 57%;

        padding-left: 74px;
    }

    .bg-hero-eyebrow {
        display: inline-flex;

        align-items: center;

        min-height: 28px;

        margin-bottom: 16px;

        padding:
            6px
            11px;

        border-radius: 4px;

        background:
            rgba(0, 0, 0, 0.30);

        color: #ffffff;

        font-size: 11px;
        font-weight: 900;

        letter-spacing: 1.1px;

        text-transform: uppercase;
    }

    .bg-hero-title {
        max-width: 690px;

        margin:
            0
            0
            15px;

        color: #ffffff;

        font-size: clamp(
            42px,
            5vw,
            72px
        );

        line-height: 0.97;

        font-weight: 900;

        letter-spacing: -2.3px;

        text-shadow:
            0 4px 22px
            rgba(0, 0, 0, 0.28);
    }

    .bg-hero-title-accent {
        color: #31b5ff;
    }

    .bg-hero-description {
        max-width: 590px;

        margin:
            0
            0
            25px;

        color:
            rgba(255, 255, 255, 0.88);

        font-size: 16px;

        line-height: 1.55;
    }


    /* =========================================================
       BOTONES
    ========================================================= */

    .bg-hero-actions {
        display: flex;

        flex-wrap: wrap;

        align-items: center;

        gap: 12px;
    }

    .bg-hero-button {
        min-height: 48px;

        display: inline-flex;

        align-items: center;
        justify-content: center;

        padding:
            0
            24px;

        border-radius: 5px;

        text-decoration: none;

        font-size: 13px;

        font-weight: 900;

        transition:
            transform 0.18s ease,
            background 0.18s ease,
            color 0.18s ease,
            border-color 0.18s ease;
    }

    .bg-hero-button:hover {
        transform:
            translateY(-2px);
    }

    .bg-hero-button-primary {
        border:
            2px solid #ffffff;

        background: #ffffff;

        color: #111111;
    }

    .bg-hero-button-primary:hover {
        background: #eeeeee;

        color: #111111;
    }

    .bg-hero-button-secondary {
        border:
            2px solid rgba(255, 255, 255, 0.78);

        background:
            rgba(0, 0, 0, 0.16);

        color: #ffffff;
    }

    .bg-hero-button-secondary:hover {
        background: #ffffff;

        color: #111111;
    }


    /* =========================================================
       FLECHAS
    ========================================================= */

    .bg-hero-arrow {
        position: absolute;

        z-index: 15;

        top: 50%;

        transform:
            translateY(-50%);

        width: 48px;
        height: 68px;

        display: flex;

        align-items: center;
        justify-content: center;

        border: none;

        background:
            rgba(0, 0, 0, 0.34);

        color: #ffffff;

        cursor: pointer;

        font-size: 36px;

        transition:
            background 0.2s ease;
    }

    .bg-hero-arrow:hover {
        background:
            rgba(0, 0, 0, 0.65);
    }

    .bg-hero-arrow-left {
        left: 0;

        border-radius:
            0 5px 5px 0;
    }

    .bg-hero-arrow-right {
        right: 0;

        border-radius:
            5px 0 0 5px;
    }


    /* =========================================================
       INDICADORES
    ========================================================= */

    .bg-hero-dots {
        position: absolute;

        z-index: 16;

        left: 50%;
        bottom: 18px;

        transform:
            translateX(-50%);

        display: flex;

        align-items: center;

        gap: 8px;
    }

    .bg-hero-dot {
        width: 34px;
        height: 5px;

        padding: 0;

        border: none;
        border-radius: 10px;

        background:
            rgba(255, 255, 255, 0.38);

        cursor: pointer;

        transition:
            width 0.2s ease,
            background 0.2s ease;
    }

    .bg-hero-dot.active {
        width: 50px;

        background: #ffffff;
    }


    /* =========================================================
       BADGE DE PLATAFORMA
    ========================================================= */

    .bg-hero-platform {
        position: absolute;

        z-index: 5;

        right: 7%;
        bottom: 35px;

        color:
            rgba(255, 255, 255, 0.17);

        font-size: 54px;

        font-weight: 900;

        letter-spacing: -2px;

        text-transform: uppercase;

        pointer-events: none;
    }


    /* =========================================================
       RESPONSIVE
    ========================================================= */

    @@media (max-width: 1050px) {

        .bg-hero-container {
            height: 390px;
        }

        .bg-hero-content {
            width: 66%;

            padding-left: 62px;
        }

        .bg-hero-decoration {
            right: 2%;

            transform:
                translateY(-50%)
                scale(0.85);
        }

        .bg-hero-platform {
            font-size: 40px;
        }
    }


    @@media (max-width: 780px) {

        .bg-hero {
            padding-top: 12px;
        }

        .bg-hero-container {
            width: calc(100% - 20px);

            height: 430px;
        }

        .bg-hero-slide {
            align-items: flex-end;
        }

        .bg-hero-content {
            width: 100%;

            padding:
                40px
                52px
                62px;
        }

        .bg-hero-title {
            font-size: 44px;

            max-width: 520px;
        }

        .bg-hero-description {
            max-width: 500px;
        }

        .bg-hero-decoration {
            top: 15%;
            right: 0;

            transform:
                scale(0.56);

            transform-origin:
                top right;

            opacity: 0.70;
        }

        .bg-hero-platform {
            display: none;
        }

        .bg-hero-arrow {
            width: 40px;
            height: 58px;

            font-size: 30px;
        }
    }


    @@media (max-width: 540px) {

        .bg-hero-container {
            width: calc(100% - 14px);

            min-height: 450px;

            border-radius: 7px;
        }

        .bg-hero-content {
            padding:
                38px
                38px
                62px;
        }

        .bg-hero-title {
            font-size: 38px;

            letter-spacing: -1.2px;
        }

        .bg-hero-description {
            font-size: 14px;
        }

        .bg-hero-actions {
            flex-direction: column;

            align-items: stretch;

            max-width: 260px;
        }

        .bg-hero-button {
            width: 100%;
        }

        .bg-hero-decoration {
            opacity: 0.45;
        }

        .bg-hero-dot {
            width: 22px;
        }

        .bg-hero-dot.active {
            width: 35px;
        }
    }
</style>


