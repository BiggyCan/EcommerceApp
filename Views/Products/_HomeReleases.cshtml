@model List<EcommerceApp.Models.Product>

@{
    var products =
        Model ?? new List<EcommerceApp.Models.Product>();

    bool IsReleaseProduct(EcommerceApp.Models.Product product)
    {
        var name =
            (product.Name ?? string.Empty)
            .ToLowerInvariant();

        var category =
            (product.Category ?? string.Empty)
            .ToLowerInvariant();

        if (!category.Contains("videojuego"))
        {
            return false;
        }

        return
            name.Contains("grand theft auto vi")
            || name.Contains("gta vi")
            || name.Contains("wolverine")
            || name.Contains("onimusha")
            || name.Contains("blood of dawnwalker")
            || name.Contains("star wars zero company")
            || name.Contains("final fantasy vii rebirth")
            || name.Contains("zelda")
            || name.Contains("ocarina of time");
    }

    string ReleasePlatform(EcommerceApp.Models.Product product)
    {
        var name =
            (product.Name ?? string.Empty)
            .ToLowerInvariant();

        if (
            name.Contains("playstation 5")
            || name.Contains("ps5")
        )
        {
            return "playstation";
        }

        if (
            name.Contains("xbox")
            || name.Contains("series x")
            || name.Contains("series s")
        )
        {
            return "xbox";
        }

        if (
            name.Contains("nintendo")
            || name.Contains("switch")
        )
        {
            return "nintendo";
        }

        if (
            name.Contains(" - pc")
            || name.EndsWith("pc")
            || name.Contains(" pc ")
        )
        {
            return "pc";
        }

        return "otros";
    }

    string ReleasePlatformLabel(
        EcommerceApp.Models.Product product)
    {
        return ReleasePlatform(product) switch
        {
            "playstation" => "PlayStation 5",
            "xbox" => "Xbox Series X|S",
            "nintendo" => "Nintendo",
            "pc" => "PC",
            _ => "Videojuegos"
        };
    }

    string ReleaseGenre(
        EcommerceApp.Models.Product product)
    {
        var name =
            (product.Name ?? string.Empty)
            .ToLowerInvariant();

        if (
            name.Contains("final fantasy")
            || name.Contains("dawnwalker")
        )
        {
            return "rpg";
        }

        if (
            name.Contains("star wars zero company")
        )
        {
            return "estrategia";
        }

        if (
            name.Contains("zelda")
            || name.Contains("ocarina")
        )
        {
            return "aventura";
        }

        return "accion";
    }

    string ReleaseGenreLabel(
        EcommerceApp.Models.Product product)
    {
        return ReleaseGenre(product) switch
        {
            "rpg" => "RPG",
            "estrategia" => "Estrategia",
            "aventura" => "Aventura",
            _ => "Acción"
        };
    }

    string ReleaseIcon(
        EcommerceApp.Models.Product product)
    {
        return ReleaseGenre(product) switch
        {
            "rpg" => "⚔️",
            "estrategia" => "🧠",
            "aventura" => "🗺️",
            _ => "🔥"
        };
    }

    var releaseProducts =
        products
            .Where(IsReleaseProduct)
            .OrderByDescending(p => p.CreatedAt)
            .Take(18)
            .ToList();

    var mainRelease =
        releaseProducts.FirstOrDefault(
            p =>
                (p.Name ?? string.Empty)
                .Contains(
                    "Grand Theft Auto VI",
                    StringComparison.OrdinalIgnoreCase
                )
        )
        ??
        releaseProducts.FirstOrDefault();
}

