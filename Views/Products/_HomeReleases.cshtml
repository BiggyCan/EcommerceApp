<section class="releases-home"
         id="nuevos-proximos">

    <div class="releases-container">


        <!-- =====================================================
             CABECERA
        ====================================================== -->

        <div class="releases-heading">

            <div class="releases-heading-left">

                <div class="releases-kicker">
                    NUEVOS Y PRÓXIMOS
                </div>

                <h2 class="releases-title">
                    Juegos para tener en el radar
                </h2>

                <p class="releases-subtitle">
                    Explora novedades y títulos destacados
                    disponibles en el catálogo de BigGame.
                </p>

            </div>


            <a asp-controller="Products"
               asp-action="Index"
               asp-route-search="Videojuegos"
               class="releases-view-all">

                Explorar videojuegos →

            </a>

        </div>


        <!-- =====================================================
             DESTACADO
        ====================================================== -->

        @if (mainRelease != null)
        {
            <div class="releases-feature">

                <div class="releases-feature-content">

                    <div class="releases-feature-info">

                        <div class="releases-feature-label">
                            DESTACADO BIGGAME
                        </div>

                        <h3 class="releases-feature-title">
                            @mainRelease.Name
                        </h3>

                        <p class="releases-feature-description">
                            @if (!string.IsNullOrWhiteSpace(mainRelease.Description))
                            {
                                @mainRelease.Description
                            }
                            else
                            {
                                @:Descubre uno de los títulos destacados disponibles en BigGame.
                            }
                        </p>


                        <div class="releases-feature-actions">

                            <a asp-controller="Products"
                               asp-action="Details"
                               asp-route-id="@mainRelease.Id"
                               class="releases-feature-button">

                                Ver producto

                            </a>


                            <a href="#catalogo-lanzamientos"
                               class="releases-feature-button releases-feature-button-secondary">

                                Ver más títulos

                            </a>

                        </div>

                    </div>


                    <div class="releases-feature-visual">

                        <div class="releases-feature-glow">
                        </div>


                        @if (!string.IsNullOrWhiteSpace(mainRelease.ImageUrl))
                        {
                            <img src="@mainRelease.ImageUrl"
                                 alt="@mainRelease.Name"
                                 class="releases-feature-image"
                                 loading="lazy"
                                 onerror="
                                    this.style.display='none';
                                    this.nextElementSibling.style.display='flex';
                                 " />

                            <div class="releases-feature-placeholder"
                                 style="display:none;">

                                🔥

                            </div>
                        }
                        else
                        {
                            <div class="releases-feature-placeholder">
                                🔥
                            </div>
                        }

                    </div>

                </div>

            </div>
        }


        <!-- =====================================================
             FILTROS
        ====================================================== -->

        <div class="releases-tabs"
             id="releasesTabs">

            <button type="button"
                    class="releases-tab active"
                    data-release-filter="todos">

                Todos

            </button>


            <button type="button"
                    class="releases-tab"
                    data-release-filter="playstation">

                PlayStation 5

            </button>


            <button type="button"
                    class="releases-tab"
                    data-release-filter="xbox">

                Xbox

            </button>


            <button type="button"
                    class="releases-tab"
                    data-release-filter="nintendo">

                Nintendo

            </button>


            <button type="button"
                    class="releases-tab"
                    data-release-filter="pc">

                PC

            </button>


            <button type="button"
                    class="releases-tab"
                    data-release-filter="accion">

                Acción

            </button>


            <button type="button"
                    class="releases-tab"
                    data-release-filter="rpg">

                RPG

            </button>

        </div>


        <!-- =====================================================
             PRODUCTOS
        ====================================================== -->

        <div id="catalogo-lanzamientos">

            @if (releaseProducts.Any())
            {
                <div class="releases-carousel">

                    <button type="button"
                            class="releases-arrow releases-arrow-left"
                            id="releasesPrevious"
                            aria-label="Productos anteriores">

                        ‹

                    </button>


                    <div class="releases-products"
                         id="releasesProducts">

                        @foreach (var product in releaseProducts)
                        {
                            var platform =
                                ReleasePlatform(product);

                            var platformLabel =
                                ReleasePlatformLabel(product);

                            var genre =
                                ReleaseGenre(product);

                            var genreLabel =
                                ReleaseGenreLabel(product);

                            var icon =
                                ReleaseIcon(product);


                            <article class="release-card"
                                     data-release-platform="@platform"
                                     data-release-genre="@genre">


                                <!-- IMAGEN -->

                                <div class="release-image">

                                    <span class="release-platform-badge">
                                        @platformLabel
                                    </span>


                                    <span class="release-new-badge">
                                        Destacado
                                    </span>


                                    @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                    {
                                        <img src="@product.ImageUrl"
                                             alt="@product.Name"
                                             loading="lazy"
                                             onerror="
                                                this.style.display='none';
                                                this.nextElementSibling.style.display='flex';
                                             " />

                                        <div class="release-placeholder"
                                             style="display:none;">

                                            @icon

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="release-placeholder">
                                            @icon
                                        </div>
                                    }

                                </div>


                                <!-- INFORMACIÓN -->

                                <div class="release-info">

                                    <div class="release-genre">
                                        @genreLabel
                                    </div>


                                    <div class="release-name">
                                        @product.Name
                                    </div>


                                    <div class="release-price">
                                        Bs @product.Price.ToString("N2")
                                    </div>


                                    @if (product.Stock > 0)
                                    {
                                        <div class="release-stock">

                                            @product.Stock disponibles

                                        </div>
                                    }
                                    else
                                    {
                                        <div class="release-stock out">
                                            Agotado
                                        </div>
                                    }


                                    <!-- ACCIONES -->

                                    <div class="release-actions">

                                        <a asp-controller="Products"
                                           asp-action="Details"
                                           asp-route-id="@product.Id"
                                           class="release-details">

                                            Ver producto

                                        </a>


                                        @if (product.Stock > 0)
                                        {
                                            <form asp-controller="Cart"
                                                  asp-action="Add"
                                                  method="post"
                                                  class="release-cart-form">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@product.Id" />

                                                <button type="submit"
                                                        class="release-cart"
                                                        title="Agregar al carrito"
                                                        aria-label="Agregar @product.Name al carrito">

                                                    🛒

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="release-cart"
                                                    disabled
                                                    title="Producto agotado">

                                                🛒

                                            </button>
                                        }

                                    </div>

                                </div>

                            </article>
                        }

                    </div>


                    <button type="button"
                            class="releases-arrow releases-arrow-right"
                            id="releasesNext"
                            aria-label="Más productos">

                        ›

                    </button>

                </div>


                <div class="releases-filter-empty"
                     id="releasesFilterEmpty">

                    <strong>
                        No hay títulos en esta categoría
                    </strong>

                    <span>
                        Prueba con otra plataforma o género.
                    </span>

                </div>
            }
            else
            {
                <div class="releases-empty">

                    <div class="releases-empty-icon">
                        🔥
                    </div>

                    <strong>
                        Próximamente más novedades
                    </strong>

                    <span>
                        Estamos preparando nuevos títulos para BigGame.
                    </span>

                </div>
            }

        </div>

    </div>

</section>


<script>

    (function () {

        const row =
            document.getElementById(
                "releasesProducts"
            );

        const previousButton =
            document.getElementById(
                "releasesPrevious"
            );

        const nextButton =
            document.getElementById(
                "releasesNext"
            );

        const tabs =
            Array.from(
                document.querySelectorAll(
                    ".releases-tab"
                )
            );

        const emptyMessage =
            document.getElementById(
                "releasesFilterEmpty"
            );


        if (!row) {
            return;
        }


        /* =====================================================
           FLECHA IZQUIERDA
        ====================================================== */

        if (previousButton) {

            previousButton.addEventListener(
                "click",
                function () {

                    row.scrollBy({
                        left: -735,
                        behavior: "smooth"
                    });

                }
            );

        }


        /* =====================================================
           FLECHA DERECHA
        ====================================================== */

        if (nextButton) {

            nextButton.addEventListener(
                "click",
                function () {

                    row.scrollBy({
                        left: 735,
                        behavior: "smooth"
                    });

                }
            );

        }


        /* =====================================================
           FILTROS
        ====================================================== */

        tabs.forEach(
            function (tab) {

                tab.addEventListener(
                    "click",
                    function () {

                        tabs.forEach(
                            function (item) {

                                item.classList.remove(
                                    "active"
                                );

                            }
                        );


                        tab.classList.add(
                            "active"
                        );


                        const filter =
                            tab.dataset.releaseFilter
                            || "todos";


                        const cards =
                            Array.from(
                                row.querySelectorAll(
                                    ".release-card"
                                )
                            );


                        let visibleCount =
                            0;


                        cards.forEach(
                            function (card) {

                                const platform =
                                    card.dataset.releasePlatform
                                    || "";

                                const genre =
                                    card.dataset.releaseGenre
                                    || "";


                                let visible =
                                    false;


                                if (filter === "todos")
                                {
                                    visible =
                                        true;
                                }
                                else if (
                                    filter === "playstation"
                                    || filter === "xbox"
                                    || filter === "nintendo"
                                    || filter === "pc"
                                )
                                {
                                    visible =
                                        platform === filter;
                                }
                                else
                                {
                                    visible =
                                        genre === filter;
                                }


                                card.style.display =
                                    visible
                                    ? "flex"
                                    : "none";


                                if (visible) {
                                    visibleCount++;
                                }

                            }
                        );


                        if (emptyMessage) {

                            emptyMessage.style.display =
                                visibleCount === 0
                                ? "block"
                                : "none";

                        }


                        row.scrollTo({
                            left: 0,
                            behavior: "smooth"
                        });

                    }
                );

            }
        );

    })();

</script>