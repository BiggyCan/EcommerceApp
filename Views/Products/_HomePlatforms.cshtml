                               class="platform-button">

                                Comprar Nintendo

                            </a>


                            @if (nintendoProduct != null)
                            {
                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@nintendoProduct.Id"
                                   class="platform-button platform-button-secondary">

                                    Ver consola

                                </a>
                            }

                        </div>

                    </div>


                    <div class="platform-product">

                        <div class="platform-product-glow">
                        </div>

                        @if (
                            nintendoProduct != null
                            &&
                            !string.IsNullOrWhiteSpace(
                                nintendoProduct.ImageUrl
                            )
                        )
                        {
                            <img src="@nintendoProduct.ImageUrl"
                                 alt="@nintendoProduct.Name"
                                 class="platform-product-image"
                                 loading="lazy"
                                 onerror="
                                    this.style.display='none';
                                    this.nextElementSibling.style.display='flex';
                                 " />

                            <div class="platform-product-placeholder"
                                 style="display:none;">
                                🔴
                            </div>
                        }
                        else
                        {
                            <div class="platform-product-placeholder">
                                🔴
                            </div>
                        }

                    </div>

                </div>


                @if (nintendoProduct != null)
                {
                    <div class="platform-featured">
                        Destacado:
                        @nintendoProduct.Name
                    </div>
                }

            </article>


            <!-- =================================================
                 PC GAMING
            ================================================== -->

            <article class="platform-card platform-pc">

                <div class="platform-content">

                    <div class="platform-info">

                        <div class="platform-brand">
                            BIGGAME PC
                        </div>

                        <h3 class="platform-name">
                            PC Gaming
                        </h3>

                        <p class="platform-description">
                            Teclados, auriculares, almacenamiento
                            y videojuegos para llevar tu escritorio
                            gaming a otro nivel.
                        </p>

                        <div class="platform-count">

                            <span class="platform-count-number">
                                @pcCount
                            </span>

                            productos relacionados

                        </div>


                        <div class="platform-buttons">

                            <a asp-controller="Products"
                               asp-action="Index"
                               asp-route-search="Gaming"
                               class="platform-button">

                                Comprar PC Gaming

                            </a>


                            @if (pcProduct != null)
                            {
                                <a asp-controller="Products"
                                   asp-action="Details"
                                   asp-route-id="@pcProduct.Id"
                                   class="platform-button platform-button-secondary">

                                    Ver destacado

                                </a>
                            }

                        </div>

                    </div>


                    <div class="platform-product">

                        <div class="platform-product-glow">
                        </div>

                        @if (
                            pcProduct != null
                            &&
                            !string.IsNullOrWhiteSpace(
                                pcProduct.ImageUrl
                            )
                        )
                        {
                            <img src="@pcProduct.ImageUrl"
                                 alt="@pcProduct.Name"
                                 class="platform-product-image"
                                 loading="lazy"
                                 onerror="
                                    this.style.display='none';
                                    this.nextElementSibling.style.display='flex';
                                 " />

                            <div class="platform-product-placeholder"
                                 style="display:none;">
                                💻
                            </div>
                        }
                        else
                        {
                            <div class="platform-product-placeholder">
                                💻
                            </div>
                        }

                    </div>

                </div>


                @if (pcProduct != null)
                {
                    <div class="platform-featured">
                        Destacado:
                        @pcProduct.Name
                    </div>
                }

            </article>

        </div>


        <!-- =====================================================
             BARRA INFERIOR
        ====================================================== -->

        <div class="platforms-bottom">

            <div class="platforms-bottom-left">

                <div class="platforms-bottom-icon">
                    🎮
                </div>

                <div>

                    <h3 class="platforms-bottom-title">
                        ¿Todavía no sabes qué plataforma elegir?
                    </h3>

                    <p class="platforms-bottom-text">
                        Explora el catálogo completo y compara
                        consolas, juegos y accesorios disponibles
                        en BigGame.
                    </p>

                </div>

            </div>


            <a asp-controller="Products"
               asp-action="Index"
               class="platforms-bottom-button">

                Ver catálogo completo

            </a>

        </div>

    </div>

</section>