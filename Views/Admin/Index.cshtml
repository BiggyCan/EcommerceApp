@model List<EcommerceApp.Models.Product>

@{
    ViewData["Title"] = "Panel de Administración";

    var products =
        Model ?? new List<EcommerceApp.Models.Product>();

    var totalProducts =
        ViewBag.TotalProducts != null
            ? Convert.ToInt32(ViewBag.TotalProducts)
            : 0;

    var totalUsers =
        ViewBag.TotalUsers != null
            ? Convert.ToInt32(ViewBag.TotalUsers)
            : 0;

    var lowStock =
        ViewBag.LowStock != null
            ? Convert.ToInt32(ViewBag.LowStock)
            : 0;

    var outOfStock =
        ViewBag.OutOfStock != null
            ? Convert.ToInt32(ViewBag.OutOfStock)
            : 0;

    var totalStock =
        ViewBag.TotalStock != null
            ? Convert.ToInt32(ViewBag.TotalStock)
            : 0;

    var inventoryValue =
        ViewBag.InventoryValue != null
            ? Convert.ToDecimal(ViewBag.InventoryValue)
            : 0m;
}

<style>

    .admin-page {
        min-height: 760px;
        padding: 38px 0 75px;
        background: #f4f6f9;
    }

    .admin-container {
        width: calc(100% - 40px);
        max-width: 1050px;
        margin: auto;
    }

    .admin-top {
        display: flex;
        justify-content: space-between;
        align-items: center;

        gap: 20px;

        margin-bottom: 28px;
    }

    .admin-badge {
        width: fit-content;

        margin-bottom: 10px;
        padding: 7px 12px;

        border-radius: 20px;

        background:
            linear-gradient(
                135deg,
                #6d28d9,
                #4f46e5
            );

        color: white;

        font-size: 9px;
        font-weight: 900;

        text-transform: uppercase;
    }

    .admin-title {
        margin: 0;

        color: #111827;

        font-size: 31px;
        font-weight: 900;
    }

    .admin-subtitle {
        margin: 5px 0 0;

        color: #64748b;

        font-size: 12px;
    }

    .admin-top-actions {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
    }

    .admin-top-button {
        min-height: 42px;

        padding: 0 16px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        border-radius: 6px;

        color: white;

        text-decoration: none;

        font-size: 10px;
        font-weight: 900;

        transition: .2s;
    }

    .admin-top-button.store {
        background: #111827;
    }

    .admin-top-button.product {
        background:
            linear-gradient(
                135deg,
                #06bfff,
                #2563eb
            );
    }

    .admin-top-button:hover {
        color: white;
        transform: translateY(-1px);
        filter: brightness(1.08);
    }


    /* ESTADÍSTICAS */

    .admin-stats {
        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap: 15px;

        margin-bottom: 16px;
    }

    .stat-card {
        min-height: 135px;

        padding: 20px;

        position: relative;

        overflow: hidden;

        background: white;

        border: 1px solid #e2e8f0;
        border-radius: 11px;

        box-shadow:
            0 5px 16px rgba(15,23,42,.05);
    }

    .stat-label {
        margin-bottom: 18px;

        color: #64748b;

        font-size: 9px;
        font-weight: 900;

        text-transform: uppercase;
    }

    .stat-number {
        color: #111827;

        font-size: 27px;
        font-weight: 900;
    }

    .stat-number.green {
        color: #15803d;
    }

    .stat-number.orange {
        color: #d97706;
    }

    .stat-number.red {
        color: #dc2626;
    }

    .stat-description {
        margin-top: 5px;

        color: #94a3b8;

        font-size: 9px;
    }

    .stat-icon {
        position: absolute;

        top: 18px;
        right: 18px;

        width: 38px;
        height: 38px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 9px;

        background: #eef2ff;

        font-size: 18px;
    }


    /* ÁREA PRINCIPAL */

    .admin-content-grid {
        display: grid;

        grid-template-columns:
            1fr
            1fr;

        gap: 17px;

        margin-top: 24px;
    }

    .admin-panel-card {
        overflow: hidden;

        background: white;

        border: 1px solid #e2e8f0;
        border-radius: 12px;

        box-shadow:
            0 6px 18px rgba(15,23,42,.05);
    }

    .panel-header {
        padding: 18px 20px;

        border-bottom: 1px solid #e2e8f0;
    }

    .panel-header h2 {
        margin: 0;

        color: #111827;

        font-size: 18px;
        font-weight: 900;
    }

    .panel-header p {
        margin: 4px 0 0;

        color: #64748b;

        font-size: 9px;
    }

    .management-list {
        padding: 12px;
    }

    .management-link {
        min-height: 65px;

        margin-bottom: 8px;
        padding: 11px 13px;

        display: flex;
        align-items: center;

        gap: 12px;

        border: 1px solid #e2e8f0;
        border-radius: 8px;

        background: white;

        color: #111827;

        text-decoration: none;

        transition: .2s;
    }

    .management-link:last-child {
        margin-bottom: 0;
    }

    .management-link:hover {
        color: #111827;

        border-color: #93c5fd;

        background: #f8fafc;

        transform: translateX(2px);
    }

    .management-icon {
        width: 38px;
        height: 38px;

        flex: 0 0 38px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 9px;

        background: #eef2ff;

        font-size: 18px;
    }

    .management-info {
        flex: 1;
    }

    .management-title {
        margin-bottom: 3px;

        color: #111827;

        font-size: 11px;
        font-weight: 900;
    }

    .management-description {
        color: #64748b;

        font-size: 9px;
    }

    .management-arrow {
        color: #94a3b8;

        font-size: 15px;
        font-weight: 900;
    }

    .management-link.sales {
        border-color: #bfdbfe;

        background:
            linear-gradient(
                90deg,
                #eff6ff,
                #ffffff
            );
    }

    .management-link.sales .management-icon {
        background:
            linear-gradient(
                135deg,
                #2563eb,
                #4f46e5
            );

        color: white;
    }


    /* INVENTARIO */

    .inventory-content {
        padding: 17px;
    }

    .inventory-main {
        margin-bottom: 12px;
        padding: 20px;

        border-radius: 9px;

        background:
            linear-gradient(
                135deg,
                #111827,
                #1e3a8a,
                #312e81
            );

        color: white;
    }

    .inventory-label {
        margin-bottom: 7px;

        color: #67e8f9;

        font-size: 9px;
        font-weight: 900;

        text-transform: uppercase;
    }

    .inventory-value {
        font-size: 27px;
        font-weight: 900;
    }

    .inventory-description {
        margin-top: 5px;

        color: #dbeafe;

        font-size: 9px;
    }

    .inventory-mini-grid {
        display: grid;

        grid-template-columns:
            repeat(2, 1fr);

        gap: 10px;
    }

    .inventory-mini {
        padding: 14px;

        border: 1px solid #e2e8f0;
        border-radius: 8px;

        background: #f8fafc;
    }

    .inventory-mini-number {
        color: #111827;

        font-size: 19px;
        font-weight: 900;
    }

    .inventory-mini-label {
        margin-top: 3px;

        color: #64748b;

        font-size: 8px;
        font-weight: 800;

        text-transform: uppercase;
    }


    /* PRODUCTOS RECIENTES */

    .recent-products {
        margin-top: 18px;

        overflow: hidden;

        background: white;

        border: 1px solid #e2e8f0;
        border-radius: 12px;

        box-shadow:
            0 6px 18px rgba(15,23,42,.05);
    }

    .recent-header {
        padding: 18px 20px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        border-bottom: 1px solid #e2e8f0;
    }

    .recent-header h2 {
        margin: 0;

        color: #111827;

        font-size: 17px;
        font-weight: 900;
    }

    .recent-header p {
        margin: 4px 0 0;

        color: #64748b;

        font-size: 9px;
    }

    .view-products-link {
        color: #2563eb;

        font-size: 9px;
        font-weight: 900;

        text-decoration: none;
    }

    .recent-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .recent-table {
        width: 100%;
        min-width: 750px;

        border-collapse: collapse;
    }

    .recent-table thead {
        background: #f8fafc;
    }

    .recent-table th {
        padding: 11px 14px;

        color: #64748b;

        font-size: 8px;
        font-weight: 900;

        text-align: left;

        text-transform: uppercase;

        border-bottom: 1px solid #e2e8f0;
    }

    .recent-table td {
        padding: 13px 14px;

        color: #334155;

        font-size: 10px;

        border-bottom: 1px solid #eef2f7;

        vertical-align: middle;
    }

    .recent-table tbody tr:last-child td {
        border-bottom: none;
    }

    .recent-product {
        display: flex;
        align-items: center;

        gap: 10px;
    }

    .recent-image {
        width: 45px;
        height: 45px;

        flex: 0 0 45px;

        overflow: hidden;

        border: 1px solid #e2e8f0;
        border-radius: 6px;

        background: #f8fafc;
    }

    .recent-image img {
        width: 100%;
        height: 100%;

        object-fit: cover;
    }

    .recent-name {
        color: #111827;

        font-size: 10px;
        font-weight: 900;
    }

    .recent-category {
        margin-top: 2px;

        color: #64748b;

        font-size: 8px;
    }

    .stock-good {
        color: #15803d;

        font-weight: 900;
    }

    .stock-low {
        color: #d97706;

        font-weight: 900;
    }

    .stock-out {
        color: #dc2626;

        font-weight: 900;
    }

    .recent-action {
        margin-right: 4px;
        padding: 6px 8px;

        display: inline-flex;

        border-radius: 4px;

        color: white;

        text-decoration: none;

        font-size: 8px;
        font-weight: 900;
    }

    .recent-action.view {
        background: #2563eb;
    }

    .recent-action.edit {
        background: #d97706;
    }

    .recent-action:hover {
        color: white;
        filter: brightness(1.08);
    }


    /* SIN PRODUCTOS */

    .no-products {
        padding: 35px 20px;

        color: #64748b;

        text-align: center;

        font-size: 11px;
    }


    /* RESPONSIVE */

    @@media (max-width: 850px) {

        .admin-stats {
            grid-template-columns:
                repeat(2, 1fr);
        }

        .admin-content-grid {
            grid-template-columns: 1fr;
        }

    }

    @@media (max-width: 650px) {

        .admin-container {
            width: calc(100% - 24px);
        }

        .admin-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .admin-stats {
            grid-template-columns: 1fr;
        }

        .inventory-mini-grid {
            grid-template-columns: 1fr;
        }

    }

</style>


<div class="admin-page">

    <div class="admin-container">


        <div class="admin-top">


            <div>


                <div class="admin-badge">

                    ⚙ ADMINISTRADOR

                </div>


                <h1 class="admin-title">

                    Panel de Administración

                </h1>


                <p class="admin-subtitle">

                    Gestiona la tienda, los productos,
                    el inventario, los usuarios y las ventas de BigGame.

                </p>


            </div>



            <div class="admin-top-actions">


                <a asp-controller="Products"
                   asp-action="Index"
                   class="admin-top-button store">

                    🎮 Ver tienda

                </a>


                <a asp-controller="Products"
                   asp-action="Create"
                   class="admin-top-button product">

                    + Nuevo producto

                </a>


            </div>


        </div>



        <div class="admin-stats">


            <div class="stat-card">

                <div class="stat-icon">
                    🎮
                </div>

                <div class="stat-label">
                    Productos
                </div>

                <div class="stat-number">
                    @totalProducts
                </div>

                <div class="stat-description">
                    Productos registrados
                </div>

            </div>



            <div class="stat-card">

                <div class="stat-icon">
                    👥
                </div>

                <div class="stat-label">
                    Usuarios
                </div>

                <div class="stat-number">
                    @totalUsers
                </div>

                <div class="stat-description">
                    Cuentas registradas
                </div>

            </div>



            <div class="stat-card">

                <div class="stat-icon">
                    📦
                </div>

                <div class="stat-label">
                    Unidades
                </div>

                <div class="stat-number green">
                    @totalStock
                </div>

                <div class="stat-description">
                    Unidades disponibles
                </div>

            </div>


        </div>



        <div class="admin-stats">


            <div class="stat-card">

                <div class="stat-icon">
                    ⚠️
                </div>

                <div class="stat-label">
                    Stock bajo
                </div>

                <div class="stat-number orange">
                    @lowStock
                </div>

                <div class="stat-description">
                    Productos con 5 unidades o menos
                </div>

            </div>



            <div class="stat-card">

                <div class="stat-icon">
                    ❌
                </div>

                <div class="stat-label">
                    Agotados
                </div>

                <div class="stat-number red">
                    @outOfStock
                </div>

                <div class="stat-description">
                    Productos sin existencias
                </div>

            </div>



            <div class="stat-card">

                <div class="stat-icon">
                    💰
                </div>

                <div class="stat-label">
                    Valor inventario
                </div>

                <div class="stat-number green">

                    Bs @inventoryValue.ToString("N2")

                </div>

                <div class="stat-description">
                    Precio × unidades disponibles
                </div>

            </div>


        </div>



        <div class="admin-content-grid">


            <section class="admin-panel-card">


                <div class="panel-header">

                    <h2>
                        Gestión de BigGame
                    </h2>

                    <p>
                        Accesos rápidos de administración
                    </p>

                </div>



                <div class="management-list">


                    <a asp-controller="Admin"
                       asp-action="Products"
                       class="management-link">

                        <div class="management-icon">
                            🎮
                        </div>

                        <div class="management-info">

                            <div class="management-title">
                                Administrar productos
                            </div>

                            <div class="management-description">
                                Consultar y modificar el catálogo
                            </div>

                        </div>

                        <span class="management-arrow">
                            ›
                        </span>

                    </a>



                    <a asp-controller="Products"
                       asp-action="Create"
                       class="management-link">

                        <div class="management-icon">
                            ➕
                        </div>

                        <div class="management-info">

                            <div class="management-title">
                                Agregar producto
                            </div>

                            <div class="management-description">
                                Registrar juegos, consolas o accesorios
                            </div>

                        </div>

                        <span class="management-arrow">
                            ›
                        </span>

                    </a>



                    <a asp-controller="Admin"
                       asp-action="Users"
                       class="management-link">

                        <div class="management-icon">
                            👥
                        </div>

                        <div class="management-info">

                            <div class="management-title">
                                Administrar usuarios
                            </div>

                            <div class="management-description">
                                Consultar cuentas y administrar roles
                            </div>

                        </div>

                        <span class="management-arrow">
                            ›
                        </span>

                    </a>



                    <a asp-controller="Orders"
                       asp-action="Index"
                       class="management-link sales">

                        <div class="management-icon">
                            📊
                        </div>

                        <div class="management-info">

                            <div class="management-title">
                                Administrar ventas
                            </div>

                            <div class="management-description">
                                Consultar pedidos, clientes e ingresos
                            </div>

                        </div>

                        <span class="management-arrow">
                            ›
                        </span>

                    </a>
                    <a asp-controller="Reports"
                       asp-action="Index"
                       class="management-link">

                        <div class="management-icon">
                            &#128202;
                        </div>

                        <div class="management-info">

                            <div class="management-title">
                                Centro de reportes
                            </div>

                            <div class="management-description">
                                Consultar y descargar reportes PDF
                            </div>

                        </div>

                        <span class="management-arrow">
                            &rsaquo;
                        </span>

                    </a>


                </div>


            </section>



            <section class="admin-panel-card">


                <div class="panel-header">

                    <h2>
                        Inventario
                    </h2>

                    <p>
                        Resumen general de existencias
                    </p>

                </div>



                <div class="inventory-content">


                    <div class="inventory-main">

                        <div class="inventory-label">
                            Valor actual
                        </div>

                        <div class="inventory-value">

                            Bs @inventoryValue.ToString("N2")

                        </div>

                        <div class="inventory-description">

                            Valor estimado de todos los productos disponibles.

                        </div>

                    </div>



                    <div class="inventory-mini-grid">


                        <div class="inventory-mini">

                            <div class="inventory-mini-number">

                                @totalStock

                            </div>

                            <div class="inventory-mini-label">

                                Unidades

                            </div>

                        </div>



                        <div class="inventory-mini">

                            <div class="inventory-mini-number">

                                @totalProducts

                            </div>

                            <div class="inventory-mini-label">

                                Productos

                            </div>

                        </div>



                        <div class="inventory-mini">

                            <div class="inventory-mini-number">

                                @lowStock

                            </div>

                            <div class="inventory-mini-label">

                                Stock bajo

                            </div>

                        </div>



                        <div class="inventory-mini">

                            <div class="inventory-mini-number">

                                @outOfStock

                            </div>

                            <div class="inventory-mini-label">

                                Agotados

                            </div>

                        </div>


                    </div>


                </div>


            </section>


        </div>



        <section class="recent-products">


            <div class="recent-header">


                <div>

                    <h2>
                        Productos recientes
                    </h2>

                    <p>
                        Últimos productos registrados en BigGame
                    </p>

                </div>


                <a asp-controller="Admin"
                   asp-action="Products"
                   class="view-products-link">

                    Ver todos →

                </a>


            </div>



            @if (products.Any())
            {

                <div class="recent-table-wrapper">


                    <table class="recent-table">


                        <thead>

                            <tr>

                                <th>
                                    Producto
                                </th>

                                <th>
                                    Precio
                                </th>

                                <th>
                                    Stock
                                </th>

                                <th>
                                    Acciones
                                </th>

                            </tr>

                        </thead>



                        <tbody>


                            @foreach (var product in products.Take(5))
                            {

                                <tr>


                                    <td>


                                        <div class="recent-product">


                                            <div class="recent-image">

                                                <img
                                                    src="@(string.IsNullOrWhiteSpace(product.ImageUrl)
                                                        ? "/images/login-bg.png"
                                                        : product.ImageUrl)"
                                                    alt="@product.Name"
                                                    onerror="this.onerror=null;this.src='/images/login-bg.png';" />

                                            </div>


                                            <div>

                                                <div class="recent-name">

                                                    @product.Name

                                                </div>

                                                <div class="recent-category">

                                                    @(string.IsNullOrWhiteSpace(product.Category)
                                                        ? "Sin categoría"
                                                        : product.Category)

                                                </div>

                                            </div>


                                        </div>


                                    </td>



                                    <td>

                                        <strong>

                                            Bs @product.Price.ToString("N2")

                                        </strong>

                                    </td>



                                    <td>


                                        @if (product.Stock == 0)
                                        {

                                            <span class="stock-out">

                                                Agotado

                                            </span>

                                        }
                                        else if (product.Stock <= 5)
                                        {

                                            <span class="stock-low">

                                                @product.Stock disponibles

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="stock-good">

                                                @product.Stock disponibles

                                            </span>

                                        }


                                    </td>



                                    <td>


                                        <a asp-controller="Products"
                                           asp-action="Details"
                                           asp-route-id="@product.Id"
                                           class="recent-action view">

                                            Ver

                                        </a>


                                        <a asp-controller="Products"
                                           asp-action="Edit"
                                           asp-route-id="@product.Id"
                                           class="recent-action edit">

                                            Editar

                                        </a>


                                    </td>


                                </tr>

                            }


                        </tbody>


                    </table>


                </div>

            }
            else
            {

                <div class="no-products">

                    Todavía no hay productos registrados.

                </div>

            }


        </section>


    </div>

</div>