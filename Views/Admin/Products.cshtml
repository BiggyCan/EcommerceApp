@model List<EcommerceApp.Models.Product>

@{
    ViewData["Title"] = "Administrar Productos";

    var categories =
        ViewBag.Categories as List<string>
        ?? new List<string>();

    string? currentSearch =
        ViewBag.Search as string;

    string? currentCategory =
        ViewBag.Category as string;
}

<style>

    .products-admin-page {
        min-height: 100vh;
        background: #f3f5f8;
        padding: 35px 0 70px;
    }

    .products-admin-container {
        width: calc(100% - 40px);
        max-width: 1280px;
        margin: auto;
    }

    .products-admin-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
    }

    .products-admin-title h1 {
        margin: 0;
        font-size: 32px;
        font-weight: 900;
        color: #111827;
    }

    .products-admin-title p {
        margin: 6px 0 0;
        color: #64748b;
        font-size: 14px;
    }

    .products-admin-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;

        padding: 7px 12px;
        margin-bottom: 10px;

        border-radius: 20px;

        background:
            linear-gradient(
                135deg,
                #7c3aed,
                #2563eb
            );

        color: white;

        font-size: 10px;
        font-weight: 800;
    }

    .header-buttons {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .admin-button {
        min-height: 42px;

        padding: 0 17px;

        border-radius: 6px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        gap: 6px;

        text-decoration: none;

        font-size: 12px;
        font-weight: 800;

        transition: .2s;
    }

    .admin-button.dark {
        background: #111827;
        color: white;
    }

    .admin-button.primary {
        background:
            linear-gradient(
                135deg,
                #06bfff,
                #2563eb
            );

        color: white;
    }

    .admin-button:hover {
        color: white;
        transform: translateY(-2px);
        filter: brightness(1.08);
    }


    /* =========================================
       RESUMEN
    ========================================= */

    .products-summary {
        display: grid;
        grid-template-columns:
            repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .summary-card {
        background: white;

        border: 1px solid #e2e8f0;
        border-radius: 11px;

        padding: 20px;

        box-shadow:
            0 5px 16px rgba(15,23,42,.05);
    }

    .summary-label {
        color: #64748b;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .summary-value {
        margin-top: 8px;

        color: #111827;

        font-size: 26px;
        font-weight: 900;
    }

    .summary-green .summary-value {
        color: #15803d;
    }

    .summary-orange .summary-value {
        color: #d97706;
    }

    .summary-red .summary-value {
        color: #dc2626;
    }


    /* =========================================
       FILTROS
    ========================================= */

    .filters-panel {
        background: white;

        border: 1px solid #e2e8f0;
        border-radius: 11px;

        padding: 18px;

        margin-bottom: 22px;

        box-shadow:
            0 5px 16px rgba(15,23,42,.05);
    }

    .filters-form {
        display: grid;

        grid-template-columns:
            1fr 220px auto auto;

        gap: 10px;

        align-items: end;
    }

    .filter-group label {
        display: block;

        margin-bottom: 6px;

        color: #475569;

        font-size: 10px;
        font-weight: 800;

        text-transform: uppercase;
    }

    .filter-input,
    .filter-select {
        width: 100%;
        height: 40px;

        border: 1px solid #cbd5e1;
        border-radius: 6px;

        padding: 0 12px;

        background: white;
        color: #111827;

        outline: none;

        font-size: 12px;
    }

    .filter-input:focus,
    .filter-select:focus {
        border-color: #2563eb;

        box-shadow:
            0 0 0 3px rgba(37,99,235,.08);
    }

    .filter-button {
        height: 40px;

        padding: 0 18px;

        border: none;
        border-radius: 6px;

        background: #2563eb;
        color: white;

        font-size: 11px;
        font-weight: 800;

        cursor: pointer;
    }

    .clear-button {
        height: 40px;

        padding: 0 16px;

        border-radius: 6px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        background: #f1f5f9;
        color: #334155;

        text-decoration: none;

        font-size: 11px;
        font-weight: 800;
    }

    .clear-button:hover {
        color: #111827;
        background: #e2e8f0;
    }


    /* =========================================
       TABLA
    ========================================= */

    .products-panel {
        background: white;

        border: 1px solid #e2e8f0;
        border-radius: 12px;

        overflow: hidden;

        box-shadow:
            0 5px 18px rgba(15,23,42,.06);
    }

    .panel-header {
        padding: 20px 22px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        gap: 20px;

        border-bottom: 1px solid #e5e7eb;
    }

    .panel-header h2 {
        margin: 0;

        color: #111827;

        font-size: 19px;
        font-weight: 900;
    }

    .panel-header p {
        margin: 4px 0 0;

        color: #64748b;

        font-size: 11px;
    }

    .product-count {
        padding: 7px 11px;

        border-radius: 20px;

        background: #dbeafe;
        color: #1d4ed8;

        font-size: 10px;
        font-weight: 800;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    .products-table {
        width: 100%;

        border-collapse: collapse;

        min-width: 1050px;
    }

    .products-table th {
        padding: 13px 15px;

        background: #f8fafc;

        color: #64748b;

        text-align: left;

        font-size: 10px;
        font-weight: 800;

        text-transform: uppercase;

        border-bottom: 1px solid #e5e7eb;
    }

    .products-table td {
        padding: 14px 15px;

        vertical-align: middle;

        border-bottom: 1px solid #eef2f7;

        font-size: 12px;
    }

    .products-table tbody tr:hover {
        background: #fbfdff;
    }

    .products-table tbody tr:last-child td {
        border-bottom: none;
    }


    /* =========================================
       PRODUCTO
    ========================================= */

    .product-info {
        display: flex;
        align-items: center;

        gap: 12px;

        min-width: 250px;
    }

    .product-admin-image {
        width: 62px;
        height: 62px;

        flex: 0 0 62px;

        border-radius: 8px;

        overflow: hidden;

        background: #f1f5f9;

        border: 1px solid #e2e8f0;
    }

    .product-admin-image img {
        width: 100%;
        height: 100%;

        object-fit: contain;
    }

    .product-admin-name {
        color: #111827;

        font-size: 13px;
        font-weight: 800;
    }

    .product-admin-description {
        display: block;

        margin-top: 3px;

        max-width: 280px;

        color: #64748b;

        font-size: 10px;

        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }


    /* =========================================
       CATEGORÍA
    ========================================= */

    .category-badge {
        display: inline-block;

        padding: 5px 8px;

        border-radius: 20px;

        background: #e0e7ff;
        color: #3730a3;

        font-size: 9px;
        font-weight: 800;
    }


    /* =========================================
       PRECIO
    ========================================= */

    .price-text {
        color: #111827;

        font-size: 13px;
        font-weight: 900;
    }


    /* =========================================
       STOCK
    ========================================= */

    .stock-badge {
        display: inline-block;

        padding: 5px 8px;

        border-radius: 20px;

        font-size: 9px;
        font-weight: 800;
    }

    .stock-good {
        background: #dcfce7;
        color: #15803d;
    }

    .stock-low {
        background: #fef3c7;
        color: #b45309;
    }

    .stock-out {
        background: #fee2e2;
        color: #dc2626;
    }


    /* =========================================
       FECHA
    ========================================= */

    .product-date {
        color: #64748b;
        font-size: 10px;
    }


    /* =========================================
       ACCIONES
    ========================================= */

    .product-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .product-action {
        min-height: 31px;

        padding: 0 9px;

        border-radius: 5px;

        display: inline-flex;
        align-items: center;
        justify-content: center;

        color: white;

        text-decoration: none;

        font-size: 9px;
        font-weight: 800;

        transition: .2s;
    }

    .product-action.view {
        background: #2563eb;
    }

    .product-action.edit {
        background: #d97706;
    }

    .product-action.delete {
        background: #dc2626;
    }

    .product-action:hover {
        color: white;

        transform: translateY(-1px);

        filter: brightness(1.08);
    }


    /* =========================================
       VACÍO
    ========================================= */

    .empty-products {
        padding: 60px 20px;

        text-align: center;

        color: #64748b;
    }

    .empty-products-icon {
        font-size: 55px;
        margin-bottom: 12px;
    }

    .empty-products strong {
        display: block;

        margin-bottom: 5px;

        color: #111827;

        font-size: 16px;
    }


    /* =========================================
       RESPONSIVE
    ========================================= */

    @@media (max-width: 950px) {

        .products-summary {
            grid-template-columns:
                repeat(2, 1fr);
        }

        .filters-form {
            grid-template-columns:
                1fr 1fr;
        }

    }

    @@media (max-width: 650px) {

        .products-admin-container {
            width: calc(100% - 24px);
        }

        .products-admin-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .products-admin-title h1 {
            font-size: 27px;
        }

        .products-summary {
            grid-template-columns: 1fr;
        }

        .filters-form {
            grid-template-columns: 1fr;
        }

    }

</style>


@{
    var totalProducts = Model?.Count ?? 0;

    var totalStock =
        Model?.Sum(p => p.Stock)
        ?? 0;

    var lowStock =
        Model?.Count(p =>
            p.Stock > 0 &&
            p.Stock <= 5)
        ?? 0;

    var outOfStock =
        Model?.Count(p =>
            p.Stock == 0)
        ?? 0;
}


<div class="products-admin-page">

    <div class="products-admin-container">


        <!-- CABECERA -->

        <div class="products-admin-header">


            <div class="products-admin-title">

                <div class="products-admin-badge">
                    🎮 GESTIÓN DE PRODUCTOS
                </div>

                <h1>
                    Productos de BigGame
                </h1>

                <p>
                    Administra el catálogo, precios,
                    stock e información de los productos.
                </p>

            </div>


            <div class="header-buttons">


                <a asp-controller="Admin"
                   asp-action="Index"
                   class="admin-button dark">

                    ← Volver al panel

                </a>


                <a asp-controller="Products"
                   asp-action="Create"
                   class="admin-button primary">

                    ＋ Nuevo producto

                </a>


            </div>


        </div>



        <!-- RESUMEN -->

        <div class="products-summary">


            <div class="summary-card">

                <div class="summary-label">
                    Productos
                </div>

                <div class="summary-value">
                    @totalProducts
                </div>

            </div>


            <div class="summary-card summary-green">

                <div class="summary-label">
                    Unidades
                </div>

                <div class="summary-value">
                    @totalStock
                </div>

            </div>


            <div class="summary-card summary-orange">

                <div class="summary-label">
                    Stock bajo
                </div>

                <div class="summary-value">
                    @lowStock
                </div>

            </div>


            <div class="summary-card summary-red">

                <div class="summary-label">
                    Agotados
                </div>

                <div class="summary-value">
                    @outOfStock
                </div>

            </div>


        </div>



        <!-- FILTROS -->

        <div class="filters-panel">


            <form asp-controller="Admin"
                  asp-action="Products"
                  method="get"
                  class="filters-form">


                <div class="filter-group">

                    <label>
                        Buscar producto
                    </label>

                    <input type="text"
                           name="search"
                           value="@currentSearch"
                           placeholder="Nombre o descripción..."
                           class="filter-input" />

                </div>


                <div class="filter-group">

                    <label>
                        Categoría
                    </label>

                    <select name="category"
                            class="filter-select">

                        <option value="">
                            Todas
                        </option>


                        @foreach (var category in categories)
                        {

                            if (category == currentCategory)
                            {

                                <option value="@category"
                                        selected>

                                    @category

                                </option>

                            }
                            else
                            {

                                <option value="@category">

                                    @category

                                </option>

                            }

                        }


                    </select>

                </div>


                <button type="submit"
                        class="filter-button">

                    🔍 Buscar

                </button>


                <a asp-controller="Admin"
                   asp-action="Products"
                   class="clear-button">

                    Limpiar

                </a>


            </form>


        </div>



        <!-- TABLA -->

        <div class="products-panel">


            <div class="panel-header">


                <div>

                    <h2>
                        Catálogo registrado
                    </h2>

                    <p>
                        Productos almacenados en la base de datos
                    </p>

                </div>


                <span class="product-count">

                    @totalProducts productos

                </span>


            </div>



            @if (Model != null && Model.Count > 0)
            {

                <div class="table-wrapper">


                    <table class="products-table">


                        <thead>

                            <tr>

                                <th>
                                    Producto
                                </th>

                                <th>
                                    Categoría
                                </th>

                                <th>
                                    Precio
                                </th>

                                <th>
                                    Stock
                                </th>

                                <th>
                                    Registro
                                </th>

                                <th>
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            @foreach (var product in Model)
                            {

                                <tr>


                                    <!-- PRODUCTO -->

                                    <td>

                                        <div class="product-info">


                                            <div class="product-admin-image">

                                                <img
                                                    src="@(string.IsNullOrWhiteSpace(product.ImageUrl)
                                                        ? "/images/login-bg.png"
                                                        : product.ImageUrl)"
                                                    alt="@product.Name"
                                                    onerror="this.onerror=null;this.src='/images/login-bg.png';" />

                                            </div>


                                            <div>


                                                <div class="product-admin-name">

                                                    @product.Name

                                                </div>


                                                <span class="product-admin-description">

                                                    @product.Description

                                                </span>


                                            </div>


                                        </div>

                                    </td>



                                    <!-- CATEGORIA -->

                                    <td>

                                        <span class="category-badge">

                                            @(string.IsNullOrWhiteSpace(product.Category)
                                                ? "Sin categoría"
                                                : product.Category)

                                        </span>

                                    </td>



                                    <!-- PRECIO -->

                                    <td>

                                        <span class="price-text">

                                            Bs @product.Price.ToString("N2")

                                        </span>

                                    </td>



                                    <!-- STOCK -->

                                    <td>


                                        @if (product.Stock == 0)
                                        {

                                            <span class="stock-badge stock-out">

                                                Agotado

                                            </span>

                                        }
                                        else if (product.Stock <= 5)
                                        {

                                            <span class="stock-badge stock-low">

                                                @product.Stock restantes

                                            </span>

                                        }
                                        else
                                        {

                                            <span class="stock-badge stock-good">

                                                @product.Stock disponibles

                                            </span>

                                        }


                                    </td>



                                    <!-- FECHA -->

                                    <td>

                                        <span class="product-date">

                                            @(product.CreatedAt
                                                .ToLocalTime()
                                                .ToString("dd/MM/yyyy"))

                                        </span>

                                    </td>



                                    <!-- ACCIONES -->

                                    <td>


                                        <div class="product-actions">


                                            <a asp-controller="Products"
                                               asp-action="Details"
                                               asp-route-id="@product.Id"
                                               class="product-action view">

                                                Ver

                                            </a>


                                            <a asp-controller="Products"
                                               asp-action="Edit"
                                               asp-route-id="@product.Id"
                                               class="product-action edit">

                                                Editar

                                            </a>


                                            <a asp-controller="Products"
                                               asp-action="Delete"
                                               asp-route-id="@product.Id"
                                               class="product-action delete">

                                                Eliminar

                                            </a>


                                        </div>


                                    </td>


                                </tr>

                            }


                        </tbody>


                    </table>


                </div>

            }
            else
            {

                <div class="empty-products">


                    <div class="empty-products-icon">
                        🎮
                    </div>


                    <strong>
                        No se encontraron productos
                    </strong>


                    No existen productos que coincidan
                    con los filtros seleccionados.


                </div>

            }


        </div>


    </div>

</div>