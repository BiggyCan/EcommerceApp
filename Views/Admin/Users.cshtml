@model List<EcommerceApp.Models.ApplicationUser>

@using System.Security.Claims

@{
    ViewData["Title"] = "Administrar Usuarios";

    var userRoles =
        ViewBag.UserRoles as Dictionary<string, IList<string>>
        ?? new Dictionary<string, IList<string>>();

    var currentUserId =
        User.FindFirstValue(ClaimTypes.NameIdentifier);

    var totalUsers = Model?.Count ?? 0;

    var adminCount = Model?
        .Count(u =>
            userRoles.ContainsKey(u.Id) &&
            userRoles[u.Id].Contains("Admin"))
        ?? 0;

    var normalUserCount = Model?
        .Count(u =>
            userRoles.ContainsKey(u.Id) &&
            userRoles[u.Id].Contains("User"))
        ?? 0;
}

<style>

    .users-page {
        min-height: 100vh;
        background: #f3f5f8;
        padding: 35px 0 70px;
    }

    .users-container {
        width: calc(100% - 40px);
        max-width: 1240px;
        margin: auto;
    }

    .users-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .users-title-area h1 {
        margin: 0;
        color: #111827;
        font-size: 32px;
        font-weight: 900;
    }

    .users-title-area p {
        margin: 6px 0 0;
        color: #64748b;
        font-size: 14px;
    }

    .users-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 12px;
        margin-bottom: 10px;
        border-radius: 20px;

        background:
            linear-gradient(
                135deg,
                #7c3aed,
                #2563eb
            );

        color: white;
        font-size: 10px;
        font-weight: 800;
    }

    .back-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        min-height: 42px;
        padding: 0 18px;

        border-radius: 6px;

        background: #111827;
        color: white;

        text-decoration: none;
        font-size: 12px;
        font-weight: 800;

        transition: .2s;
    }

    .back-button:hover {
        color: white;
        background: #2563eb;
        transform: translateY(-2px);
    }

    .message {
        margin-bottom: 20px;
        padding: 13px 16px;
        border-radius: 8px;

        font-size: 13px;
        font-weight: 700;
    }

    .message.success {
        background: #dcfce7;
        color: #166534;
        border: 1px solid #bbf7d0;
    }

    .message.error {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }

    .users-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 25px;
    }

    .summary-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 11px;
        padding: 20px;

        box-shadow:
            0 5px 16px rgba(15,23,42,.05);
    }

    .summary-label {
        color: #64748b;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .summary-number {
        margin-top: 9px;
        color: #111827;
        font-size: 27px;
        font-weight: 900;
    }

    .summary-admin .summary-number {
        color: #7c3aed;
    }

    .summary-user .summary-number {
        color: #2563eb;
    }

    .users-panel {
        background: white;

        border: 1px solid #e2e8f0;
        border-radius: 12px;

        overflow: hidden;

        box-shadow:
            0 5px 18px rgba(15,23,42,.06);
    }

    .panel-top {
        padding: 21px 23px;

        border-bottom: 1px solid #e5e7eb;

        display: flex;
        justify-content: space-between;
        align-items: center;

        gap: 15px;
    }

    .panel-top h2 {
        margin: 0;
        color: #111827;
        font-size: 19px;
        font-weight: 900;
    }

    .panel-top p {
        margin: 4px 0 0;
        color: #64748b;
        font-size: 12px;
    }

    .user-count {
        padding: 7px 11px;
        border-radius: 20px;

        background: #e0e7ff;
        color: #3730a3;

        font-size: 11px;
        font-weight: 800;
    }

    .table-wrapper {
        overflow-x: auto;
    }

    .users-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 980px;
    }

    .users-table th {
        padding: 13px 17px;

        background: #f8fafc;
        color: #64748b;

        text-align: left;

        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;

        border-bottom: 1px solid #e5e7eb;
    }

    .users-table td {
        padding: 15px 17px;

        border-bottom: 1px solid #eef2f7;

        vertical-align: middle;

        font-size: 12px;
    }

    .users-table tbody tr:hover {
        background: #fbfdff;
    }

    .users-table tr:last-child td {
        border-bottom: none;
    }

    .user-profile {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .user-avatar {
        width: 44px;
        height: 44px;

        flex: 0 0 44px;

        border-radius: 50%;

        display: flex;
        align-items: center;
        justify-content: center;

        background:
            linear-gradient(
                135deg,
                #dbeafe,
                #ede9fe
            );

        color: #3730a3;

        font-size: 18px;
        font-weight: 900;
    }

    .user-name {
        color: #111827;
        font-size: 13px;
        font-weight: 800;
    }

    .user-email {
        display: block;
        margin-top: 2px;

        color: #64748b;
        font-size: 11px;
    }

    .user-address {
        color: #475569;
        font-size: 12px;
    }

    .created-date {
        color: #64748b;
        font-size: 11px;
    }

    .role {
        display: inline-flex;
        align-items: center;
        gap: 5px;

        padding: 6px 10px;

        border-radius: 20px;

        font-size: 10px;
        font-weight: 800;
    }

    .role.admin {
        background: #ede9fe;
        color: #6d28d9;
    }

    .role.user {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .role.none {
        background: #f1f5f9;
        color: #64748b;
    }

    .current-account {
        display: inline-block;

        margin-left: 6px;

        padding: 4px 7px;

        border-radius: 15px;

        background: #dcfce7;
        color: #15803d;

        font-size: 9px;
        font-weight: 800;
    }

    .actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .action-form {
        margin: 0;
    }

    .action-button {
        min-height: 32px;

        padding: 0 10px;

        border: none;
        border-radius: 5px;

        color: white;

        font-size: 10px;
        font-weight: 800;

        cursor: pointer;

        transition: .2s;
    }

    .action-button:hover {
        transform: translateY(-1px);
        filter: brightness(1.08);
    }

    .make-admin {
        background:
            linear-gradient(
                135deg,
                #7c3aed,
                #4f46e5
            );
    }

    .make-user {
        background: #2563eb;
    }

    .delete-user {
        background: #dc2626;
    }

    .protected-account {
        color: #15803d;
        font-size: 10px;
        font-weight: 800;
    }

    .empty-users {
        padding: 60px 20px;
        text-align: center;
        color: #64748b;
    }

    .empty-users-icon {
        margin-bottom: 10px;
        font-size: 50px;
    }

    @@media (max-width: 850px) {

        .users-summary {
            grid-template-columns: 1fr;
        }

    }

    @@media (max-width: 650px) {

        .users-container {
            width: calc(100% - 24px);
        }

        .users-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .users-title-area h1 {
            font-size: 27px;
        }

    }

</style>


<div class="users-page">

    <div class="users-container">


        <div class="users-header">


            <div class="users-title-area">

                <div class="users-badge">
                    👥 GESTIÓN DE USUARIOS
                </div>

                <h1>
                    Usuarios de BigGame
                </h1>

                <p>
                    Consulta las cuentas registradas
                    y administra sus permisos.
                </p>

            </div>


            <a asp-controller="Admin"
               asp-action="Index"
               class="back-button">

                ← Volver al panel

            </a>


        </div>



        @if (TempData["SuccessMessage"] != null)
        {

            <div class="message success">

                ✓ @TempData["SuccessMessage"]

            </div>

        }


        @if (TempData["ErrorMessage"] != null)
        {

            <div class="message error">

                ⚠ @TempData["ErrorMessage"]

            </div>

        }



        <div class="users-summary">


            <div class="summary-card">

                <div class="summary-label">
                    Usuarios totales
                </div>

                <div class="summary-number">
                    @totalUsers
                </div>

            </div>


            <div class="summary-card summary-user">

                <div class="summary-label">
                    Usuarios normales
                </div>

                <div class="summary-number">
                    @normalUserCount
                </div>

            </div>


            <div class="summary-card summary-admin">

                <div class="summary-label">
                    Administradores
                </div>

                <div class="summary-number">
                    @adminCount
                </div>

            </div>


        </div>



        <div class="users-panel">


            <div class="panel-top">

                <div>

                    <h2>
                        Cuentas registradas
                    </h2>

                    <p>
                        Usuarios almacenados en BigGame
                    </p>

                </div>


                <span class="user-count">
                    @totalUsers cuentas
                </span>

            </div>



            @if (Model != null && Model.Count > 0)
            {

                <div class="table-wrapper">


                    <table class="users-table">


                        <thead>

                            <tr>

                                <th>
                                    Usuario
                                </th>

                                <th>
                                    Dirección
                                </th>

                                <th>
                                    Rol
                                </th>

                                <th>
                                    Registro
                                </th>

                                <th>
                                    Acciones
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            @foreach (var user in Model)
                            {

                                var roles =
                                    userRoles.ContainsKey(user.Id)
                                    ? userRoles[user.Id]
                                    : new List<string>();

                                var isAdmin =
                                    roles.Contains("Admin");

                                var isCurrentUser =
                                    user.Id == currentUserId;

                                var firstLetter =
                                    !string.IsNullOrWhiteSpace(user.FullName)
                                    ? user.FullName.Substring(0, 1).ToUpper()
                                    : !string.IsNullOrWhiteSpace(user.Email)
                                        ? user.Email.Substring(0, 1).ToUpper()
                                        : "?";


                                <tr>


                                    <td>

                                        <div class="user-profile">


                                            <div class="user-avatar">

                                                @firstLetter

                                            </div>


                                            <div>

                                                <div class="user-name">

                                                    @(string.IsNullOrWhiteSpace(user.FullName)
                                                        ? "Usuario BigGame"
                                                        : user.FullName)


                                                    @if (isCurrentUser)
                                                    {

                                                        <span class="current-account">
                                                            TU CUENTA
                                                        </span>

                                                    }

                                                </div>


                                                <span class="user-email">
                                                    @user.Email
                                                </span>

                                            </div>


                                        </div>

                                    </td>



                                    <td>

                                        <span class="user-address">

                                            @(string.IsNullOrWhiteSpace(user.Address)
                                                ? "Sin dirección"
                                                : user.Address)

                                        </span>

                                    </td>



                                    <td>


                                        @if (isAdmin)
                                        {

                                            <span class="role admin">
                                                ⚙ Admin
                                            </span>

                                        }
                                        else if (roles.Contains("User"))
                                        {

                                            <span class="role user">
                                                👤 User
                                            </span>

                                        }
                                        else
                                        {

                                            <span class="role none">
                                                Sin rol
                                            </span>

                                        }


                                    </td>



                                    <td>

                                        <span class="created-date">

                                            @(user.CreatedAt
                                                .ToLocalTime()
                                                .ToString("dd/MM/yyyy"))

                                        </span>

                                    </td>



                                    <td>


                                        <div class="actions">


                                            @if (isCurrentUser)
                                            {

                                                <span class="protected-account">

                                                    🔒 Cuenta protegida

                                                </span>

                                            }
                                            else
                                            {

                                                @if (isAdmin)
                                                {

                                                    <form asp-controller="Admin"
                                                          asp-action="MakeUser"
                                                          method="post"
                                                          class="action-form">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@user.Id" />

                                                        <button type="submit"
                                                                class="action-button make-user"
                                                                onclick="return confirm('¿Quieres convertir esta cuenta en usuario normal?');">

                                                            Hacer User

                                                        </button>

                                                    </form>

                                                }
                                                else
                                                {

                                                    <form asp-controller="Admin"
                                                          asp-action="MakeAdmin"
                                                          method="post"
                                                          class="action-form">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="id"
                                                               value="@user.Id" />

                                                        <button type="submit"
                                                                class="action-button make-admin"
                                                                onclick="return confirm('¿Quieres convertir esta cuenta en administrador?');">

                                                            Hacer Admin

                                                        </button>

                                                    </form>

                                                }



                                                <form asp-controller="Admin"
                                                      asp-action="DeleteUser"
                                                      method="post"
                                                      class="action-form">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@user.Id" />

                                                    <button type="submit"
                                                            class="action-button delete-user"
                                                            onclick="return confirm('¿Seguro que quieres eliminar esta cuenta? Esta acción no se puede deshacer.');">

                                                        Eliminar

                                                    </button>

                                                </form>

                                            }


                                        </div>


                                    </td>


                                </tr>

                            }


                        </tbody>


                    </table>


                </div>

            }
            else
            {

                <div class="empty-users">

                    <div class="empty-users-icon">
                        👥
                    </div>

                    No existen usuarios registrados.

                </div>

            }


        </div>


    </div>

</div>