@{
    ViewData["Title"] = "Ventas por período - BigGame";

    var fechaInicio =
        ViewBag.FechaInicio as string
        ?? DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd");

    var fechaFin =
        ViewBag.FechaFin as string
        ?? DateTime.Now.ToString("yyyy-MM-dd");
}

<style>
    .period-report-page {
        min-height: 100vh;
        background: #f5f7fb;
        padding: 38px 20px 70px;
        color: #0f172a;
    }

    .period-report-container {
        width: min(1180px, 100%);
        margin: 0 auto;
    }

    .period-report-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 26px;
    }

    .period-report-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 999px;
        background: #e8efff;
        color: #1d4ed8;
        font-size: 12px;
        font-weight: 900;
        letter-spacing: .4px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .period-report-title {
        margin: 0;
        font-size: clamp(30px, 4vw, 44px);
        font-weight: 950;
        letter-spacing: -1.5px;
        color: #0f172a;
    }

    .period-report-description {
        margin: 8px 0 0;
        max-width: 760px;
        color: #64748b;
        font-size: 15px;
        line-height: 1.55;
    }

    .back-reports {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 18px;
        border-radius: 9px;
        background: #111827;
        color: white;
        text-decoration: none;
        font-size: 13px;
        font-weight: 900;
        transition: .2s ease;
    }

    .back-reports:hover {
        background: #1f2937;
        color: white;
        transform: translateY(-1px);
    }

    .report-filter-card {
        overflow: hidden;
        border: 1px solid #dbe3ef;
        border-radius: 16px;
        background: white;
        box-shadow: 0 12px 35px rgba(15, 23, 42, .06);
        margin-bottom: 24px;
    }

    .report-filter-header {
        padding: 19px 22px;
        color: white;
        background: linear-gradient(
            120deg,
            #0f172a,
            #1e3a8a
        );
    }

    .report-filter-header h2 {
        margin: 0;
        font-size: 20px;
        font-weight: 900;
    }

    .report-filter-header p {
        margin: 5px 0 0;
        color: #dbeafe;
        font-size: 12px;
    }

    .report-filter-body {
        padding: 22px;
    }

    .report-filter-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 16px;
    }

    .report-field label {
        display: block;
        margin-bottom: 7px;
        font-size: 12px;
        font-weight: 900;
        color: #1e293b;
    }

    .report-field input {
        width: 100%;
        height: 48px;
        padding: 0 13px;
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        outline: none;
        color: #0f172a;
        background: #fff;
        font-size: 14px;
        transition: .2s ease;
    }

    .report-field input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
    }

    .report-explanation {
        margin-top: 17px;
        padding: 12px 14px;
        border: 1px solid #dbeafe;
        border-radius: 9px;
        background: #f8fbff;
        color: #52627a;
        font-size: 12px;
        line-height: 1.5;
    }

    .report-buttons {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr;
        gap: 10px;
        margin-top: 18px;
    }

    .report-button {
        min-height: 48px;
        border: 0;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 900;
        cursor: pointer;
        transition: .18s ease;
    }

    .report-button:hover {
        transform: translateY(-1px);
    }

    .report-button-primary {
        color: white;
        background: linear-gradient(
            120deg,
            #2563eb,
            #0ea5e9
        );
    }

    .report-button-primary:hover {
        color: white;
        box-shadow: 0 8px 20px rgba(37, 99, 235, .22);
    }

    .report-button-pdf {
        color: white;
        background: #111827;
    }

    .report-button-pdf:hover {
        color: white;
        background: #1f2937;
    }

    .report-button-excel {
        color: white;
        background: #15803d;
    }

    .report-button-excel:hover {
        color: white;
        background: #166534;
    }

    .report-error {
        margin-bottom: 18px;
        padding: 12px 15px;
        border: 1px solid #fecaca;
        border-radius: 9px;
        background: #fff1f2;
        color: #b91c1c;
        font-size: 13px;
        font-weight: 700;
    }

    .report-viewer-card {
        overflow: hidden;
        border: 1px solid #dbe3ef;
        border-radius: 16px;
        background: white;
        box-shadow: 0 12px 35px rgba(15, 23, 42, .06);
    }

    .report-viewer-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 16px 20px;
        border-bottom: 1px solid #e2e8f0;
        background: white;
    }

    .viewer-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .viewer-icon {
        width: 39px;
        height: 39px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: #e8efff;
        font-size: 19px;
    }

    .viewer-title h3 {
        margin: 0;
        font-size: 16px;
        font-weight: 900;
    }

    .viewer-title p {
        margin: 3px 0 0;
        color: #64748b;
        font-size: 11px;
    }

    .viewer-status {
        padding: 6px 10px;
        border-radius: 999px;
        background: #f1f5f9;
        color: #475569;
        font-size: 10px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .viewer-status.ready {
        background: #dcfce7;
        color: #15803d;
    }

    .report-viewer-empty {
        min-height: 520px;
        padding: 40px 20px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        background:
            radial-gradient(
                circle at center,
                #f8fbff,
                #f1f5f9
            );
    }

    .report-viewer-empty-icon {
        width: 82px;
        height: 82px;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 22px;
        background: #e8efff;
        font-size: 38px;
    }

    .report-viewer-empty h3 {
        margin: 0 0 8px;
        font-size: 21px;
        font-weight: 900;
    }

    .report-viewer-empty p {
        max-width: 520px;
        margin: 0;
        color: #64748b;
        font-size: 13px;
        line-height: 1.55;
    }

    .report-pdf-frame {
        display: none;
        width: 100%;
        height: 760px;
        border: 0;
        background: #e5e7eb;
    }

    .report-pdf-frame.visible {
        display: block;
    }

    .activity-requirements {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-top: 20px;
    }

    .activity-requirement {
        padding: 14px;
        border: 1px solid #dbe3ef;
        border-radius: 10px;
        background: white;
    }

    .activity-requirement strong {
        display: block;
        margin-bottom: 4px;
        color: #0f172a;
        font-size: 12px;
    }

    .activity-requirement span {
        color: #64748b;
        font-size: 10px;
        line-height: 1.4;
    }

    @@media (max-width: 850px) {
        .period-report-top {
            flex-direction: column;
        }

        .report-filter-grid,
        .report-buttons {
            grid-template-columns: 1fr;
        }

        .activity-requirements {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .back-reports {
            width: 100%;
        }
    }

    @@media (max-width: 600px) {
        .period-report-page {
            padding: 24px 12px 50px;
        }

        .report-filter-body {
            padding: 16px;
        }

        .report-viewer-header {
            align-items: flex-start;
        }

        .report-pdf-frame {
            height: 630px;
        }

        .activity-requirements {
            grid-template-columns: 1fr;
        }
    }
</style>


<section class="period-report-page">

    <div class="period-report-container">

        <div class="period-report-top">

            <div>

                <div class="period-report-badge">
                    📊 Reporte administrativo
                </div>

                <h1 class="period-report-title">
                    Ventas por período
                </h1>

                <p class="period-report-description">
                    Selecciona un rango de fechas para consultar las ventas
                    registradas. El reporte puede visualizarse dentro de BigGame
                    y exportarse en formato PDF o Excel.
                </p>

            </div>

            <a
                asp-controller="Reports"
                asp-action="Index"
                class="back-reports"
            >
                ← Centro de reportes
            </a>

        </div>


        @if (TempData["ReportError"] != null)
        {
            <div class="report-error">
                ⚠️ @TempData["ReportError"]
            </div>
        }


        <div class="report-filter-card">

            <div class="report-filter-header">

                <h2>
                    Seleccionar período
                </h2>

                <p>
                    Los datos se consultan directamente desde la base de datos de BigGame.
                </p>

            </div>


            <div class="report-filter-body">

                <form
                    id="reportForm"
                    autocomplete="off"
                >

                    <div class="report-filter-grid">

                        <div class="report-field">

                            <label for="fechaInicio">
                                Fecha inicial
                            </label>

                            <input
                                type="date"
                                id="fechaInicio"
                                name="fechaInicio"
                                value="@fechaInicio"
                                required
                            />

                        </div>


                        <div class="report-field">

                            <label for="fechaFin">
                                Fecha final
                            </label>

                            <input
                                type="date"
                                id="fechaFin"
                                name="fechaFin"
                                value="@fechaFin"
                                required
                            />

                        </div>

                    </div>


                    <div class="report-explanation">

                        📌 El sistema utiliza las fechas seleccionadas como parámetros.
                        La consulta filtra las ventas registradas dentro del período,
                        calcula pedidos, unidades, ingresos y promedio de venta.
                        El resultado puede visualizarse y exportarse sin modificar
                        los datos originales.

                    </div>


                    <div class="report-buttons">

                        <button
                            type="submit"
                            class="report-button report-button-primary"
                        >
                            👁️ Generar y visualizar reporte
                        </button>


                        <a
                            id="downloadPdfButton"
                            href="#"
                            class="report-button report-button-pdf"
                        >
                            📄 Descargar PDF
                        </a>


                        <a
                            id="downloadExcelButton"
                            href="#"
                            class="report-button report-button-excel"
                        >
                            📊 Exportar Excel
                        </a>

                    </div>

                </form>

            </div>

        </div>


        <div class="report-viewer-card">

            <div class="report-viewer-header">

                <div class="viewer-title">

                    <div class="viewer-icon">
                        📑
                    </div>

                    <div>

                        <h3>
                            Visor de reportes
                        </h3>

                        <p>
                            Vista previa generada dinámicamente con los filtros seleccionados.
                        </p>

                    </div>

                </div>


                <div
                    id="viewerStatus"
                    class="viewer-status"
                >
                    Esperando parámetros
                </div>

            </div>


            <div
                id="viewerEmpty"
                class="report-viewer-empty"
            >

                <div class="report-viewer-empty-icon">
                    📊
                </div>

                <h3>
                    Genera un reporte
                </h3>

                <p>
                    Selecciona una fecha inicial y una fecha final y pulsa
                    “Generar y visualizar reporte”. El documento se mostrará
                    directamente dentro de esta sección.
                </p>

            </div>


            <iframe
                id="reportViewer"
                class="report-pdf-frame"
                title="Visor del reporte de ventas por período"
            >
            </iframe>

        </div>


        <div class="activity-requirements">

            <div class="activity-requirement">
                <strong>
                    🔎 Filtrado dinámico
                </strong>
                <span>
                    Parámetros de fecha inicial y final.
                </span>
            </div>

            <div class="activity-requirement">
                <strong>
                    🗄️ Data Binding
                </strong>
                <span>
                    Información consultada desde PostgreSQL mediante EF Core.
                </span>
            </div>

            <div class="activity-requirement">
                <strong>
                    📄 PDF
                </strong>
                <span>
                    Visualización y descarga mediante QuestPDF.
                </span>
            </div>

            <div class="activity-requirement">
                <strong>
                    📊 Excel
                </strong>
                <span>
                    Exportación dinámica en formato XLSX.
                </span>
            </div>

        </div>

    </div>

</section>


<script>
    (function () {

        "use strict";


        const form =
            document.getElementById(
                "reportForm"
            );


        const fechaInicio =
            document.getElementById(
                "fechaInicio"
            );


        const fechaFin =
            document.getElementById(
                "fechaFin"
            );


        const viewer =
            document.getElementById(
                "reportViewer"
            );


        const viewerEmpty =
            document.getElementById(
                "viewerEmpty"
            );


        const viewerStatus =
            document.getElementById(
                "viewerStatus"
            );


        const downloadPdfButton =
            document.getElementById(
                "downloadPdfButton"
            );


        const downloadExcelButton =
            document.getElementById(
                "downloadExcelButton"
            );


        const verPdfBaseUrl =
            '@Url.Action(
                "VerPdf",
                "VentasPeriodoReports"
            )';


        const descargarPdfBaseUrl =
            '@Url.Action(
                "DescargarPdf",
                "VentasPeriodoReports"
            )';


        const descargarExcelBaseUrl =
            '@Url.Action(
                "DescargarExcel",
                "VentasPeriodoReports"
            )';


        function obtenerParametros() {

            return new URLSearchParams({
                fechaInicio:
                    fechaInicio.value,

                fechaFin:
                    fechaFin.value
            });

        }


        function validarFechas() {

            if (
                !fechaInicio.value
                ||
                !fechaFin.value
            ) {

                alert(
                    "Selecciona una fecha inicial y una fecha final."
                );

                return false;

            }


            if (
                fechaInicio.value
                >
                fechaFin.value
            ) {

                alert(
                    "La fecha inicial no puede ser posterior a la fecha final."
                );

                return false;

            }


            return true;

        }


        function actualizarDescargas() {

            if (!validarFechas()) {
                return false;
            }


            const parametros =
                obtenerParametros();


            downloadPdfButton.href =
                descargarPdfBaseUrl
                +
                "?"
                +
                parametros.toString();


            downloadExcelButton.href =
                descargarExcelBaseUrl
                +
                "?"
                +
                parametros.toString();


            return true;

        }


        form.addEventListener(
            "submit",
            function (event) {

                event.preventDefault();


                if (!actualizarDescargas()) {
                    return;
                }


                const parametros =
                    obtenerParametros();


                const viewerUrl =
                    verPdfBaseUrl
                    +
                    "?"
                    +
                    parametros.toString()
                    +
                    "&t="
                    +
                    Date.now();


                viewerStatus.textContent =
                    "Generando reporte...";


                viewerStatus.classList.remove(
                    "ready"
                );


                viewerEmpty.style.display =
                    "none";


                viewer.classList.add(
                    "visible"
                );


                viewer.src =
                    viewerUrl;

            }
        );


        viewer.addEventListener(
            "load",
            function () {

                if (!viewer.src) {
                    return;
                }


                viewerStatus.textContent =
                    "Reporte generado";


                viewerStatus.classList.add(
                    "ready"
                );

            }
        );


        downloadPdfButton.addEventListener(
            "click",
            function (event) {

                if (!actualizarDescargas()) {

                    event.preventDefault();

                }

            }
        );


        downloadExcelButton.addEventListener(
            "click",
            function (event) {

                if (!actualizarDescargas()) {

                    event.preventDefault();

                }

            }
        );


        fechaInicio.addEventListener(
            "change",
            actualizarDescargas
        );


        fechaFin.addEventListener(
            "change",
            actualizarDescargas
        );


        actualizarDescargas();

    })();
</script>