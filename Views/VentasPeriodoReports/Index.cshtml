@{
    ViewData["Title"] = "Ventas por período";

    var fechaInicio =
        ViewBag.FechaInicio as string
        ?? "";

    var fechaFin =
        ViewBag.FechaFin as string
        ?? "";
}

<style>
    .period-report-page {
        min-height: 72vh;
        background: #f4f6f9;
        padding: 44px 20px 70px;
    }

    .period-report-container {
        width: min(980px, 100%);
        margin: 0 auto;
    }

    .period-report-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 28px;
    }

    .period-report-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        border-radius: 999px;
        background: #e8efff;
        color: #1d4ed8;
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 10px;
    }

    .period-report-title {
        margin: 0;
        color: #0f172a;
        font-size: clamp(30px, 4vw, 44px);
        font-weight: 900;
        letter-spacing: -.04em;
    }

    .period-report-subtitle {
        margin: 10px 0 0;
        max-width: 680px;
        color: #64748b;
        font-size: 14px;
        line-height: 1.6;
    }

    .period-report-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 0 18px;
        border-radius: 7px;
        background: #111827;
        color: #fff;
        text-decoration: none;
        font-weight: 800;
        font-size: 13px;
        white-space: nowrap;
        transition: .2s ease;
    }

    .period-report-back:hover {
        background: #2563eb;
        color: #fff;
        transform: translateY(-1px);
    }

    .period-report-card {
        background: #fff;
        border: 1px solid #dce3ec;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 14px 40px rgba(15, 23, 42, .08);
    }

    .period-report-card-head {
        padding: 24px 26px;
        background:
            linear-gradient(
                120deg,
                #0f172a,
                #153c82
            );
        color: #fff;
    }

    .period-report-card-head h2 {
        margin: 0;
        font-size: 22px;
        font-weight: 900;
    }

    .period-report-card-head p {
        margin: 8px 0 0;
        color: #dbeafe;
        font-size: 13px;
        line-height: 1.5;
    }

    .period-report-body {
        padding: 28px;
    }

    .period-error {
        margin-bottom: 20px;
        padding: 14px 16px;
        border-radius: 9px;
        background: #fff1f2;
        border: 1px solid #fecdd3;
        color: #be123c;
        font-size: 13px;
        font-weight: 700;
    }

    .period-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .period-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .period-field label {
        color: #334155;
        font-size: 13px;
        font-weight: 800;
    }

    .period-field input {
        width: 100%;
        height: 48px;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        padding: 0 13px;
        background: #fff;
        color: #0f172a;
        font-size: 14px;
        outline: none;
        transition: .2s ease;
    }

    .period-field input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .12);
    }

    .period-helper {
        margin-top: 20px;
        padding: 16px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        color: #64748b;
        font-size: 12px;
        line-height: 1.6;
    }

    .period-actions {
        display: flex;
        gap: 12px;
        margin-top: 24px;
    }

    .period-download {
        flex: 1;
        min-height: 48px;
        border: none;
        border-radius: 8px;
        background:
            linear-gradient(
                90deg,
                #2563eb,
                #1687f8
            );
        color: #fff;
        font-size: 14px;
        font-weight: 900;
        cursor: pointer;
        transition: .2s ease;
    }

    .period-download:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 24px rgba(37, 99, 235, .24);
    }

    .period-reset {
        min-height: 48px;
        padding: 0 18px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        background: #fff;
        color: #0f172a;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 800;
    }

    .period-reset:hover {
        background: #f8fafc;
        color: #0f172a;
    }

    .architecture-box {
        margin-top: 24px;
        padding: 20px;
        border-radius: 12px;
        background: #fff;
        border: 1px solid #dce3ec;
    }

    .architecture-box h3 {
        margin: 0 0 15px;
        color: #0f172a;
        font-size: 16px;
        font-weight: 900;
    }

    .architecture-flow {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 8px;
        align-items: center;
    }

    .architecture-step {
        padding: 12px 8px;
        border-radius: 8px;
        text-align: center;
        background: #f1f5f9;
        color: #334155;
        font-size: 11px;
        font-weight: 800;
    }

    .architecture-step strong {
        display: block;
        margin-bottom: 4px;
        color: #2563eb;
        font-size: 13px;
    }

    @@media (max-width: 700px) {
        .period-report-page {
            padding: 28px 14px 50px;
        }

        .period-report-top {
            flex-direction: column;
        }

        .period-grid {
            grid-template-columns: 1fr;
        }

        .period-actions {
            flex-direction: column;
        }

        .period-report-back,
        .period-reset {
            width: 100%;
        }

        .architecture-flow {
            grid-template-columns: 1fr;
        }
    }
</style>


<section class="period-report-page">

    <div class="period-report-container">

        <div class="period-report-top">

            <div>

                <div class="period-report-badge">
                    📅 Reporte administrativo
                </div>

                <h1 class="period-report-title">
                    Ventas por período
                </h1>

                <p class="period-report-subtitle">
                    Selecciona un rango de fechas para consultar
                    las ventas registradas y descargar un reporte PDF
                    con pedidos, unidades vendidas, ingresos y promedio.
                </p>

            </div>

            <a
                asp-controller="Reports"
                asp-action="Index"
                class="period-report-back"
            >
                ← Centro de reportes
            </a>

        </div>


        <div class="period-report-card">

            <div class="period-report-card-head">

                <h2>
                    Seleccionar período
                </h2>

                <p>
                    El reporte utiliza las ventas almacenadas
                    actualmente en la base de datos de BigGame.
                </p>

            </div>


            <div class="period-report-body">

                @if (TempData["ReportError"] != null)
                {
                    <div class="period-error">
                        ⚠️ @TempData["ReportError"]
                    </div>
                }


                <form
                    asp-controller="VentasPeriodoReports"
                    asp-action="DescargarPdf"
                    method="get"
                >

                    <div class="period-grid">

                        <div class="period-field">

                            <label for="fechaInicio">
                                Fecha inicial
                            </label>

                            <input
                                id="fechaInicio"
                                name="fechaInicio"
                                type="date"
                                value="@fechaInicio"
                                required
                            />

                        </div>


                        <div class="period-field">

                            <label for="fechaFin">
                                Fecha final
                            </label>

                            <input
                                id="fechaFin"
                                name="fechaFin"
                                type="date"
                                value="@fechaFin"
                                required
                            />

                        </div>

                    </div>


                    <div class="period-helper">
                        <strong>📄 El documento incluirá:</strong>
                        número de pedido, fecha y hora,
                        cliente, correo, estado, cantidad de productos,
                        total vendido, promedio de venta,
                        período consultado y fecha/hora de generación.
                    </div>


                    <div class="period-actions">

                        <button
                            type="submit"
                            class="period-download"
                        >
                            📥 Generar y descargar PDF
                        </button>

                        <a
                            asp-controller="VentasPeriodoReports"
                            asp-action="Index"
                            class="period-reset"
                        >
                            Restablecer fechas
                        </a>

                    </div>

                </form>

            </div>

        </div>


        <div class="architecture-box">

            <h3>
                Arquitectura del reporte
            </h3>

            <div class="architecture-flow">

                <div class="architecture-step">
                    <strong>1</strong>
                    Solicitud
                </div>

                <div class="architecture-step">
                    <strong>2</strong>
                    Consulta
                </div>

                <div class="architecture-step">
                    <strong>3</strong>
                    Modelo
                </div>

                <div class="architecture-step">
                    <strong>4</strong>
                    Renderer
                </div>

                <div class="architecture-step">
                    <strong>5</strong>
                    Entrega
                </div>

            </div>

        </div>

    </div>

</section>