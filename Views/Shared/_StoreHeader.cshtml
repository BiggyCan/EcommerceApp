@using System.Text.Json

@{
    var cartCount = 0;

    var cartJson =
        Context.Session.GetString("BigGameCart");

    if (!string.IsNullOrWhiteSpace(cartJson))
    {
        try
        {
            var cart =
                JsonSerializer.Deserialize<List<EcommerceApp.Models.CartItem>>(
                    cartJson
                )
                ?? new List<EcommerceApp.Models.CartItem>();

            cartCount =
                cart.Sum(item => item.Quantity);
        }
        catch
        {
            cartCount = 0;
        }
    }
}

