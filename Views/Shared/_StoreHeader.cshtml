<script>
    (function () {

        const menuButton =
            document.getElementById("storeMenuButton");

        const menuPanel =
            document.getElementById("storeMenuPanel");


        /* =====================================================
           MENÚ GENERAL
        ====================================================== */

        if (menuButton && menuPanel) {

            menuButton.addEventListener(
                "click",
                function () {

                    const isOpen =
                        menuPanel.classList.toggle("open");

                    menuButton.setAttribute(
                        "aria-expanded",
                        isOpen
                            ? "true"
                            : "false"
                    );
                }
            );
        }


        /* =====================================================
           MENÚS DESPLEGABLES EN PANTALLAS TÁCTILES
        ====================================================== */

        const navItems =
            document.querySelectorAll(
                ".store-nav-item"
            );

        navItems.forEach(
            function (item) {

                const dropdown =
                    item.querySelector(
                        ".store-dropdown"
                    );

                const link =
                    item.querySelector(
                        ".store-nav-link"
                    );

                if (!dropdown || !link) {
                    return;
                }

                link.addEventListener(
                    "click",
                    function (event) {

                        if (
                            window.matchMedia(
                                "(hover: none)"
                            ).matches
                        ) {

                            if (
                                !item.classList.contains(
                                    "dropdown-open"
                                )
                            ) {

                                event.preventDefault();

                                navItems.forEach(
                                    function (otherItem) {
                                        otherItem.classList.remove(
                                            "dropdown-open"
                                        );
                                    }
                                );

                                item.classList.add(
                                    "dropdown-open"
                                );
                            }
                        }
                    }
                );
            }
        );


        /* =====================================================
           CARRUSEL PROMOCIONAL
        ====================================================== */

        const promoSlides =
            Array.from(
                document.querySelectorAll(
                    ".store-promo-slide"
                )
            );

        const promoPrevious =
            document.getElementById(
                "promoPrevious"
            );

        const promoNext =
            document.getElementById(
                "promoNext"
            );

        let currentPromo = 0;

        let promoTimer = null;


        function showPromo(index) {

            if (promoSlides.length === 0) {
                return;
            }

            if (index < 0) {
                index =
                    promoSlides.length - 1;
            }

            if (index >= promoSlides.length) {
                index = 0;
            }

            promoSlides.forEach(
                function (slide) {
                    slide.classList.remove(
                        "active"
                    );
                }
            );

            promoSlides[index].classList.add(
                "active"
            );

            currentPromo = index;
        }


        function nextPromo() {

            showPromo(
                currentPromo + 1
            );
        }


        function previousPromo() {

            showPromo(
                currentPromo - 1
            );
        }


        function startPromoTimer() {

            if (
                window.matchMedia(
                    "(prefers-reduced-motion: reduce)"
                ).matches
            ) {
                return;
            }

            stopPromoTimer();

            promoTimer =
                window.setInterval(
                    nextPromo,
                    5000
                );
        }


        function stopPromoTimer() {

            if (promoTimer) {

                window.clearInterval(
                    promoTimer
                );

                promoTimer = null;
            }
        }


        if (promoPrevious) {

            promoPrevious.addEventListener(
                "click",
                function () {

                    previousPromo();

                    startPromoTimer();
                }
            );
        }


        if (promoNext) {

            promoNext.addEventListener(
                "click",
                function () {

                    nextPromo();

                    startPromoTimer();
                }
            );
        }


        const promoContainer =
            document.querySelector(
                ".store-promo"
            );


        if (promoContainer) {

            promoContainer.addEventListener(
                "mouseenter",
                stopPromoTimer
            );

            promoContainer.addEventListener(
                "mouseleave",
                startPromoTimer
            );
        }


        showPromo(0);

        startPromoTimer();

    })();
</script>