<script>

    (function () {

        /* =====================================================
           DRAWER PRINCIPAL
        ====================================================== */

        const menuButton =
            document.getElementById(
                "storeMenuButton"
            );

        const drawer =
            document.getElementById(
                "storeDrawer"
            );

        const overlay =
            document.getElementById(
                "storeMenuOverlay"
            );

        const closeButton =
            document.getElementById(
                "storeDrawerClose"
            );


        function openDrawer() {

            if (!drawer || !overlay) {
                return;
            }


            drawer.classList.add(
                "open"
            );

            overlay.classList.add(
                "open"
            );

            document.body.classList.add(
                "store-menu-open"
            );


            drawer.setAttribute(
                "aria-hidden",
                "false"
            );


            if (menuButton) {

                menuButton.setAttribute(
                    "aria-expanded",
                    "true"
                );

            }

        }


        function closeDrawer() {

            if (!drawer || !overlay) {
                return;
            }


            drawer.classList.remove(
                "open"
            );

            overlay.classList.remove(
                "open"
            );

            document.body.classList.remove(
                "store-menu-open"
            );


            drawer.setAttribute(
                "aria-hidden",
                "true"
            );


            if (menuButton) {

                menuButton.setAttribute(
                    "aria-expanded",
                    "false"
                );

            }

        }


        if (menuButton) {

            menuButton.addEventListener(
                "click",
                openDrawer
            );

        }


        if (closeButton) {

            closeButton.addEventListener(
                "click",
                closeDrawer
            );

        }


        if (overlay) {

            overlay.addEventListener(
                "click",
                closeDrawer
            );

        }


        document.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Escape") {
                    closeDrawer();
                }

            }
        );


        if (drawer) {

            drawer
                .querySelectorAll("a")
                .forEach(
                    function (link) {

                        link.addEventListener(
                            "click",
                            closeDrawer
                        );

                    }
                );

        }


        /* =====================================================
           DROPDOWNS DE NAVEGACIÓN EN PANTALLAS TÁCTILES
        ====================================================== */

        const navItems =
            document.querySelectorAll(
                ".store-nav-item"
            );


        navItems.forEach(
            function (item) {

                const dropdown =
                    item.querySelector(
                        ".store-dropdown"
                    );

                const link =
                    item.querySelector(
                        ".store-nav-link"
                    );


                if (!dropdown || !link) {
                    return;
                }


                link.addEventListener(
                    "click",
                    function (event) {

                        if (
                            window
                                .matchMedia(
                                    "(hover: none)"
                                )
                                .matches
                        ) {

                            if (
                                !item.classList.contains(
                                    "dropdown-open"
                                )
                            ) {

                                event.preventDefault();


                                navItems.forEach(
                                    function (otherItem) {

                                        otherItem.classList.remove(
                                            "dropdown-open"
                                        );

                                    }
                                );


                                item.classList.add(
                                    "dropdown-open"
                                );

                            }

                        }

                    }
                );

            }
        );


        /* =====================================================
           PROMOCIONES
        ====================================================== */

        const promoSlides =
            Array.from(
                document.querySelectorAll(
                    ".store-promo-slide"
                )
            );


        const promoPrevious =
            document.getElementById(
                "promoPrevious"
            );

        const promoNext =
            document.getElementById(
                "promoNext"
            );


        let currentPromo =
            0;

        let promoTimer =
            null;


        function showPromo(index) {

            if (promoSlides.length === 0) {
                return;
            }


            if (index < 0) {

                index =
                    promoSlides.length - 1;

            }


            if (
                index >=
                promoSlides.length
            ) {

                index =
                    0;

            }


            promoSlides.forEach(
                function (slide) {

                    slide.classList.remove(
                        "active"
                    );

                }
            );


            promoSlides[index]
                .classList
                .add(
                    "active"
                );


            currentPromo =
                index;

        }


        function nextPromo() {

            showPromo(
                currentPromo + 1
            );

        }


        function previousPromo() {

            showPromo(
                currentPromo - 1
            );

        }


        function stopPromoTimer() {

            if (promoTimer) {

                window.clearInterval(
                    promoTimer
                );

                promoTimer =
                    null;

            }

        }


        function startPromoTimer() {

            if (
                window
                    .matchMedia(
                        "(prefers-reduced-motion: reduce)"
                    )
                    .matches
            ) {

                return;

            }


            stopPromoTimer();


            promoTimer =
                window.setInterval(
                    nextPromo,
                    5000
                );

        }


        if (promoPrevious) {

            promoPrevious.addEventListener(
                "click",
                function () {

                    previousPromo();

                    startPromoTimer();

                }
            );

        }


        if (promoNext) {

            promoNext.addEventListener(
                "click",
                function () {

                    nextPromo();

                    startPromoTimer();

                }
            );

        }


        const promoContainer =
            document.querySelector(
                ".store-promo"
            );


        if (promoContainer) {

            promoContainer.addEventListener(
                "mouseenter",
                stopPromoTimer
            );


            promoContainer.addEventListener(
                "mouseleave",
                startPromoTimer
            );

        }


        showPromo(0);

        startPromoTimer();

    })();

</script>