<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - BigGame
    </title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/EcommerceApp.styles.css"
          asp-append-version="true" />

    <style>

        * {
            box-sizing: border-box;
        }

        html,
        body {
            width: 100%;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;

            display: flex;
            flex-direction: column;

            background: #ffffff;

            color: #111111;

            font-family:
                Arial,
                Helvetica,
                sans-serif;
        }

        a {
            text-decoration: none;
        }


        /* =====================================================
           CONTENIDO PRINCIPAL
        ====================================================== */

        .biggame-page {
            width: 100%;

            flex: 1 0 auto;

            min-height: 500px;

            background: #ffffff;
        }


        /* =====================================================
           FOOTER
        ====================================================== */

        .biggame-footer {
            width: 100%;

            margin-top: 0;

            padding:
                55px
                24px
                28px;

            background: #111111;

            color: #d0d0d0;
        }

        .biggame-footer-inner {
            width: 100%;
            max-width: 1460px;

            margin: 0 auto;

            display: grid;

            grid-template-columns:
                1.4fr
                1fr
                1fr
                1fr;

            gap: 50px;
        }


        /* =====================================================
           MARCA FOOTER
        ====================================================== */

        .biggame-footer-brand {
            max-width: 340px;
        }

        .biggame-footer-logo {
            display: flex;
            align-items: center;

            gap: 8px;

            margin-bottom: 16px;

            color: #ffffff;

            font-size: 29px;
            font-weight: 900;

            letter-spacing: -1px;
        }

        .biggame-footer-logo-game {
            color: #168bd2;
        }

        .biggame-footer-description {
            margin: 0;

            color: #a7a7a7;

            font-size: 13px;
            line-height: 1.7;
        }


        /* =====================================================
           COLUMNAS FOOTER
        ====================================================== */

        .biggame-footer-column h3 {
            margin:
                0
                0
                17px;

            color: #ffffff;

            font-size: 13px;
            font-weight: 900;

            letter-spacing: 0.3px;

            text-transform: uppercase;
        }

        .biggame-footer-link {
            display: block;

            width: fit-content;

            margin-bottom: 11px;

            color: #b7b7b7;

            font-size: 12px;
            line-height: 1.4;

            transition:
                color 0.18s ease;
        }

        .biggame-footer-link:hover {
            color: #ffffff;
        }


        /* =====================================================
           FOOTER INFERIOR
        ====================================================== */

        .biggame-footer-bottom {
            width: 100%;
            max-width: 1460px;

            margin:
                45px
                auto
                0;

            padding-top: 24px;

            border-top:
                1px solid #333333;

            display: flex;
            align-items: center;
            justify-content: space-between;

            gap: 20px;

            color: #818181;

            font-size: 11px;
        }

        .biggame-footer-bottom-links {
            display: flex;
            align-items: center;

            gap: 18px;

            flex-wrap: wrap;
        }

        .biggame-footer-bottom-links a {
            color: #999999;

            transition:
                color 0.18s ease;
        }

        .biggame-footer-bottom-links a:hover {
            color: #ffffff;
        }


        /* =====================================================
           RESPONSIVE FOOTER
        ====================================================== */

        @@media (max-width: 950px) {

            .biggame-footer-inner {
                grid-template-columns:
                    repeat(2, 1fr);

                gap: 40px;
            }
        }


        @@media (max-width: 580px) {

            .biggame-footer {
                padding:
                    42px
                    20px
                    25px;
            }

            .biggame-footer-inner {
                grid-template-columns: 1fr;

                gap: 32px;
            }

            .biggame-footer-bottom {
                flex-direction: column;

                align-items: flex-start;
            }

            .biggame-footer-logo {
                font-size: 25px;
            }
        }

    </style>

    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="icon" href="/icons/biggame-icon.svg" />

</head>


<body>


    <!-- =====================================================
         HEADER NUEVO
    ====================================================== -->

    <partial name="_StoreHeader" />


    <!-- =====================================================
         CONTENIDO DE CADA PÁGINA
    ====================================================== -->

    <main class="biggame-page"
          role="main">

        @RenderBody()

    </main>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="biggame-footer">

        <div class="biggame-footer-inner">


            <!-- BIGGAME -->

            <div class="biggame-footer-brand">

                <div class="biggame-footer-logo">

                    <span>
                        BIG
                    </span>

                    <span class="biggame-footer-logo-game">
                        GAME
                    </span>

                </div>

                <p class="biggame-footer-description">

                    Tu tienda de videojuegos, consolas,
                    accesorios, coleccionables y productos
                    gaming.

                </p>

            </div>


            <!-- COMPRAR -->

            <div class="biggame-footer-column">

                <h3>
                    Comprar
                </h3>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="biggame-footer-link">

                    Todos los productos

                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-search="PlayStation"
                   class="biggame-footer-link">

                    PlayStation

                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-search="Nintendo"
                   class="biggame-footer-link">

                    Nintendo

                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-search="Xbox"
                   class="biggame-footer-link">

                    Xbox

                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-search="Pokémon"
                   class="biggame-footer-link">

                    Pokémon

                </a>

            </div>


            <!-- AYUDA -->

            <div class="biggame-footer-column">

                <h3>
                    Ayuda
                </h3>

                <a asp-controller="Account"
                   asp-action="LoginHelp"
                   class="biggame-footer-link">

                    Centro de ayuda

                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Orders"
                       asp-action="MyOrders"
                       class="biggame-footer-link">

                        Estado de mis pedidos

                    </a>

                    <a asp-controller="Cart"
                       asp-action="Index"
                       class="biggame-footer-link">

                        Mi carrito

                    </a>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       asp-route-returnUrl="/Orders/MyOrders"
                       class="biggame-footer-link">

                        Estado de mis pedidos

                    </a>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="biggame-footer-link">

                        Iniciar sesión

                    </a>
                }

            </div>


            <!-- CUENTA -->

            <div class="biggame-footer-column">

                <h3>
                    Mi BigGame
                </h3>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin"
                           asp-action="Index"
                           class="biggame-footer-link">

                            Panel de administración

                        </a>

                        <a asp-controller="Orders"
                           asp-action="Index"
                           class="biggame-footer-link">

                            Ventas y pedidos

                        </a>
                    }
                    else
                    {
                        <a asp-controller="Orders"
                           asp-action="MyOrders"
                           class="biggame-footer-link">

                            Mis pedidos

                        </a>

                        <a asp-controller="Cart"
                           asp-action="Index"
                           class="biggame-footer-link">

                            Mi carrito

                        </a>
                    }

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                style="
                                    border: none;
                                    padding: 0;
                                    background: transparent;
                                "
                                class="biggame-footer-link">

                            Cerrar sesión

                        </button>

                    </form>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login"
                       class="biggame-footer-link">

                        Iniciar sesión

                    </a>

                    <a asp-controller="Account"
                       asp-action="Register"
                       class="biggame-footer-link">

                        Crear cuenta

                    </a>
                }

            </div>

        </div>


        <!-- =================================================
             PARTE INFERIOR
        ================================================== -->

        <div class="biggame-footer-bottom">

            <span>
                © 2026 BigGame
            </span>

            <div class="biggame-footer-bottom-links">

                <a asp-controller="Products"
                   asp-action="Index">

                    Tienda

                </a>

                <a asp-controller="Account"
                   asp-action="LoginHelp">

                    Ayuda

                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-route-search="oferta">

                    Ofertas

                </a>

            </div>

        </div>

    </footer>


    <!-- =====================================================
         SCRIPTS
    ====================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )


    <script src="/js/pwa.js"></script>

    <script src="/js/voice-assistant.js"></script>

</body>

</html>