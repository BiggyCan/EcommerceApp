@model EcommerceApp.Models.LoginViewModel

@{
    Layout = null;
    var returnUrl = ViewBag.ReturnUrl as string;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Iniciar sesión | BigGame</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            color: #ffffff;

            background:
                linear-gradient(
                    rgba(5, 10, 20, 0.76),
                    rgba(5, 10, 20, 0.92)
                ),
                url('/images/login-bg.png');

            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        a {
            -webkit-tap-highlight-color: transparent;
        }

        button,
        input {
            font-family: inherit;
        }

        /* =========================================================
           HEADER
        ========================================================= */

        .header {
            width: 100%;
            background: rgba(14, 18, 27, 0.97);
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.38);
            position: relative;
            z-index: 20;
        }

        .header-main {
            width: 100%;
            max-width: 1280px;
            margin: 0 auto;
            padding: 18px 28px;

            display: flex;
            align-items: center;
            gap: 30px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 11px;

            min-width: 205px;

            color: #ffffff;
            text-decoration: none;
        }

        .logo-icon {
            width: 46px;
            height: 46px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background:
                linear-gradient(
                    135deg,
                    #1a9fff,
                    #0066aa
                );

            box-shadow:
                0 0 22px rgba(26, 159, 255, 0.40);

            font-size: 24px;
        }

        .logo-text {
            font-size: 29px;
            font-weight: 900;
            letter-spacing: 1px;
        }

        .logo-text span {
            color: #1a9fff;
        }

        /* =========================================================
           BUSCADOR
        ========================================================= */

        .search-container {
            flex: 1;

            display: flex;
            align-items: stretch;

            max-width: 760px;
            margin-left: auto;
        }

        .search-input {
            width: 100%;
            min-width: 0;
            height: 46px;

            border: 1px solid #3e5573;
            border-right: none;

            border-radius: 4px 0 0 4px;

            background: #263b55;
            color: #ffffff;

            padding: 0 16px;

            outline: none;

            font-size: 15px;

            transition:
                border-color 0.2s ease,
                background 0.2s ease;
        }

        .search-input::placeholder {
            color: #aebccc;
        }

        .search-input:focus {
            border-color: #1a9fff;
            background: #2b4563;
        }

        .search-button {
            width: 55px;
            height: 46px;

            border: none;

            border-radius: 0 4px 4px 0;

            background: #1a9fff;
            color: #ffffff;

            cursor: pointer;

            font-size: 20px;

            transition:
                background 0.2s ease,
                transform 0.2s ease;
        }

        .search-button:hover {
            background: #32afff;
        }

        .search-button:active {
            transform: scale(0.96);
        }

        /* =========================================================
           NAVEGACIÓN
        ========================================================= */

        .navigation {
            width: 100%;

            background:
                linear-gradient(
                    90deg,
                    rgba(22, 70, 119, 0.98),
                    rgba(30, 56, 96, 0.98),
                    rgba(24, 47, 80, 0.98)
                );

            border-top: 1px solid rgba(255, 255, 255, 0.04);
        }

        .navigation-content {
            width: 100%;
            max-width: 1280px;
            margin: 0 auto;

            padding: 0 28px;

            display: flex;
            align-items: center;
        }

        .navigation a {
            position: relative;

            padding: 16px 25px;

            color: #dce7f2;
            text-decoration: none;

            font-size: 15px;
            font-weight: 700;

            transition:
                background 0.2s ease,
                color 0.2s ease;
        }

        .navigation a::after {
            content: "";

            position: absolute;

            left: 50%;
            right: 50%;
            bottom: 0;

            height: 3px;

            background: #1a9fff;

            transition:
                left 0.2s ease,
                right 0.2s ease;
        }

        .navigation a:hover {
            background: rgba(255, 255, 255, 0.07);
            color: #ffffff;
        }

        .navigation a:hover::after {
            left: 20px;
            right: 20px;
        }

        /* =========================================================
           CONTENIDO
        ========================================================= */

        .main {
            width: 100%;
            max-width: 900px;

            margin: 0 auto;

            padding: 70px 25px 65px;
        }

        .title-area {
            text-align: center;
            margin-bottom: 42px;
        }

        .title {
            margin-bottom: 12px;

            font-size: 40px;
            line-height: 1.1;

            font-weight: 800;

            text-shadow:
                0 3px 18px rgba(0, 0, 0, 0.85);
        }

        .subtitle {
            color: #bdcbd9;

            font-size: 15px;
            line-height: 1.6;

            text-shadow:
                0 2px 10px rgba(0, 0, 0, 0.8);
        }

        /* =========================================================
           PANEL LOGIN
        ========================================================= */

        .login-panel {
            width: 100%;
            max-width: 540px;

            margin: 0 auto;

            padding: 36px;

            border: 1px solid rgba(255, 255, 255, 0.07);
            border-radius: 8px;

            background: rgba(12, 20, 33, 0.90);

            backdrop-filter: blur(8px);

            box-shadow:
                0 18px 55px rgba(0, 0, 0, 0.52),
                0 0 0 1px rgba(26, 159, 255, 0.03);
        }

        .panel-title {
            margin-bottom: 28px;

            color: #ffffff;

            font-size: 19px;
            font-weight: 700;
        }

        /* =========================================================
           VALIDACIONES GENERALES
        ========================================================= */

        .validation-summary {
            margin-bottom: 22px;
        }

        .validation-summary-valid {
            display: none;
        }

        .validation-summary-errors {
            display: block;

            padding: 14px 16px;

            border: 1px solid rgba(255, 86, 86, 0.55);
            border-radius: 5px;

            background: rgba(136, 21, 21, 0.25);

            color: #ffb0b0;

            font-size: 14px;
            line-height: 1.5;
        }

        .validation-summary-errors ul {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .validation-summary-errors li {
            margin: 0;
        }

        /* =========================================================
           FORMULARIO
        ========================================================= */

        .form-group {
            margin-bottom: 23px;
        }

        .form-label {
            display: block;

            margin-bottom: 9px;

            color: #37adff;

            font-size: 12px;
            font-weight: 800;

            letter-spacing: 0.8px;
            text-transform: uppercase;
        }

        .password-label {
            color: #dce4ec;
        }

        .form-control {
            width: 100%;
            height: 55px;

            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 4px;

            background: rgba(50, 69, 95, 0.96);

            color: #ffffff;

            padding: 0 16px;

            outline: none;

            font-size: 16px;

            transition:
                background 0.2s ease,
                border-color 0.2s ease,
                box-shadow 0.2s ease;
        }

        .form-control::placeholder {
            color: #9eb0c2;
        }

        .form-control:hover {
            background: rgba(56, 77, 105, 0.98);
        }

        .form-control:focus {
            background: rgba(59, 81, 111, 1);

            border-color: #1a9fff;

            box-shadow:
                0 0 0 3px rgba(26, 159, 255, 0.13);
        }

        .input-validation-error {
            border-color: #ff6464 !important;

            box-shadow:
                0 0 0 3px rgba(255, 74, 74, 0.10) !important;
        }

        .validation {
            display: block;

            min-height: 17px;

            margin-top: 6px;

            color: #ff8585;

            font-size: 12px;
            line-height: 1.4;
        }

        /* =========================================================
           CONTRASEÑA
        ========================================================= */

        .password-wrapper {
            position: relative;
        }

        .password-wrapper .form-control {
            padding-right: 100px;
        }

        .password-toggle {
            position: absolute;

            top: 50%;
            right: 10px;

            transform: translateY(-50%);

            min-width: 78px;
            height: 36px;

            border: none;
            border-radius: 4px;

            background: rgba(18, 32, 50, 0.82);
            color: #c7d8e8;

            cursor: pointer;

            font-size: 11px;
            font-weight: 800;

            letter-spacing: 0.4px;

            transition:
                background 0.2s ease,
                color 0.2s ease;
        }

        .password-toggle:hover {
            background: #1a9fff;
            color: #ffffff;
        }

        /* =========================================================
           RECORDAR
        ========================================================= */

        .remember-row {
            margin: 1px 0 25px;

            display: flex;
            align-items: center;
            gap: 10px;

            color: #d6e0e9;

            font-size: 14px;

            cursor: pointer;
            user-select: none;
        }

        .remember-row input {
            width: 19px;
            height: 19px;

            cursor: pointer;

            accent-color: #1a9fff;
        }

        /* =========================================================
           BOTÓN LOGIN
        ========================================================= */

        .login-button {
            width: 100%;
            min-height: 58px;

            border: none;
            border-radius: 4px;

            background:
                linear-gradient(
                    90deg,
                    #06bfff,
                    #1a9fff
                );

            color: #ffffff;

            cursor: pointer;

            font-size: 18px;
            font-weight: 700;

            box-shadow:
                0 8px 24px rgba(26, 159, 255, 0.20);

            transition:
                filter 0.2s ease,
                transform 0.15s ease,
                box-shadow 0.2s ease;
        }

        .login-button:hover {
            filter: brightness(1.10);

            box-shadow:
                0 10px 30px rgba(26, 159, 255, 0.32);
        }

        .login-button:active {
            transform: translateY(1px);
        }

        .login-button:disabled {
            cursor: wait;
            opacity: 0.75;
        }

        /* =========================================================
           AYUDA
        ========================================================= */

        .help-area {
            margin-top: 30px;

            padding-top: 24px;

            border-top: 1px solid rgba(255, 255, 255, 0.08);

            text-align: center;
        }

        .help-link {
            display: inline-block;

            color: #c9d8e5;

            text-decoration: none;

            font-size: 14px;

            transition: color 0.2s ease;
        }

        .help-link:hover {
            color: #1a9fff;
            text-decoration: underline;
        }

        /* =========================================================
           REGISTRO
        ========================================================= */

        .register-section {
            width: 100%;
            max-width: 540px;

            margin: 34px auto 0;

            padding: 32px 30px;

            text-align: center;

            border: 1px solid rgba(255, 255, 255, 0.07);
            border-radius: 8px;

            background: rgba(12, 20, 33, 0.86);

            backdrop-filter: blur(8px);

            box-shadow:
                0 15px 42px rgba(0, 0, 0, 0.36);
        }

        .register-section h2 {
            margin-bottom: 10px;

            font-size: 24px;
        }

        .register-section .register-intro {
            margin: 0 auto 25px;

            color: #bdcbd9;

            font-size: 14px;
            line-height: 1.6;
        }

        .register-button {
            display: inline-flex;

            width: 100%;
            min-height: 54px;

            align-items: center;
            justify-content: center;

            padding: 13px 25px;

            border: 1px solid #1a9fff;
            border-radius: 4px;

            background: rgba(26, 159, 255, 0.08);

            color: #ffffff;

            text-decoration: none;

            font-size: 16px;
            font-weight: 700;

            transition:
                background 0.2s ease,
                box-shadow 0.2s ease;
        }

        .register-button:hover {
            background: #1a9fff;

            box-shadow:
                0 8px 25px rgba(26, 159, 255, 0.25);
        }

        /* =========================================================
           BENEFICIOS
        ========================================================= */

        .benefits {
            width: 100%;
            max-width: 780px;

            margin: 38px auto 0;

            display: grid;
            grid-template-columns: repeat(3, 1fr);

            gap: 12px;
        }

        .benefit {
            padding: 18px 14px;

            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 6px;

            background: rgba(10, 17, 29, 0.69);

            text-align: center;
        }

        .benefit-icon {
            margin-bottom: 7px;

            font-size: 22px;
        }

        .benefit strong {
            display: block;

            margin-bottom: 5px;

            font-size: 13px;
        }

        .benefit span {
            color: #aebdcc;

            font-size: 12px;
            line-height: 1.4;
        }

        /* =========================================================
           FOOTER
        ========================================================= */

        .footer {
            margin-top: 20px;

            padding: 35px 20px;

            background: rgba(13, 17, 25, 0.97);

            border-top: 1px solid rgba(255, 255, 255, 0.05);

            text-align: center;

            color: #8094a6;

            font-size: 13px;
            line-height: 1.6;
        }

        .footer strong {
            color: #ffffff;
            letter-spacing: 0.8px;
        }

        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @@media (max-width: 820px) {

            .header-main {
                padding: 15px 18px;
                gap: 16px;
            }

            .logo {
                min-width: auto;
            }

            .logo-text {
                font-size: 23px;
            }

            .logo-icon {
                width: 40px;
                height: 40px;

                font-size: 20px;
            }

            .navigation-content {
                padding: 0 10px;
                justify-content: center;
            }

            .navigation a {
                padding: 14px 15px;
                font-size: 13px;
            }

            .main {
                padding-top: 55px;
            }

            .benefits {
                grid-template-columns: 1fr;
                max-width: 540px;
            }
        }

        @@media (max-width: 650px) {

            body {
                background-attachment: scroll;
            }

            .header-main {
                flex-direction: column;
                align-items: stretch;
            }

            .logo {
                justify-content: center;
            }

            .search-container {
                width: 100%;
                max-width: none;
            }

            .navigation-content {
                overflow-x: auto;
                justify-content: flex-start;

                scrollbar-width: none;
            }

            .navigation-content::-webkit-scrollbar {
                display: none;
            }

            .navigation a {
                flex: 0 0 auto;
                white-space: nowrap;
            }

            .main {
                padding:
                    45px
                    15px
                    45px;
            }

            .title {
                font-size: 32px;
            }

            .subtitle {
                font-size: 14px;
            }

            .login-panel,
            .register-section {
                max-width: 100%;
            }

            .login-panel {
                padding: 28px 20px;
            }

            .register-section {
                padding: 28px 20px;
            }
        }

        @@media (max-width: 420px) {

            .logo-text {
                font-size: 21px;
            }

            .title {
                font-size: 29px;
            }

            .main {
                padding-left: 12px;
                padding-right: 12px;
            }

            .login-panel,
            .register-section {
                padding-left: 17px;
                padding-right: 17px;
            }

            .password-toggle {
                min-width: 72px;
                font-size: 10px;
            }

            .password-wrapper .form-control {
                padding-right: 90px;
            }
        }
    </style>
</head>

<body>

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <header class="header">

        <div class="header-main">

            <a asp-controller="Products"
               asp-action="Index"
               class="logo"
               aria-label="Ir a BigGame">

                <div class="logo-icon">
                    🎮
                </div>

                <div class="logo-text">
                    BIG<span>GAME</span>
                </div>

            </a>

            <form asp-controller="Products"
                  asp-action="Index"
                  method="get"
                  class="search-container">

                <input type="search"
                       name="q"
                       class="search-input"
                       placeholder="Buscar videojuegos, consolas, accesorios..."
                       aria-label="Buscar en BigGame" />

                <button type="submit"
                        class="search-button"
                        aria-label="Buscar">
                    🔍
                </button>

            </form>

        </div>

        <nav class="navigation">

            <div class="navigation-content">

                <a asp-controller="Products"
                   asp-action="Index">
                    Explorar
                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-fragment="productos-destacados">
                    Recomendaciones
                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-fragment="categorias">
                    Categorías
                </a>

            </div>

        </nav>

    </header>

    <!-- =========================================================
         CONTENIDO
    ========================================================== -->

    <main class="main">

        <div class="title-area">

            <h1 class="title">
                Iniciar sesión
            </h1>

            <p class="subtitle">
                Accede a tu cuenta para comprar, revisar tus pedidos
                y continuar explorando BigGame.
            </p>

        </div>

        <!-- =====================================================
             LOGIN
        ====================================================== -->

        <div class="login-panel">

            <div class="panel-title">
                Accede a tu cuenta
            </div>

            <form asp-controller="Account"
                  asp-action="Login"
                  asp-route-returnUrl="@returnUrl"
                  method="post"
                  id="loginForm">

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>

                <!-- CORREO -->

                <div class="form-group">

                    <label asp-for="Email"
                           class="form-label">
                        Correo electrónico
                    </label>

                    <input asp-for="Email"
                           class="form-control"
                           type="email"
                           autocomplete="email"
                           inputmode="email"
                           placeholder="ejemplo@correo.com"
                           autofocus />

                    <span asp-validation-for="Email"
                          class="validation">
                    </span>

                </div>

                <!-- CONTRASEÑA -->

                <div class="form-group">

                    <label asp-for="Password"
                           class="form-label password-label">
                        Contraseña
                    </label>

                    <div class="password-wrapper">

                        <input asp-for="Password"
                               class="form-control"
                               type="password"
                               autocomplete="current-password"
                               placeholder="Ingresa tu contraseña"
                               id="Password" />

                        <button type="button"
                                class="password-toggle"
                                id="togglePassword"
                                aria-label="Mostrar contraseña"
                                aria-pressed="false">
                            MOSTRAR
                        </button>

                    </div>

                    <span asp-validation-for="Password"
                          class="validation">
                    </span>

                </div>

                <!-- RECORDAR -->

                <label class="remember-row">

                    <input asp-for="RememberMe" />

                    <span>
                        Recordarme en este dispositivo
                    </span>

                </label>

                <!-- BOTÓN -->

                <button type="submit"
                        class="login-button"
                        id="loginButton">

                    <span id="loginButtonText">
                        Iniciar sesión
                    </span>

                </button>

            </form>

            <!-- AYUDA -->

            <div class="help-area">

                <a asp-controller="Account"
                   asp-action="LoginHelp"
                   class="help-link">

                    ¿Necesitas ayuda para iniciar sesión?

                </a>

            </div>

        </div>

        <!-- =====================================================
             REGISTRO
        ====================================================== -->

        <section class="register-section">

            <h2>
                ¿Tu primera vez en BigGame?
            </h2>

            <p class="register-intro">
                Crea tu cuenta para comprar videojuegos, consolas,
                accesorios y revisar el historial de tus pedidos.
            </p>

            <a asp-controller="Account"
               asp-action="Register"
               class="register-button">

                Crear una cuenta gratis

            </a>

        </section>

        <!-- =====================================================
             BENEFICIOS
        ====================================================== -->

        <div class="benefits">

            <div class="benefit">

                <div class="benefit-icon">
                    🎮
                </div>

                <strong>
                    Catálogo gaming
                </strong>

                <span>
                    Juegos, consolas, accesorios y coleccionables.
                </span>

            </div>

            <div class="benefit">

                <div class="benefit-icon">
                    🛒
                </div>

                <strong>
                    Compra sencilla
                </strong>

                <span>
                    Agrega productos y administra tu carrito.
                </span>

            </div>

            <div class="benefit">

                <div class="benefit-icon">
                    📦
                </div>

                <strong>
                    Tus pedidos
                </strong>

                <span>
                    Consulta el historial de tus compras.
                </span>

            </div>

        </div>

    </main>

    <!-- =========================================================
         FOOTER
    ========================================================== -->

    <footer class="footer">

        <strong>BIGGAME</strong>

        <br />

        Tienda de videojuegos, consolas, accesorios y coleccionables

        <br />

        © 2026 BigGame

    </footer>

    <!-- VALIDACIONES ASP.NET -->

    <partial name="_ValidationScriptsPartial" />

    <!-- =========================================================
         JAVASCRIPT
    ========================================================== -->

    <script>
        (function () {

            const passwordInput =
                document.getElementById("Password");

            const togglePassword =
                document.getElementById("togglePassword");

            const loginForm =
                document.getElementById("loginForm");

            const loginButton =
                document.getElementById("loginButton");

            const loginButtonText =
                document.getElementById("loginButtonText");


            // ==========================================
            // MOSTRAR / OCULTAR CONTRASEÑA
            // ==========================================

            if (passwordInput && togglePassword) {

                togglePassword.addEventListener(
                    "click",
                    function () {

                        const isHidden =
                            passwordInput.type === "password";

                        passwordInput.type =
                            isHidden
                                ? "text"
                                : "password";

                        togglePassword.textContent =
                            isHidden
                                ? "OCULTAR"
                                : "MOSTRAR";

                        togglePassword.setAttribute(
                            "aria-pressed",
                            isHidden
                                ? "true"
                                : "false"
                        );

                        togglePassword.setAttribute(
                            "aria-label",
                            isHidden
                                ? "Ocultar contraseña"
                                : "Mostrar contraseña"
                        );

                        passwordInput.focus();
                    }
                );
            }


            // ==========================================
            // ESTADO DEL BOTÓN AL ENVIAR
            // ==========================================

            if (
                loginForm &&
                loginButton &&
                loginButtonText
            ) {

                loginForm.addEventListener(
                    "submit",
                    function () {

                        if (!loginForm.checkValidity()) {
                            return;
                        }

                        loginButton.disabled = true;

                        loginButtonText.textContent =
                            "Iniciando sesión...";
                    }
                );
            }

        })();
    </script>

</body>
</html>