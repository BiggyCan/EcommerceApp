@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Ayuda para iniciar sesión | BigGame</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;

            font-family: Arial, Helvetica, sans-serif;

            color: #ffffff;

            background:
                linear-gradient(
                    rgba(5, 10, 20, 0.78),
                    rgba(5, 10, 20, 0.94)
                ),
                url('/images/login-bg.png');

            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
        }

        a {
            -webkit-tap-highlight-color: transparent;
        }

        /* =========================================================
           HEADER
        ========================================================= */

        .header {
            width: 100%;

            background: rgba(14, 18, 27, 0.97);

            border-bottom:
                1px solid rgba(255, 255, 255, 0.06);

            box-shadow:
                0 4px 18px rgba(0, 0, 0, 0.38);
        }

        .header-main {
            width: 100%;
            max-width: 1280px;

            margin: 0 auto;

            padding: 18px 28px;

            display: flex;
            align-items: center;
            gap: 30px;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 11px;

            min-width: 205px;

            color: #ffffff;

            text-decoration: none;
        }

        .logo-icon {
            width: 46px;
            height: 46px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background:
                linear-gradient(
                    135deg,
                    #1a9fff,
                    #0066aa
                );

            box-shadow:
                0 0 22px rgba(26, 159, 255, 0.40);

            font-size: 24px;
        }

        .logo-text {
            font-size: 29px;

            font-weight: 900;

            letter-spacing: 1px;
        }

        .logo-text span {
            color: #1a9fff;
        }

        /* =========================================================
           BUSCADOR
        ========================================================= */

        .search-container {
            flex: 1;

            display: flex;
            align-items: stretch;

            max-width: 760px;

            margin-left: auto;
        }

        .search-input {
            width: 100%;
            min-width: 0;
            height: 46px;

            border:
                1px solid #3e5573;

            border-right: none;

            border-radius:
                4px 0 0 4px;

            background: #263b55;

            color: #ffffff;

            padding:
                0 16px;

            outline: none;

            font-size: 15px;
        }

        .search-input::placeholder {
            color: #aebccc;
        }

        .search-input:focus {
            border-color: #1a9fff;

            background: #2b4563;
        }

        .search-button {
            width: 55px;
            height: 46px;

            border: none;

            border-radius:
                0 4px 4px 0;

            background: #1a9fff;

            color: #ffffff;

            cursor: pointer;

            font-size: 20px;
        }

        .search-button:hover {
            background: #32afff;
        }

        /* =========================================================
           NAVEGACIÓN
        ========================================================= */

        .navigation {
            width: 100%;

            background:
                linear-gradient(
                    90deg,
                    rgba(22, 70, 119, 0.98),
                    rgba(30, 56, 96, 0.98),
                    rgba(24, 47, 80, 0.98)
                );
        }

        .navigation-content {
            width: 100%;
            max-width: 1280px;

            margin: 0 auto;

            padding:
                0 28px;

            display: flex;
            align-items: center;
        }

        .navigation a {
            padding:
                16px 25px;

            color: #dce7f2;

            text-decoration: none;

            font-size: 15px;
            font-weight: 700;
        }

        .navigation a:hover {
            background:
                rgba(255, 255, 255, 0.07);

            color: #ffffff;
        }

        /* =========================================================
           CONTENIDO PRINCIPAL
        ========================================================= */

        .main {
            width: 100%;

            max-width: 1000px;

            margin: 0 auto;

            padding:
                65px 25px 80px;
        }

        .title-area {
            text-align: center;

            margin-bottom: 38px;
        }

        .title-icon {
            width: 72px;
            height: 72px;

            margin:
                0 auto 20px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background:
                rgba(26, 159, 255, 0.14);

            border:
                1px solid rgba(26, 159, 255, 0.45);

            font-size: 34px;

            box-shadow:
                0 0 30px rgba(26, 159, 255, 0.15);
        }

        .title {
            margin-bottom: 12px;

            font-size: 38px;

            font-weight: 800;

            text-shadow:
                0 3px 18px rgba(0, 0, 0, 0.85);
        }

        .subtitle {
            max-width: 620px;

            margin:
                0 auto;

            color: #bdcbd9;

            font-size: 15px;

            line-height: 1.7;
        }

        /* =========================================================
           PANEL
        ========================================================= */

        .help-panel {
            width: 100%;

            padding: 35px;

            border:
                1px solid rgba(255, 255, 255, 0.07);

            border-radius: 9px;

            background:
                rgba(12, 20, 33, 0.91);

            backdrop-filter:
                blur(8px);

            box-shadow:
                0 18px 55px rgba(0, 0, 0, 0.52);
        }

        .help-panel-title {
            margin-bottom: 8px;

            font-size: 23px;

            font-weight: 800;
        }

        .help-panel-description {
            margin-bottom: 30px;

            color: #aebdcc;

            font-size: 14px;

            line-height: 1.6;
        }

        /* =========================================================
           OPCIONES DE AYUDA
        ========================================================= */

        .help-grid {
            display: grid;

            grid-template-columns:
                repeat(2, 1fr);

            gap: 16px;
        }

        .help-card {
            padding: 24px;

            border:
                1px solid rgba(255, 255, 255, 0.07);

            border-radius: 7px;

            background:
                rgba(28, 41, 59, 0.72);

            transition:
                transform 0.2s ease,
                border-color 0.2s ease,
                background 0.2s ease;
        }

        .help-card:hover {
            transform:
                translateY(-3px);

            border-color:
                rgba(26, 159, 255, 0.50);

            background:
                rgba(33, 50, 72, 0.90);
        }

        .help-card-icon {
            margin-bottom: 14px;

            font-size: 28px;
        }

        .help-card h2 {
            margin-bottom: 9px;

            color: #ffffff;

            font-size: 17px;
        }

        .help-card p {
            color: #b7c6d4;

            font-size: 13px;

            line-height: 1.6;
        }

        /* =========================================================
           RECOMENDACIONES
        ========================================================= */

        .tips {
            margin-top: 28px;

            padding: 24px;

            border-left:
                4px solid #1a9fff;

            border-radius:
                5px;

            background:
                rgba(26, 159, 255, 0.08);
        }

        .tips h3 {
            margin-bottom: 15px;

            font-size: 16px;
        }

        .tips ul {
            padding-left: 20px;

            color: #c3d0dc;

            font-size: 14px;

            line-height: 1.8;
        }

        /* =========================================================
           BOTONES
        ========================================================= */

        .actions {
            margin-top: 32px;

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 12px;
        }

        .button {
            min-height: 52px;

            display: flex;

            align-items: center;
            justify-content: center;

            padding:
                12px 18px;

            border-radius: 5px;

            text-align: center;

            text-decoration: none;

            font-size: 14px;

            font-weight: 700;

            transition:
                background 0.2s ease,
                border-color 0.2s ease,
                transform 0.15s ease;
        }

        .button:active {
            transform:
                translateY(1px);
        }

        .button-primary {
            border:
                1px solid #1a9fff;

            background: #1a9fff;

            color: #ffffff;
        }

        .button-primary:hover {
            background: #32afff;

            border-color: #32afff;
        }

        .button-secondary {
            border:
                1px solid #586b7e;

            background:
                rgba(255, 255, 255, 0.04);

            color: #ffffff;
        }

        .button-secondary:hover {
            border-color: #1a9fff;

            background:
                rgba(26, 159, 255, 0.10);
        }

        /* =========================================================
           CONTACTO
        ========================================================= */

        .contact-section {
            margin-top: 28px;

            padding: 25px;

            border:
                1px solid rgba(255, 255, 255, 0.07);

            border-radius: 7px;

            background:
                rgba(10, 17, 29, 0.75);

            text-align: center;
        }

        .contact-section h3 {
            margin-bottom: 8px;

            font-size: 17px;
        }

        .contact-section p {
            color: #adbdcb;

            font-size: 13px;

            line-height: 1.6;
        }

        /* =========================================================
           FOOTER
        ========================================================= */

        .footer {
            padding:
                35px 20px;

            background:
                rgba(13, 17, 25, 0.97);

            border-top:
                1px solid rgba(255, 255, 255, 0.05);

            text-align: center;

            color: #8094a6;

            font-size: 13px;

            line-height: 1.6;
        }

        .footer strong {
            color: #ffffff;
        }

        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @@media (max-width: 760px) {

            .header-main {
                flex-direction: column;

                align-items: stretch;

                padding:
                    15px 18px;
            }

            .logo {
                justify-content: center;

                min-width: auto;
            }

            .search-container {
                width: 100%;

                max-width: none;
            }

            .navigation-content {
                justify-content: center;

                padding:
                    0 10px;
            }

            .navigation a {
                padding:
                    14px 15px;

                font-size: 13px;
            }

            .main {
                padding:
                    45px 15px 60px;
            }

            .title {
                font-size: 31px;
            }

            .help-grid {
                grid-template-columns:
                    1fr;
            }

            .actions {
                grid-template-columns:
                    1fr;
            }
        }

        @@media (max-width: 460px) {

            .help-panel {
                padding:
                    25px 18px;
            }

            .title {
                font-size: 28px;
            }

            .navigation-content {
                overflow-x: auto;

                justify-content: flex-start;
            }

            .navigation a {
                flex:
                    0 0 auto;

                white-space: nowrap;
            }
        }
    </style>
</head>

<body>

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <header class="header">

        <div class="header-main">

            <a asp-controller="Products"
               asp-action="Index"
               class="logo">

                <div class="logo-icon">
                    🎮
                </div>

                <div class="logo-text">
                    BIG<span>GAME</span>
                </div>

            </a>

            <form asp-controller="Products"
                  asp-action="Index"
                  method="get"
                  class="search-container">

                <input type="search"
                       name="q"
                       class="search-input"
                       placeholder="Buscar videojuegos, consolas, accesorios..."
                       aria-label="Buscar en BigGame" />

                <button type="submit"
                        class="search-button"
                        aria-label="Buscar">
                    🔍
                </button>

            </form>

        </div>

        <nav class="navigation">

            <div class="navigation-content">

                <a asp-controller="Products"
                   asp-action="Index">
                    Explorar
                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-fragment="productos-destacados">
                    Recomendaciones
                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   asp-fragment="categorias">
                    Categorías
                </a>

            </div>

        </nav>

    </header>

    <!-- =========================================================
         CONTENIDO
    ========================================================== -->

    <main class="main">

        <div class="title-area">

            <div class="title-icon">
                🔐
            </div>

            <h1 class="title">
                ¿Problemas para iniciar sesión?
            </h1>

            <p class="subtitle">
                Revisa estas opciones antes de intentarlo nuevamente.
                La mayoría de los problemas de acceso pueden solucionarse
                en pocos pasos.
            </p>

        </div>

        <section class="help-panel">

            <h2 class="help-panel-title">
                Ayuda de acceso a BigGame
            </h2>

            <p class="help-panel-description">
                Busca a continuación el problema que más se parezca
                a lo que está ocurriendo con tu cuenta.
            </p>

            <div class="help-grid">

                <!-- CORREO -->

                <article class="help-card">

                    <div class="help-card-icon">
                        📧
                    </div>

                    <h2>
                        No recuerdo mi correo
                    </h2>

                    <p>
                        Comprueba qué correo utilizaste al registrarte.
                        Si tienes varias cuentas de correo, revisa cuál
                        utilizaste originalmente para crear tu cuenta
                        de BigGame.
                    </p>

                </article>

                <!-- CONTRASEÑA -->

                <article class="help-card">

                    <div class="help-card-icon">
                        🔑
                    </div>

                    <h2>
                        Mi contraseña no funciona
                    </h2>

                    <p>
                        Verifica que la contraseña esté escrita
                        correctamente y que no tengas activado
                        accidentalmente Bloq Mayús. También puedes usar
                        el botón Mostrar del inicio de sesión.
                    </p>

                </article>

                <!-- CUENTA -->

                <article class="help-card">

                    <div class="help-card-icon">
                        👤
                    </div>

                    <h2>
                        No tengo una cuenta
                    </h2>

                    <p>
                        Puedes crear una cuenta gratuita en BigGame.
                        Después del registro podrás iniciar sesión,
                        realizar compras y revisar tus pedidos.
                    </p>

                </article>

                <!-- ERROR -->

                <article class="help-card">

                    <div class="help-card-icon">
                        ⚠️
                    </div>

                    <h2>
                        Aparece un error al ingresar
                    </h2>

                    <p>
                        Si aparece el mensaje “Correo o contraseña
                        incorrectos”, revisa ambos datos e intenta
                        nuevamente. BigGame no indica cuál de los dos
                        datos es incorrecto.
                    </p>

                </article>

            </div>

            <!-- =================================================
                 CONSEJOS
            ================================================== -->

            <div class="tips">

                <h3>
                    Antes de volver a intentarlo
                </h3>

                <ul>
                    <li>
                        Comprueba que escribiste correctamente tu correo.
                    </li>

                    <li>
                        Revisa que no existan espacios antes o después
                        del correo.
                    </li>

                    <li>
                        Utiliza “Mostrar” para comprobar tu contraseña.
                    </li>

                    <li>
                        Verifica que Bloq Mayús no esté activado.
                    </li>

                    <li>
                        Si todavía no tienes una cuenta, crea una desde
                        el botón inferior.
                    </li>
                </ul>

            </div>

            <!-- =================================================
                 BOTONES
            ================================================== -->

            <div class="actions">

                <a asp-controller="Account"
                   asp-action="Login"
                   class="button button-primary">

                    Volver a iniciar sesión

                </a>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="button button-secondary">

                    Crear una cuenta

                </a>

                <a asp-controller="Products"
                   asp-action="Index"
                   class="button button-secondary">

                    Volver a la tienda

                </a>

            </div>

            <!-- =================================================
                 CONTACTO
            ================================================== -->

            <div class="contact-section">

                <h3>
                    ¿Todavía tienes problemas?
                </h3>

                <p>
                    Esta sección de ayuda continuará ampliándose
                    junto con las demás funciones de soporte de BigGame.
                </p>

            </div>

        </section>

    </main>

    <!-- =========================================================
         FOOTER
    ========================================================== -->

    <footer class="footer">

        <strong>BIGGAME</strong>

        <br />

        Tienda de videojuegos, consolas, accesorios y coleccionables

        <br />

        © 2026 BigGame

    </footer>

</body>
</html>